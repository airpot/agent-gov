def load_json(path: Path, label: str) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        print(f"error: {label} is invalid JSON: {exc}")
        raise SystemExit(1)


def load_jsonl(path: Path, label: str) -> list[dict]:
    rows: list[dict] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        print(f"error: cannot read {label}: {exc}")
        raise SystemExit(1)
    for index, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            print(f"error: {label} line {index} is invalid JSON: {exc}")
            raise SystemExit(1)
    return rows


def config_path_pointers(config: dict) -> dict[str, str]:
    paths = config.get("paths", {})
    if isinstance(paths, dict) and paths:
        return {str(key): str(value) for key, value in paths.items() if isinstance(value, str)}
    return {
        key: value
        for key, value in config.items()
        if key in LEGACY_CONFIG_PATH_KEYS and isinstance(value, str) and value
    }


def main() -> int:
    root = Path.cwd()

    config_path = root / ".agent/config.json"
    config = {}
    if config_path.exists():
        config = load_json(config_path, ".agent/config.json")
        if config.get("schema") != "agent-project-config-v1":
            print("error: .agent/config.json schema must be agent-project-config-v1")
            return 1
        for key in ("project_name", "remote_workspace_path", "created_at"):
            if not config.get(key):
                print(f"error: .agent/config.json missing required field: {key}")
                return 1
        if config.get("governance_profile") not in {"core", "standard", "full"}:
            print("error: .agent/config.json governance_profile must be core, standard, or full")
            return 1
        for key, path in config_path_pointers(config).items():
            if not (root / path).exists():
                print(f"error: .agent/config.json path pointer is missing: {key} -> {path}")
                return 1

    manifest_path = root / ".agent/manifest.json"
    manifest = {}
    if manifest_path.exists():
        manifest = load_json(manifest_path, ".agent/manifest.json")
        if manifest.get("schema") != "agent-governance-manifest-v1":
            print("error: .agent/manifest.json schema must be agent-governance-manifest-v1")
            return 1
        if not manifest.get("required_paths"):
            print("error: .agent/manifest.json missing required_paths")
            return 1

    openspec_enabled = bool(config.get("openspec_enabled", config.get("spec_source", "openspec") == "openspec"))
    claude_enabled = bool(config.get("claude_enabled", True))
    if manifest.get("required_paths"):
        required = list(manifest["required_paths"])
    else:
        required = list(BASE_REQUIRED)
        if openspec_enabled:
            required.extend(OPENSPEC_REQUIRED)
        if claude_enabled:
            required.extend(CLAUDE_REQUIRED)
    missing = [path for path in required if not (root / path).exists()]

    index_path = root / ".agent/sessions/index.json"
    if index_path.exists():
        load_json(index_path, ".agent/sessions/index.json")

    spec_path = root / ".agent/spec.json"
    if openspec_enabled:
        if spec_path.exists():
            spec_config = load_json(spec_path, ".agent/spec.json")
            if spec_config.get("schema") != "agent-spec-v1":
                print("error: .agent/spec.json schema must be agent-spec-v1")
                return 1
            if spec_config.get("mode") != "embedded":
                print("error: .agent/spec.json mode must be embedded")
                return 1
            paths = spec_config.get("paths", {})
            for key in ("root", "changes", "archive", "specs", "project"):
                if key not in paths:
                    print(f"error: .agent/spec.json missing path: {key}")
                    return 1
        else:
            missing.append(".agent/spec.json")

    harness_path = root / ".agent/harness.json"
    if harness_path.exists():
        harness = load_json(harness_path, ".agent/harness.json")
        if harness.get("schema") != "agent-harness-v1":
            print("error: .agent/harness.json schema must be agent-harness-v1")
            return 1
        if manifest.get("required_paths") and sorted(manifest["required_paths"]) != sorted(harness.get("invariants", {}).get("required_paths", [])):
            print("error: .agent/manifest.json required_paths must match .agent/harness.json invariants.required_paths")
            return 1

    layout_path = root / ".agent/project-layout.json"
    if layout_path.exists():
        layout = load_json(layout_path, ".agent/project-layout.json")
        if layout.get("schema") != "agent-project-layout-v1":
            print("error: .agent/project-layout.json schema must be agent-project-layout-v1")
            return 1
        for directory in layout.get("directories", []):
            if not (root / directory).is_dir():
                missing.append(directory)

    workflow_path = root / ".agent/workflow.json"
    workflow = {}
    workflow_stages: set[str] = set()
    if workflow_path.exists():
        workflow = load_json(workflow_path, ".agent/workflow.json")
        if workflow.get("schema") != "agent-workflow-v1":
            print("error: .agent/workflow.json schema must be agent-workflow-v1")
            return 1
        for key in ("profile_source", "task_board", "role_contracts", "feature_docs"):
            if not workflow.get(key):
                print(f"error: .agent/workflow.json missing pointer: {key}")
                return 1
        workflow_stages = set(workflow.get("stages", []))
        stage_definitions = workflow.get("stage_definitions", {})
        for stage in ("intake", "risk_classification", "implementation", "spec_review", "quality_review", "verification", "handoff"):
            definition = stage_definitions.get(stage, {})
            if not definition:
                print(f"error: .agent/workflow.json missing stage definition: {stage}")
                return 1
            for key in ("owner_role", "required_inputs", "required_outputs", "allowed_next", "rollback_to", "forbidden_actions"):
                if key not in definition:
                    print(f"error: .agent/workflow.json stage {stage} missing {key}")
                    return 1
        for stage in stage_definitions:
            if stage not in workflow_stages:
                print(f"error: .agent/workflow.json stage definition is not listed in stages: {stage}")
                return 1
        gates = workflow.get("gates", {})
        for gate in (
            "risk_classification",
            "design_approval",
            "plan_quality",
            "implementation_discipline",
            "diff_traceability",
            "tdd",
            "systematic_debugging",
            "review_sequence",
            "human_review_evidence",
            "completion_verification",
        ):
            if gate not in gates:
                print(f"error: .agent/workflow.json missing gate: {gate}")
                return 1
        discipline = gates.get("implementation_discipline", {})
        for key in (
            "state_assumptions_when_ambiguous",
            "prefer_simple_direct_code",
            "avoid_speculative_features",
            "abstractions_require_repeated_complexity_or_existing_pattern",
            "touch_only_requested_scope",
            "every_changed_line_traces_to_request",
            "success_criteria_required",
        ):
            if key not in discipline:
                print(f"error: .agent/workflow.json implementation_discipline missing policy: {key}")
                return 1
        sequence = gates.get("review_sequence", {}).get("order", [])
        if sequence != ["spec_review", "quality_review"]:
            print("error: .agent/workflow.json review sequence must be spec_review then quality_review")
            return 1
        if gates.get("review_sequence", {}).get("finder_cannot_fix") is not True:
            print("error: .agent/workflow.json review sequence must enforce finder_cannot_fix")
            return 1
        if not gates.get("risk_classification", {}).get("record_in_plan"):
            print("error: .agent/workflow.json risk classification must be recorded in plans")
            return 1
        if not gates.get("diff_traceability", {}).get("every_changed_line_traces_to_request"):
            print("error: .agent/workflow.json diff traceability gate must trace changed lines to request")
            return 1
        if not gates.get("human_review_evidence", {}).get("requires_diff_or_file_review"):
            print("error: .agent/workflow.json human review evidence must require diff or file review")
            return 1

    profiles_path = root / ".agent/workflow-profiles.json"
    if profiles_path.exists():
        profiles = load_json(profiles_path, ".agent/workflow-profiles.json")
        if profiles.get("schema") != "agent-workflow-profiles-v1":
            print("error: .agent/workflow-profiles.json schema must be agent-workflow-profiles-v1")
            return 1
        configured = profiles.get("profiles", {})
        for profile in ("tiny", "bugfix", "standard", "full"):
            if profile not in configured:
                print(f"error: .agent/workflow-profiles.json missing profile: {profile}")
                return 1
            spec = configured[profile]
            for key in ("stages", "max_risk", "task_board_record", "feature_doc_templates", "required_evidence"):
                if key not in spec:
                    print(f"error: workflow profile {profile} missing {key}")
                    return 1
            for stage in spec.get("stages", []):
                if workflow_stages and stage not in workflow_stages:
                    print(f"error: workflow profile {profile} references unknown stage: {stage}")
                    return 1
        if profiles.get("policy", {}).get("choose_lightest_profile_that_covers_risk") is not True:
            print("error: workflow profiles must choose the lightest profile that covers risk")
            return 1

    task_board_path = root / ".agent/task-board.json"
    if task_board_path.exists():
        task_board = load_json(task_board_path, ".agent/task-board.json")
        if task_board.get("schema") != "agent-task-board-v1":
            print("error: .agent/task-board.json schema must be agent-task-board-v1")
            return 1
        for field in ("id", "title", "state", "risk", "profile", "current_stage", "docs_path", "delivery_conclusion", "related_tasks"):
            if field not in task_board.get("required_fields", []):
                print(f"error: .agent/task-board.json missing required field declaration: {field}")
                return 1
        if task_board.get("policy", {}).get("new_session_reads_board_before_edits") is not True:
            print("error: .agent/task-board.json must require new sessions to read the task board")
            return 1
        seen_tasks: set[str] = set()
        allowed_states = set(task_board.get("states", []))
        allowed_profiles = set(load_json(root / ".agent/workflow-profiles.json", ".agent/workflow-profiles.json").get("profiles", {})) if profiles_path.exists() else set()
        for item in task_board.get("items", []):
            task_id = item.get("id")
            if not task_id:
                print("error: .agent/task-board.json item missing id")
                return 1
            if task_id in seen_tasks:
                print(f"error: duplicate task-board id: {task_id}")
                return 1
            seen_tasks.add(task_id)
            if item.get("state") not in allowed_states:
                print(f"error: task {task_id} has invalid state")
                return 1
            if allowed_profiles and item.get("profile") not in allowed_profiles:
                print(f"error: task {task_id} has invalid workflow profile")
                return 1
            if allowed_profiles:
                profile = load_json(root / ".agent/workflow-profiles.json", ".agent/workflow-profiles.json").get("profiles", {}).get(item.get("profile"), {})
                allowed_stages = set(profile.get("stages", []))
                if allowed_stages and item.get("current_stage") not in allowed_stages:
                    print(f"error: task {task_id} has invalid current_stage for profile {item.get('profile')}: {item.get('current_stage')}")
                    return 1
            if item.get("state") == "done" and task_board.get("policy", {}).get("done_requires_delivery_conclusion") is True:
                if not str(item.get("delivery_conclusion", "")).strip():
                    print(f"error: task {task_id} is done without delivery_conclusion")
                    return 1

    risk_path = root / ".agent/risk-zones.json"
    if risk_path.exists():
        risk = load_json(risk_path, ".agent/risk-zones.json")
        if risk.get("schema") != "agent-risk-zones-v1":
            print("error: .agent/risk-zones.json schema must be agent-risk-zones-v1")
            return 1
        levels = risk.get("autonomy_levels", {})
        for level in ("low", "medium", "high", "critical"):
            if level not in levels:
                print(f"error: .agent/risk-zones.json missing autonomy level: {level}")
                return 1
        if levels.get("high", {}).get("human_review_required") is not True:
            print("error: high risk changes must require human review")
            return 1
        if levels.get("critical", {}).get("agent_may_not_autonomously_modify") is not True:
            print("error: critical risk changes must block autonomous modification")
            return 1
        policy = risk.get("policy", {})
        for key in ("classify_before_implementation", "record_risk_in_plan_and_review", "stop_when_risk_increases"):
            if policy.get(key) is not True:
                print(f"error: .agent/risk-zones.json policy must enable {key}")
                return 1

    review_policy_path = root / ".agent/review-policy.json"
    if review_policy_path.exists():
        review_policy = load_json(review_policy_path, ".agent/review-policy.json")
        if review_policy.get("schema") != "agent-review-policy-v1":
            print("error: .agent/review-policy.json schema must be agent-review-policy-v1")
            return 1
        trace = review_policy.get("diff_traceability", {})
        categories = trace.get("categories", [])
        for category in ("requested", "necessary-support", "incidental", "risky"):
            if category not in categories:
                print(f"error: .agent/review-policy.json missing diff category: {category}")
                return 1
        if trace.get("every_changed_line_traces_to_request") is not True:
            print("error: .agent/review-policy.json must require changed-line traceability")
            return 1
        human = review_policy.get("human_review", {})
        for field in ("reviewer", "review_type", "diff_range", "files_reviewed", "high_risk_paths_checked", "conclusion"):
            if field not in human.get("evidence_fields", []):
                print(f"error: .agent/review-policy.json missing human review evidence field: {field}")
                return 1
        if "high" not in human.get("required_for_risk", []) or "critical" not in human.get("required_for_risk", []):
            print("error: .agent/review-policy.json must require human review for high and critical risk")
            return 1

    worktrees_path = root / ".agent/worktrees.json"
    if worktrees_path.exists():
        worktrees = load_json(worktrees_path, ".agent/worktrees.json")
        if worktrees.get("schema") != "agent-worktree-policy-v1":
            print("error: .agent/worktrees.json schema must be agent-worktree-policy-v1")
            return 1
        policy = worktrees.get("policy", {})
        for key in ("verify_project_local_dir_is_git_ignored", "run_baseline_validation_before_feature_edits", "discard_requires_typed_confirmation"):
            if key not in policy:
                print(f"error: .agent/worktrees.json missing policy: {key}")
                return 1

    subagents_path = root / ".agent/subagents.json"
    if subagents_path.exists():
        subagents = load_json(subagents_path, ".agent/subagents.json")
        if subagents.get("schema") != "agent-subagent-orchestration-v1":
            print("error: .agent/subagents.json schema must be agent-subagent-orchestration-v1")
            return 1
        roles = subagents.get("roles", {})
        for role in ("searcher", "explorer", "worker", "verifier", "spec_reviewer", "quality_reviewer", "reviewer"):
            if role not in roles:
                print(f"error: .agent/subagents.json missing role: {role}")
                return 1
        snapshot = subagents.get("snapshot_contract", {})
        if snapshot.get("marker") != "===SNAPSHOT===":
            print("error: .agent/subagents.json snapshot marker must be ===SNAPSHOT===")
            return 1
        if snapshot.get("status_values") != ["DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED"]:
            print("error: .agent/subagents.json snapshot status values are out of date")
            return 1
        if snapshot.get("risk_values") != ["low", "medium", "high", "critical"]:
            print("error: .agent/subagents.json snapshot risk values are out of date")
            return 1
        workflow = subagents.get("review_workflow", {})
        if workflow.get("review_sequence") != ["spec_reviewer", "quality_reviewer"]:
            print("error: .agent/subagents.json review sequence must be spec_reviewer then quality_reviewer")
            return 1
        if subagents.get("policy", {}).get("finder_cannot_fix") is not True:
            print("error: .agent/subagents.json must enforce finder_cannot_fix")
            return 1
        if subagents.get("role_contracts") != ".agent/role-contracts.json":
            print("error: .agent/subagents.json must point to .agent/role-contracts.json")
            return 1

    role_contracts_path = root / ".agent/role-contracts.json"
    if role_contracts_path.exists():
        contracts = load_json(role_contracts_path, ".agent/role-contracts.json")
        if contracts.get("schema") != "agent-role-contracts-v1":
            print("error: .agent/role-contracts.json schema must be agent-role-contracts-v1")
            return 1
        if contracts.get("policy", {}).get("finder_cannot_fix") is not True:
            print("error: .agent/role-contracts.json must enforce finder_cannot_fix")
            return 1
        separation = contracts.get("separation_of_duties", {})
        if separation.get("finder_cannot_modify_files") is not True:
            print("error: .agent/role-contracts.json must block finder file modification")
            return 1
        for role in ("coordinator", "worker", "verifier", "spec_reviewer", "quality_reviewer", "reviewer"):
            contract = contracts.get("contracts", {}).get(role, {})
            if not contract:
                print(f"error: .agent/role-contracts.json missing contract: {role}")
                return 1
            for key in ("owner_for_stages", "must_read", "may_write", "must_write", "forbidden_actions", "blocking_conditions"):
                if key not in contract:
                    print(f"error: role contract {role} missing {key}")
                    return 1
        for role in ("verifier", "spec_reviewer", "quality_reviewer", "reviewer"):
            forbidden = " ".join(contracts.get("contracts", {}).get(role, {}).get("forbidden_actions", []))
            if "fix" not in forbidden and "implementation" not in forbidden:
                print(f"error: finder role {role} must forbid direct fixes")
                return 1

    hooks_path = root / ".agent/hooks.json"
    if hooks_path.exists():
        hooks = load_json(hooks_path, ".agent/hooks.json")
        if hooks.get("schema") != "agent-hooks-v1":
