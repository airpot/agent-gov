        if context.get("policy", {}).get("doctor_fails_on_budget_excess") is True:
            tracked = context_tracked_files(root, context)
            total = sum(estimate_tokens(root / path) for path in tracked)
            total_budget = int(budgets.get("max_total_tracked_tokens", 20000))
            if total > total_budget:
                print(f"error: total tracked context over budget: {total} > {total_budget}")
                return 1
            for path in tracked:
                tokens = estimate_tokens(root / path)
                threshold = context_threshold(path, context)
                if tokens > threshold:
                    print(f"error: {path} over context budget: {tokens} > {threshold}")
                    return 1

