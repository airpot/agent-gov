        if mechanical.get("schema") != "agent-mechanical-checks-v1":
            print("error: .agent/mechanical-checks.json schema must be agent-mechanical-checks-v1")
            return 1
        checks = mechanical.get("checks", {})
        required_mechanical_checks = [
            "json_integrity",
            "jsonl_integrity",
            "required_paths",
            "feature_templates",
            "task_board",
            "role_contracts",
            "manifest",
            "dev_map",
            "harness_evolution",
            "governance_gc",
            "markdown_links",
        ]
        if (root / ".agent/mcp-policy.json").exists():
            required_mechanical_checks.append("mcp_policy")
        for key in required_mechanical_checks:
            if key not in checks:
                print(f"error: .agent/mechanical-checks.json missing check: {key}")
                return 1
        if checks.get("role_contracts", {}).get("enforce_finder_cannot_fix") is not True:
            print("error: mechanical role contract check must enforce finder_cannot_fix")
            return 1
        baseline_policy = mechanical.get("baseline_policy", {})
        if baseline_policy.get("fail_on_new_invalid_json") is not True:
            print("error: mechanical baseline policy must fail on new invalid JSON")
            return 1

    baselines_path = root / ".agent/baselines.json"
    if baselines_path.exists():
        baselines = load_json(baselines_path, ".agent/baselines.json")
        if baselines.get("schema") != "agent-baselines-v1":
            print("error: .agent/baselines.json schema must be agent-baselines-v1")
            return 1
        if not baselines.get("snapshot_dir"):
            print("error: .agent/baselines.json missing snapshot_dir")
            return 1

    evolution_path = root / ".agent/harness-evolution.json"
    if evolution_path.exists():
        evolution = load_json(evolution_path, ".agent/harness-evolution.json")
        if evolution.get("schema") != "agent-harness-evolution-v1":
            print("error: .agent/harness-evolution.json schema must be agent-harness-evolution-v1")
            return 1
        for category in ("rule_gap", "skill_gap", "script_gap", "workflow_gap", "role_contract_gap", "tool_or_mcp_gap", "knowledge_gap", "session_gap", "context_gap"):
            if category not in evolution.get("incident_categories", {}):
                print(f"error: .agent/harness-evolution.json missing incident category: {category}")
                return 1
        if evolution.get("policy", {}).get("turn_repeat_failures_into_harness_changes") is not True:
            print("error: harness evolution must promote repeat failures into harness changes")
            return 1

    mcp_policy_path = root / ".agent/mcp-policy.json"
    if mcp_policy_path.exists():
        mcp_policy = load_json(mcp_policy_path, ".agent/mcp-policy.json")
        if mcp_policy.get("schema") != "agent-mcp-policy-v1":
