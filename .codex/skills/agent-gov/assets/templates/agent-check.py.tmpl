def load_json(path: Path, label: str) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        print(f"error: {label} is invalid JSON: {exc}")
        raise SystemExit(1)


def load_jsonl(path: Path, label: str) -> list[dict]:
    rows: list[dict] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        print(f"error: cannot read {label}: {exc}")
        raise SystemExit(1)
    for index, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            print(f"error: {label} line {index} is invalid JSON: {exc}")
            raise SystemExit(1)
    return rows


def load_jsonl_with_errors(path: Path, label: str) -> tuple[list[dict], list[str]]:
    rows: list[dict] = []
    errors: list[str] = []
    if not path.exists():
        return rows, errors
    for index, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            errors.append(f"{label} line {index} is invalid JSON: {exc}")
    return rows, errors


def strip_line_suffix(handle: str) -> str:
    match = re.match(r"^(.+?):\d+(?::\d+)?$", handle)
    return match.group(1) if match else handle


def evidence_exists(root: Path, handle: str, runlog_ids: set[str], session_event_ids: set[str]) -> bool:
    handle = handle.strip()
    if not handle:
        return False
    if handle in runlog_ids or handle in session_event_ids:
        return True
    return (root / strip_line_suffix(handle)).exists()


def has_placeholder_text(text: str) -> bool:
    text = re.sub(r"`[^`]*`", "", text)
    text = re.sub(r'"[^"\n]*"', "", text)
    text = re.sub(r"'[^'\n]*'", "", text)
    lowered = text.lower()
    return any(pattern.lower() in lowered for pattern in PLACEHOLDER_PATTERNS)


def estimate_tokens(path: Path) -> int:
    if not path.exists() or not path.is_file():
        return 0
    return int(math.ceil(len(path.read_text(encoding="utf-8", errors="ignore")) / 4))


def context_threshold(path: str, context: dict) -> int:
    budgets = context.get("budgets", {})
    if path == "AGENTS.md":
        return int(budgets.get("max_agent_instruction_tokens", 1600))
    if path == "CLAUDE.md":
        return int(budgets.get("max_claude_instruction_tokens", 2500))
    if path == ".agent/sessions/bootstrap.md":
        return int(budgets.get("max_bootstrap_tokens", 5000))
    if path == ".agent/memory/latest.md":
        return int(budgets.get("max_memory_digest_tokens", 1200))
    return int(budgets.get("max_single_doc_tokens", 3000))


def context_tracked_files(root: Path, context: dict) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for value in context.get("tracked_files", []):
        path = root / str(value)
        if path.exists() and path.is_file() and str(value) not in seen:
            seen.add(str(value))
            result.append(str(value))
    for pattern in context.get("tracked_globs", []):
        for path in sorted(root.glob(str(pattern))):
            if path.is_file():
                rel = path.relative_to(root).as_posix()
                if rel not in seen:
                    seen.add(rel)
                    result.append(rel)
    return result


def validate_skill_runtime(root: Path, path: Path) -> list[str]:
    errors: list[str] = []
    runtime = load_json(path, str(path.relative_to(root) if path.is_absolute() else path))
    if runtime.get("schema") != "agent-skill-runtime-v1":
        return [".agent/skill-runtime.json schema must be agent-skill-runtime-v1"]
    required_sections = [
        "source_evidence",
        "canonical_core",
        "host_adapters",
        "runtime_modes",
        "command_lanes",
        "review_lanes",
        "impact_benchmarks",
        "shortcut_debt",
        "dependency_policy",
    ]
    for section in required_sections:
        if section not in runtime:
            errors.append(f".agent/skill-runtime.json missing section: {section}")
    evidence = runtime.get("source_evidence", [])
    if not isinstance(evidence, list) or not evidence:
        errors.append(".agent/skill-runtime.json source_evidence must be a non-empty list")
    else:
        for item in evidence:
            if item.get("status") not in {"verified", "partial", "blocked"}:
                errors.append(".agent/skill-runtime.json source_evidence status must be verified, partial, or blocked")
    core = runtime.get("canonical_core", {})
    patterns = set(core.get("path_patterns", []))
    for pattern in ("SKILL.md", "AGENTS.md", "references/", "scripts/", "assets/"):
        if pattern not in patterns:
            errors.append(f".agent/skill-runtime.json canonical_core missing path pattern: {pattern}")
    for key in ("core_files_are_authoritative", "adapters_must_be_thin", "do_not_duplicate_behavior_in_host_adapters"):
        if core.get(key) is not True:
            errors.append(f".agent/skill-runtime.json canonical_core must enable {key}")
    adapter_policy = runtime.get("host_adapters", {}).get("parity_policy", {})
    for key in (
        "canonical_source_required",
        "adapter_drift_must_be_detected",
        "release_claim_requires_parity_evidence",
        "hook_projection_boundary_required",
        "orphaned_hook_files_are_findings",
        "empty_hooks_object_may_suppress_autodiscovery",
    ):
        if adapter_policy.get(key) is not True:
            errors.append(f".agent/skill-runtime.json adapter parity policy must enable {key}")
    adapters = runtime.get("host_adapters", {}).get("adapter_targets", [])
    if not isinstance(adapters, list) or not adapters:
        errors.append(".agent/skill-runtime.json host_adapters.adapter_targets must be non-empty")
    else:
        for adapter in adapters:
            for key in ("host", "path_patterns", "capability_tier", "projection_type", "parity_check"):
                if key not in adapter:
                    errors.append(f".agent/skill-runtime.json adapter target missing {key}")
    modes = runtime.get("runtime_modes", {})
    allowed_modes = modes.get("allowed_modes", [])
    for mode in ("off", "advisory", "standard", "strict", "audit-only"):
        if mode not in allowed_modes:
            errors.append(f".agent/skill-runtime.json runtime_modes missing mode: {mode}")
    if modes.get("deactivation_mode") not in allowed_modes:
        errors.append(".agent/skill-runtime.json deactivation_mode must be an allowed mode")
    hook_boundaries = modes.get("hook_boundaries", {})
    for key in (
        "read_only_by_default",
        "stdin_must_not_deadlock",
        "stdin_errors_degrade_safely",
        "strip_utf8_bom_before_json_parse",
        "valid_json_required_when_host_requires_json",
        "preserve_empty_additional_context",
        "invalid_mandatory_output_exits_nonzero",
        "failure_degrades_safely",
        "hook_must_not_store_secrets",
    ):
        if hook_boundaries.get(key) is not True:
            errors.append(f".agent/skill-runtime.json hook_boundaries must enable {key}")
    lanes = runtime.get("command_lanes", {})
    for lane in ("mode_switch", "complexity_review", "repository_audit", "debt_harvest", "impact_scoreboard", "help_status"):
        if lane not in lanes:
            errors.append(f".agent/skill-runtime.json missing command lane: {lane}")
    review_lanes = runtime.get("review_lanes", {})
    for lane in ("spec_compliance", "quality_security", "complexity_only", "debt_ledger", "impact_benchmark"):
        if lane not in review_lanes:
            errors.append(f".agent/skill-runtime.json missing review lane: {lane}")
    complexity = review_lanes.get("complexity_only", {})
    forbidden = set(complexity.get("forbidden_findings", []))
    for finding in ("correctness", "security", "privacy", "data-loss", "accessibility"):
        if finding not in forbidden:
            errors.append(f".agent/skill-runtime.json complexity_only must route {finding} out of complexity audit")
    benchmark_policy = runtime.get("impact_benchmarks", {}).get("policy", {})
    for key in (
        "baseline_arm_required",
        "skill_enabled_arm_required",
        "isolated_workspaces_or_plugin_dirs_required",
        "contamination_selftest_required",
        "correctness_or_safety_gate_required",
        "preserve_outputs",
        "record_limitations",
        "reduction_claims_must_not_drop_safety_or_requirements",
    ):
        if benchmark_policy.get(key) is not True:
            errors.append(f".agent/skill-runtime.json impact benchmark policy must enable {key}")
    debt = runtime.get("shortcut_debt", {})
    if debt.get("marker") != "agent-gov-debt:":
        errors.append(".agent/skill-runtime.json shortcut_debt marker must be agent-gov-debt:")
    for field in ("ceiling", "upgrade_trigger"):
        if field not in debt.get("required_fields", []):
            errors.append(f".agent/skill-runtime.json shortcut_debt required_fields missing {field}")
    dependency_policy = runtime.get("dependency_policy", {})
    for key in ("local_doctors_dependency_free", "python_standard_library_only_for_generated_checks", "no_network_required_for_doctor", "no_global_plugin_state_required_for_doctor"):
        if dependency_policy.get(key) is not True:
            errors.append(f".agent/skill-runtime.json dependency policy must enable {key}")
    if not (root / "docs/SKILL_RUNTIME.md").exists():
        errors.append("missing docs/SKILL_RUNTIME.md")
    return errors


def check_session_offload(root: Path) -> list[str]:
    errors: list[str] = []
    index_path = root / ".agent/sessions/index.json"
    if not index_path.exists():
        return errors
    try:
        index = load_json(index_path, ".agent/sessions/index.json")
    except SystemExit:
        raise
    active_session = index.get("active_session")
    if not active_session:
        return errors
    session_dir = root / ".agent/sessions" / str(active_session)
    required = ["grounding.md", "offload.jsonl", "offload-index.md", "task-map.mmd", "refs/.gitkeep", "refs/git-status-short.txt"]
    for name in required:
        if not (session_dir / name).exists():
            errors.append(f"active session missing {session_dir / name}")
    snapshot_path = session_dir / "refs/git-status-short.txt"
    if snapshot_path.exists():
        result = subprocess.run(["git", "status", "--short"], cwd=root, text=True, capture_output=True, check=False)
        if result.returncode == 0 and snapshot_path.read_text(encoding="utf-8").rstrip("\n") != result.stdout.rstrip("\n"):
            errors.append(f"{snapshot_path} must match current git status --short")
    grounding_text = (session_dir / "grounding.md").read_text(encoding="utf-8", errors="ignore") if (session_dir / "grounding.md").exists() else ""
    if "Repository Truth" not in grounding_text or "override memory summaries" not in grounding_text:
        errors.append(f"{session_dir / 'grounding.md'} must record truth-first repository grounding")
    bootstrap_text = (root / ".agent/sessions/bootstrap.md").read_text(encoding="utf-8", errors="ignore") if (root / ".agent/sessions/bootstrap.md").exists() else ""
    if "Truth-First Grounding" not in bootstrap_text or "Offload Index" not in bootstrap_text:
        errors.append(".agent/sessions/bootstrap.md must include grounding and offload sections")
    runlog_ids = {str(item.get("id")) for item in load_jsonl(root / ".agent/runlog.jsonl", ".agent/runlog.jsonl") if item.get("id")} if (root / ".agent/runlog.jsonl").exists() else set()
    event_ids = {str(item.get("id")) for item in load_jsonl(root / ".agent/sessions/events.jsonl", ".agent/sessions/events.jsonl") if item.get("id")} if (root / ".agent/sessions/events.jsonl").exists() else set()
    for offload_file in (root / ".agent/sessions").glob("*/offload.jsonl"):
        rows, parse_errors = load_jsonl_with_errors(offload_file, str(offload_file.relative_to(root)))
        errors.extend(parse_errors)
        for item in rows:
            entry_id = item.get("id") or "<missing-id>"
            if item.get("schema") != OFFLOAD_SCHEMA:
                errors.append(f"{offload_file.relative_to(root)} entry {entry_id} schema must be {OFFLOAD_SCHEMA}")
            if item.get("authority") != "advisory":
                errors.append(f"{offload_file.relative_to(root)} entry {entry_id} must be advisory")
            evidence = item.get("evidence")
            if not isinstance(evidence, list) or not evidence:
                errors.append(f"{offload_file.relative_to(root)} entry {entry_id} must include evidence handles")
                continue
            for handle in evidence:
                if not isinstance(handle, str) or not evidence_exists(root, handle, runlog_ids, event_ids):
                    errors.append(f"{offload_file.relative_to(root)} entry {entry_id} evidence is missing: {handle}")
    return errors


def config_path_pointers(config: dict) -> dict[str, str]:
    paths = config.get("paths", {})
    if isinstance(paths, dict) and paths:
        return {str(key): str(value) for key, value in paths.items() if isinstance(value, str)}
    return {
        key: value
        for key, value in config.items()
        if key in LEGACY_CONFIG_PATH_KEYS and isinstance(value, str) and value
    }


def profile_requires_review_gate(profile_name: str, profile: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("done_requires_review_gate_pass_for_profiles", []))
    return profile.get("review_gate_required") is True or profile_name in required_profiles


def normalized_review_gate(item: dict, profile: dict, policy: dict) -> dict:
    required = profile_requires_review_gate(str(item.get("profile", "")), profile, policy)
    gate = item.get("review_gate")
    if not isinstance(gate, dict):
        gate = {}
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "latest_review": "",
        "latest_fix": "",
        "open_findings": [],
        "accepted_exception": "",
    }
    merged.update(gate)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_findings"), list):
        merged["open_findings"] = [str(merged.get("open_findings"))]
    return merged


def normalized_requirements(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    requirements = item.get("requirements")
    if not isinstance(requirements, dict):
        requirements = {}
    required = profile_name != "tiny"
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "shared_understanding": "",
        "domain_glossary_updated": False,
        "code_docs_cross_checked": False,
        "open_questions": [],
    }
    merged.update(requirements)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_questions"), list):
        merged["open_questions"] = [str(merged.get("open_questions"))]
    return merged


def normalized_goal_contract(item: dict) -> dict:
    contract = item.get("goal_contract")
    if not isinstance(contract, dict):
        contract = {}
    merged = {
        "raw_user_goal": "",
        "refined_goal": "",
        "refinement_rationale": "",
        "user_confirmation_status": "pending",
        "objective": "",
        "user_approved_outcome": "",
        "non_goals": [],
        "constraints": [],
        "success_evidence": [],
        "stop_conditions": [],
        "current_decision_summary": "",
        "open_decisions": [],
        "linked_task_id": str(item.get("id", "")),
        "linked_spec_change_id": str(item.get("spec_change", "")),
    }
    merged.update(contract)
    for field in GOAL_CONTRACT_LIST_FIELDS:
        value = merged.get(field)
        if value is None or value == "":
            merged[field] = []
        elif not isinstance(value, list):
            merged[field] = [str(value)]
    return merged


def goal_contract_required(item: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("goal_contract_required_for_profiles", ["standard", "full"]))
    required_states = set(policy.get("goal_contract_required_states", ["active", "review", "done"]))
    required_stages = set(policy.get("goal_contract_required_before_stages", []))
    return str(item.get("profile", "")) in required_profiles and (
        str(item.get("state", "")) in required_states or str(item.get("current_stage", "")) in required_stages
    )


def validate_goal_contract(task_id: str, item: dict, policy: dict) -> str | None:
    if not goal_contract_required(item, policy):
        return None
    contract = normalized_goal_contract(item)
    required_fields = policy.get("goal_contract_required_fields") or list(GOAL_CONTRACT_REQUIRED_FIELDS)
    for field in required_fields:
        value = contract.get(field)
        if field in GOAL_CONTRACT_LIST_FIELDS:
            present = isinstance(value, list) and (
                field not in GOAL_CONTRACT_NONEMPTY_LIST_FIELDS or any(str(entry).strip() for entry in value)
            )
            if not present:
                return f"task {task_id} goal_contract missing {field}"
        elif not str(value or "").strip():
            return f"task {task_id} goal_contract missing {field}"
    if contract.get("linked_task_id") and contract.get("linked_task_id") != task_id:
        return f"task {task_id} goal_contract linked_task_id must match task id"
    if contract.get("user_confirmation_status") not in GOAL_CONFIRMATION_STATUSES:
        return f"task {task_id} goal_contract user_confirmation_status is invalid"
    return None


def normalized_task_decomposition(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    decomposition = item.get("task_decomposition")
    if not isinstance(decomposition, dict):
        decomposition = {}
    merged = {
        "required": True,
        "status": "pending",
        "summary": "",
        "next_task": "",
        "subtasks": [],
        "dependencies": [],
        "evidence_path": "",
        "no_task_board_tiny_evidence": "" if profile_name == "tiny" else "not-applicable",
    }
    merged.update(decomposition)
    merged["required"] = bool(merged.get("required") is not False)
    if merged.get("status") not in DECOMPOSITION_STATUSES:
        merged["status"] = "pending" if merged["required"] else "not-required"
    for field in ("subtasks", "dependencies"):
        if not isinstance(merged.get(field), list):
            merged[field] = [str(merged.get(field))]
    return merged


def validate_task_decomposition(task_id: str, item: dict, policy: dict) -> str | None:
    decomposition = normalized_task_decomposition(item)
    if decomposition.get("status") not in DECOMPOSITION_STATUSES:
        return f"task {task_id} task_decomposition has invalid status: {decomposition.get('status')}"
    if not decomposition.get("required"):
        return None
    complete_before_done = policy.get("task_decomposition_complete_before_done") is True
    protected = set(policy.get("task_decomposition_required_before_stages", []))
    current_stage = str(item.get("current_stage", ""))
    must_be_complete = (item.get("state") == "done" and complete_before_done) or current_stage in protected
    if not must_be_complete:
        return None
    if decomposition.get("status") != "complete":
        return f"task {task_id} task_decomposition must be complete before {current_stage or item.get('state')}"
    has_evidence = any(str(decomposition.get(field, "")).strip() for field in TASK_DECOMPOSITION_EVIDENCE_FIELDS)
    has_subtasks = any(str(entry).strip() for entry in decomposition.get("subtasks", []))
    if not has_evidence and not has_subtasks:
        return f"task {task_id} task_decomposition missing summary, next_task, evidence_path, or subtasks"
    return None


def validate_requirements(task_id: str, item: dict, profile: dict, policy: dict, root: Path) -> str | None:
    requirements = normalized_requirements(item)
    if requirements.get("status") not in REQUIREMENT_STATUSES:
        return f"task {task_id} requirements has invalid status: {requirements.get('status')}"
    if not requirements.get("required"):
        return None
    protected = set(profile.get("requirement_protected_stages", [])) or REQUIREMENT_PROTECTED_STAGES
    state_done = item.get("state") == "done" and policy.get("requirements_complete_before_done") is True
    stage_protected = item.get("current_stage") in protected and policy.get("requirements_complete_before_protected_stages") is True
    if not state_done and not stage_protected:
        return None
    if requirements.get("status") != "complete":
        return f"task {task_id} requirements must be complete before {item.get('current_stage') or item.get('state')}"
    if not str(requirements.get("shared_understanding", "")).strip():
        return f"task {task_id} requirements missing shared_understanding"
    if requirements.get("domain_glossary_updated") is not True:
        return f"task {task_id} requirements must confirm domain_glossary_updated"
    if requirements.get("code_docs_cross_checked") is not True:
        return f"task {task_id} requirements must confirm code_docs_cross_checked"
    docs_path = str(item.get("docs_path", "")).strip()
    if docs_path and not (root / docs_path / "01_REQUIREMENT_ANALYSIS.md").exists():
        return f"task {task_id} missing requirement analysis document"
    return None


def validate_review_gate(task_id: str, item: dict, profile: dict, policy: dict, root: Path) -> str | None:
    gate = normalized_review_gate(item, profile, policy)
    if gate.get("status") not in REVIEW_STATUSES:
        return f"task {task_id} review_gate has invalid status: {gate.get('status')}"
    open_findings = [finding for finding in gate.get("open_findings", []) if str(finding).strip()]
    if item.get("state") != "done" or not gate.get("required"):
        return None
    pass_status = policy.get("review_gate_pass_status", "pass")
    if gate.get("status") != pass_status:
        return f"task {task_id} is done without review_gate status {pass_status}"
    if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
        return f"task {task_id} is done with open review findings"
    latest_review = str(gate.get("latest_review", "")).strip()
    if not latest_review:
        return f"task {task_id} is done without review_gate latest_review"
    if policy.get("review_gate_latest_review_must_exist") is True and not (root / latest_review).exists():
        return f"task {task_id} review_gate latest_review path is missing: {latest_review}"
    return None


def stage_reviews(item: dict) -> dict:
    reviews = item.get("stage_reviews")
    return reviews if isinstance(reviews, dict) else {}


def stage_review_required_for_profile(profile_name: str, policy: dict) -> bool:
    required_profiles = set(policy.get("stage_review_loop_required_for_profiles", []))
    return profile_name in required_profiles


def stage_review_required_stages(policy: dict) -> list[str]:
    configured = policy.get("stage_review_required_before_stage_exit")
    if isinstance(configured, list) and configured:
        return [str(stage) for stage in configured]
    return list(STAGE_REVIEW_REQUIRED_STAGES)


def required_stage_reviews_for_item(item: dict, profile: dict, policy: dict) -> list[str]:
    profile_name = str(item.get("profile", ""))
    if not stage_review_required_for_profile(profile_name, policy):
        return []
    stages = [str(stage) for stage in profile.get("stages", [])]
    current_stage = str(item.get("current_stage", ""))
    required_before_exit = set(stage_review_required_stages(policy))
    if item.get("state") in {"done", "archived"}:
        exited = stages
    elif current_stage in stages:
        exited = stages[: stages.index(current_stage)]
    else:
        exited = []
    return [stage for stage in exited if stage in required_before_exit]


def validate_stage_reviews(task_id: str, item: dict, profile: dict, policy: dict, root: Path) -> list[str]:
    errors: list[str] = []
    if not isinstance(item.get("stage_reviews", {}), dict):
        return [f"task {task_id} stage_reviews must be an object"]
    reviews = stage_reviews(item)
    pass_status = policy.get("review_gate_pass_status", "pass")
    for stage in required_stage_reviews_for_item(item, profile, policy):
        review = reviews.get(stage)
        if not isinstance(review, dict):
            errors.append(f"task {task_id} missing stage review for exited stage: {stage}")
            continue
        status = review.get("status")
        if status not in REVIEW_STATUSES:
            errors.append(f"task {task_id} stage review {stage} has invalid status: {status}")
        if status != pass_status:
            errors.append(f"task {task_id} stage review {stage} must be {pass_status}")
        open_findings = [finding for finding in review.get("open_findings", []) if str(finding).strip()]
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            errors.append(f"task {task_id} stage review {stage} has open findings")
        latest_review = str(review.get("latest_review", "")).strip()
        if not latest_review:
            errors.append(f"task {task_id} stage review {stage} missing latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not (root / latest_review).exists():
            errors.append(f"task {task_id} stage review {stage} latest_review path is missing: {latest_review}")
    return errors


def validate_loop_engineering(loop_config: dict, workflow: dict, harness_evolution: dict | None = None) -> list[str]:
    errors: list[str] = []
    if loop_config.get("schema") != "agent-loop-engineering-v1":
        return ["error: .agent/loop-engineering.json schema must be agent-loop-engineering-v1"]
    policy = loop_config.get("policy", {})
    for key in (
        "loop_contract_required_for_non_tiny_work",
        "readiness_level_required_for_non_tiny_loops",
        "unattended_requires_attempt_ledger",
        "bounded_iterations_required",
        "observation_signal_required",
        "stop_conditions_required",
        "evidence_per_iteration_required",
        "attempt_ledger_required",
        "failure_signature_required",
        "same_failure_requires_strategy_change",
        "strategy_change_required_before_same_failure_retry",
        "quota_policy_required",
        "circuit_breaker_required",
        "budget_exhaustion_blocks_completion_claim",
        "human_interrupt_for_high_risk_or_destructive",
        "safe_fallback_lane_required",
        "loop_state_transitions_required",
        "resume_requires_last_committed_step_and_side_effect_boundary",
        "external_mutation_requires_idempotency_or_approval",
        "self_approval_is_not_release_evidence",
        "finder_cannot_fix_applies_to_review_loops",
        "prevalidate_inputs_before_expensive_work",
        "failed_runs_exit_nonzero",
        "failed_runs_record_evidence_paths",
        "failed_optimization_cannot_be_improvement",
        "dependency_free_control_plane",
    ):
        if policy.get(key) is not True:
            errors.append(f"error: .agent/loop-engineering.json policy missing {key}")
    threshold = policy.get("repeat_failure_threshold")
    if not isinstance(threshold, int) or threshold < 2:
        errors.append("error: .agent/loop-engineering.json repeat_failure_threshold must be an integer >= 2")
    for source in loop_config.get("sources", []):
        if isinstance(source, dict):
            if source.get("source_status") not in {"verified", "partial", "blocked"}:
                errors.append("error: .agent/loop-engineering.json sources must record source_status")
            if source.get("dependency_policy") != "source_only":
                errors.append("error: .agent/loop-engineering.json sources must be source_only")
    readiness = loop_config.get("readiness_levels", {})
    for level in ("manual", "report_only", "assisted", "unattended"):
        spec = readiness.get(level)
        if not isinstance(spec, dict):
            errors.append(f"error: .agent/loop-engineering.json missing readiness level: {level}")
            continue
        for key in ("required_controls", "human_gate", "state_persistence"):
            if not spec.get(key):
                errors.append(f"error: readiness level {level} missing {key}")
    unattended_controls = set(readiness.get("unattended", {}).get("required_controls", []))
    for control in ("attempt_ledger", "failure_signature", "quota_policy", "circuit_breaker", "human_interrupt_points", "non_empty_stop_conditions", "state_transition_contract", "safe_stop"):
        if control not in unattended_controls:
            errors.append(f"error: unattended readiness missing required control: {control}")
    ledger = loop_config.get("attempt_ledger", {})
    if not isinstance(ledger, dict):
        errors.append("error: .agent/loop-engineering.json missing attempt_ledger")
    else:
        required_fields = set(ledger.get("required_fields", []))
        for field in ("loop_id", "iteration_id", "readiness_level", "owner_role", "action_summary", "evidence_paths", "result_status", "failure_signature", "strategy_changed", "budget_usage_summary", "next_transition"):
            if field not in required_fields:
                errors.append(f"error: attempt_ledger missing required field: {field}")
        signature = ledger.get("failure_signature_policy", {})
        if signature.get("stable_signature_required") is not True:
            errors.append("error: attempt_ledger must require stable failure signatures")
        if signature.get("same_signature_retry_requires_strategy_changed") is not True:
            errors.append("error: attempt_ledger must require strategy change before same-signature retry")
    quota = loop_config.get("quota_policy", {})
    for key in ("iteration_count_required", "elapsed_time_budget_required", "token_budget_required_when_available", "cost_budget_required_when_available"):
        if quota.get(key) is not True:
            errors.append(f"error: quota_policy missing {key}")
    if quota.get("budget_exhaustion_transition") != "replan":
        errors.append("error: quota_policy budget_exhaustion_transition must be replan")
    breaker = loop_config.get("circuit_breakers", {})
    protected = set(breaker.get("protected_actions", []))
    for action in ("destructive", "production_write", "release", "billing", "credential", "privileged", "external_mutation"):
        if action not in protected:
            errors.append(f"error: circuit_breakers missing protected action: {action}")
    if breaker.get("missing_approval_behavior") != "fail_closed":
        errors.append("error: circuit_breakers missing_approval_behavior must be fail_closed")
    fallback = loop_config.get("safe_fallback_lane", {})
    if fallback.get("must_preserve_human_gate") is not True:
        errors.append("error: safe_fallback_lane must preserve human gate")
    if not fallback.get("allowed_work") or not fallback.get("forbidden_work"):
        errors.append("error: safe_fallback_lane must list allowed_work and forbidden_work")
    if fallback.get("requires_explicit_non_bypass_statement") is not True:
        errors.append("error: safe_fallback_lane must require an explicit non-bypass statement")
    transitions = loop_config.get("state_transitions", {})
    states = set(transitions.get("states", []))
    for state in ("pending", "running", "waiting_human", "waiting_tool", "paused", "retrying", "replan", "blocked", "completed", "failed", "cancelled"):
        if state not in states:
            errors.append(f"error: state_transitions missing state: {state}")
    allowed = transitions.get("allowed", {})
    for state in states:
        if state not in allowed:
            errors.append(f"error: state_transitions missing allowed transitions for {state}")
    exhaustion = set(transitions.get("exhaustion_transitions", []))
    if not exhaustion or not exhaustion.issubset({"replan", "blocked", "waiting_human", "failed", "accepted_exception"}):
        errors.append("error: state_transitions exhaustion_transitions must stop into replan, blocked, waiting_human, failed, or accepted_exception")
    resume_requirements = set(transitions.get("resume_requirements", []))
    for requirement in ("last_committed_step", "external_side_effect_boundary", "idempotency_or_approval_for_external_mutation"):
        if requirement not in resume_requirements:
            errors.append(f"error: state_transitions resume_requirements missing {requirement}")
    boundary = loop_config.get("dependency_boundary", {})
    if boundary.get("external_projects_are_sources_only") is not True:
        errors.append("error: dependency_boundary must keep external projects as sources only")
    if boundary.get("runtime_dependencies_allowed") not in ([], None):
        errors.append("error: dependency_boundary runtime_dependencies_allowed must be empty")
    if boundary.get("local_validation_requires_network") is not False:
        errors.append("error: dependency_boundary local validation must not require network")
    loop_types = loop_config.get("loop_types", {})
    required_types = {"work_loop", "review_fix_loop", "debugging_loop", "eval_optimization_loop", "session_recovery_loop"}
    for loop_type in required_types:
        spec = loop_types.get(loop_type)
        if not isinstance(spec, dict):
            errors.append(f"error: .agent/loop-engineering.json missing loop type: {loop_type}")
            continue
        if not isinstance(spec.get("sequence"), list) or not spec.get("sequence"):
            errors.append(f"error: loop type {loop_type} missing sequence")
        if loop_type == "eval_optimization_loop":
            if "prevalidate" not in spec.get("sequence", []):
                errors.append("error: .agent/loop-engineering.json eval_optimization_loop must prevalidate inputs")
            if "failed_run" not in spec.get("stop_conditions", []):
                errors.append("error: .agent/loop-engineering.json eval_optimization_loop must stop on failed_run")
        budget = spec.get("default_iteration_budget")
        if not isinstance(budget, int) or budget < 1:
            errors.append(f"error: loop type {loop_type} default_iteration_budget must be a positive integer")
        for key in ("observation_signals", "stop_conditions", "evidence"):
            if not isinstance(spec.get(key), list) or not spec.get(key):
                errors.append(f"error: loop type {loop_type} missing {key}")
    escalation = loop_config.get("escalation", {})
    for key in ("on_same_failure_repeated", "after_repeat_failure_threshold", "classification_command", "preferred_categories"):
        if not escalation.get(key):
            errors.append(f"error: .agent/loop-engineering.json escalation missing {key}")
    if "loop_gap" not in escalation.get("preferred_categories", []):
        errors.append("error: .agent/loop-engineering.json escalation preferred_categories must include loop_gap")
    gates = workflow.get("gates", {}) if isinstance(workflow, dict) else {}
    loop_gate = gates.get("loop_engineering", {})
    for key in (
        "loop_contract_required",
        "readiness_level_required",
        "attempt_ledger_required",
        "failure_signature_required",
        "iteration_budget_required",
        "quota_policy_required",
        "circuit_breaker_required",
        "observation_signal_required",
        "stop_conditions_required",
        "evidence_per_iteration_required",
        "safe_fallback_lane_required",
        "state_transition_contract_required",
        "same_failure_requires_strategy_change",
        "repeat_failures_promote_to_harness_evolution",
        "human_interrupt_for_high_risk_or_destructive",
        "self_approval_forbidden",
        "dependency_free_control_plane",
    ):
        if loop_gate.get(key) is not True:
            errors.append(f"error: .agent/workflow.json loop_engineering gate missing {key}")
    if set(loop_gate.get("required_for_profiles", [])) != {"standard", "full"}:
        errors.append("error: .agent/workflow.json loop_engineering gate must apply to standard and full profiles")
    if loop_gate.get("policy") != ".agent/loop-engineering.json":
        errors.append("error: .agent/workflow.json loop_engineering gate must point to .agent/loop-engineering.json")
    if harness_evolution:
        categories = harness_evolution.get("incident_categories", {})
        targets = harness_evolution.get("promotion_targets", {})
        if "loop_gap" not in categories:
            errors.append("error: .agent/harness-evolution.json missing loop_gap incident category")
        if ".agent/loop-engineering.json" not in targets.get("loop_gap", []):
            errors.append("error: .agent/harness-evolution.json loop_gap targets must include .agent/loop-engineering.json")
    return errors


def spec_delta_errors(root: Path, change_dir: Path, metadata: dict) -> list[str]:
    errors: list[str] = []
    if metadata.get("requires_spec_delta") is not True:
        return errors
    spec_files = sorted((change_dir / "specs").rglob("*.md"))
    name = metadata.get("name", change_dir.name)
    if not spec_files:
        return [f"change {name} requires spec delta but has no specs/**/*.md files"]
    for path in spec_files:
        text = path.read_text(encoding="utf-8", errors="ignore")
        rel = path.relative_to(root).as_posix()
        if has_placeholder_text(text):
            errors.append(f"{rel} contains placeholder text")
        if "## ADDED Requirements" not in text and "## MODIFIED Requirements" not in text:
            errors.append(f"{rel} missing ADDED or MODIFIED requirements section")
        if "### Requirement:" not in text:
            errors.append(f"{rel} missing requirement heading")
        if "#### Scenario:" not in text:
            errors.append(f"{rel} missing scenario heading")
    return errors


def validate_spec_task_links(root: Path, task_ids: set[str]) -> list[str]:
    errors: list[str] = []
    metadata_paths = list((root / "openspec/changes").glob("*/.agent-spec.json"))
    metadata_paths.extend((root / "openspec/changes/archive").glob("*/.agent-spec.json"))
    for metadata_path in sorted(metadata_paths):
        metadata = load_json(metadata_path, metadata_path.relative_to(root).as_posix())
        name = str(metadata.get("name") or metadata_path.parent.name)
        profile = str(metadata.get("profile", "")).strip()
        if profile and profile not in {"tiny", "bugfix", "standard", "full"}:
            errors.append(f"change {name} has invalid profile: {profile}")
        task_id = str(metadata.get("task_id", "")).strip()
        exception = str(metadata.get("task_link_exception", "")).strip()
        if profile and profile != "tiny" and not task_id and not exception:
            errors.append(f"change {name} missing task_id for non-tiny profile")
        if task_id and task_id not in task_ids:
            errors.append(f"change {name} task_id not found in task board: {task_id}")
        errors.extend(spec_delta_errors(root, metadata_path.parent, metadata))
    return errors


def main() -> int:
    root = Path.cwd()

    config_path = root / ".agent/config.json"
    config = {}
    if config_path.exists():
        config = load_json(config_path, ".agent/config.json")
        if config.get("schema") != "agent-project-config-v1":
            print("error: .agent/config.json schema must be agent-project-config-v1")
            return 1
        for key in ("project_name", "remote_workspace_path", "created_at"):
            if not config.get(key):
                print(f"error: .agent/config.json missing required field: {key}")
                return 1
        if config.get("governance_profile") not in {"core", "standard", "full"}:
            print("error: .agent/config.json governance_profile must be core, standard, or full")
            return 1
        for key, path in config_path_pointers(config).items():
            if not (root / path).exists():
                print(f"error: .agent/config.json path pointer is missing: {key} -> {path}")
                return 1

    manifest_path = root / ".agent/manifest.json"
    manifest = {}
    if manifest_path.exists():
        manifest = load_json(manifest_path, ".agent/manifest.json")
        if manifest.get("schema") != "agent-governance-manifest-v1":
            print("error: .agent/manifest.json schema must be agent-governance-manifest-v1")
            return 1
        if not manifest.get("required_paths"):
            print("error: .agent/manifest.json missing required_paths")
            return 1

    openspec_enabled = bool(config.get("openspec_enabled", config.get("spec_source", "openspec") == "openspec"))
    claude_enabled = bool(config.get("claude_enabled", True))
    if manifest.get("required_paths"):
        required = list(manifest["required_paths"])
    else:
        required = list(BASE_REQUIRED)
        if openspec_enabled:
            required.extend(OPENSPEC_REQUIRED)
        if claude_enabled:
            required.extend(CLAUDE_REQUIRED)
    missing = [path for path in required if not (root / path).exists()]

    index_path = root / ".agent/sessions/index.json"
    if index_path.exists():
        load_json(index_path, ".agent/sessions/index.json")
    session_events_path = root / ".agent/sessions/events.jsonl"
    if session_events_path.exists():
        for item in load_jsonl(session_events_path, ".agent/sessions/events.jsonl"):
            if item.get("schema") != "agent-session-event-v1":
                print("error: .agent/sessions/events.jsonl entries must use schema agent-session-event-v1")
                return 1
