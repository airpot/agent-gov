        if "release_or_signing" not in mcp_policy.get("trust_boundaries", {}):
            print("error: .agent/mcp-policy.json missing release_or_signing trust boundary")
            return 1

    gc_path = root / ".agent/governance-gc.json"
    if gc_path.exists():
        gc_config = load_json(gc_path, ".agent/governance-gc.json")
        if gc_config.get("schema") != "agent-governance-gc-v1":
