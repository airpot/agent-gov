        if not (root / "scripts/agent_resources.py").exists():
            print("error: missing scripts/agent_resources.py")
            return 1
        result = subprocess.run([sys.executable, "scripts/agent_resources.py", "doctor"], text=True, capture_output=True, check=False)
        if result.returncode != 0:
            output = (result.stdout + result.stderr).strip()
