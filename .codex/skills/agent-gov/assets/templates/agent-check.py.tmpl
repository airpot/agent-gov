        truth_sources = [str(item) for item in memory_policy.get("truth_sources_in_order", [])]
        for token in (".agent/spec.json", ".agent/task-board.json", "docs/DEV_MAP.md", "docs/features", "docs/adr", ".agent/runlog.jsonl"):
            if not any(token in item for item in truth_sources):
                print(f"error: .agent/memory.json truth_sources missing {token}")
                return 1

    context_path = root / ".agent/context.json"
    if context_path.exists():
        context = load_json(context_path, ".agent/context.json")
        if context.get("schema") != "agent-context-budget-v1":
            print("error: .agent/context.json schema must be agent-context-budget-v1")
            return 1
        stores = context.get("stores", {})
        for key in ("stats_jsonl", "latest_digest"):
            if key not in stores:
                print(f"error: .agent/context.json missing store: {key}")
                return 1
        budgets = context.get("budgets", {})
        for key in ("max_total_tracked_tokens", "max_single_doc_tokens", "max_subagent_result_tokens"):
            if key not in budgets:
                print(f"error: .agent/context.json missing budget: {key}")
                return 1
        if context.get("policy", {}).get("doctor_fails_on_budget_excess") is True:
            tracked = context_tracked_files(root, context)
            total = sum(estimate_tokens(root / path) for path in tracked)
            total_budget = int(budgets.get("max_total_tracked_tokens", 20000))
            if total > total_budget:
                print(f"error: total tracked context over budget: {total} > {total_budget}")
                return 1
            for path in tracked:
                tokens = estimate_tokens(root / path)
                threshold = context_threshold(path, context)
                if tokens > threshold:
                    print(f"error: {path} over context budget: {tokens} > {threshold}")
                    return 1

    distribution_path = root / ".agent/skill-distribution.json"
