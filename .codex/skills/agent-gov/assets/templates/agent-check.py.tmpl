def load_json(path: Path, label: str) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        print(f"error: {label} is invalid JSON: {exc}")
        raise SystemExit(1)


def load_jsonl(path: Path, label: str) -> list[dict]:
    rows: list[dict] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        print(f"error: cannot read {label}: {exc}")
        raise SystemExit(1)
    for index, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            print(f"error: {label} line {index} is invalid JSON: {exc}")
            raise SystemExit(1)
    return rows


def main() -> int:
    root = Path.cwd()

    config_path = root / ".agent/config.json"
    config = {}
    if config_path.exists():
        config = load_json(config_path, ".agent/config.json")
        if config.get("schema") != "agent-project-config-v1":
            print("error: .agent/config.json schema must be agent-project-config-v1")
            return 1
        for key in ("project_name", "remote_workspace_path", "created_at"):
            if not config.get(key):
                print(f"error: .agent/config.json missing required field: {key}")
                return 1

    openspec_enabled = bool(config.get("openspec_enabled", config.get("spec_source", "openspec") == "openspec"))
    claude_enabled = bool(config.get("claude_enabled", True))
    required = list(BASE_REQUIRED)
    if openspec_enabled:
        required.extend(OPENSPEC_REQUIRED)
    if claude_enabled:
        required.extend(CLAUDE_REQUIRED)
    missing = [path for path in required if not (root / path).exists()]

    index_path = root / ".agent/sessions/index.json"
    if index_path.exists():
        load_json(index_path, ".agent/sessions/index.json")

    spec_path = root / ".agent/spec.json"
    if openspec_enabled:
        if spec_path.exists():
            spec_config = load_json(spec_path, ".agent/spec.json")
            if spec_config.get("schema") != "agent-spec-v1":
                print("error: .agent/spec.json schema must be agent-spec-v1")
                return 1
            if spec_config.get("mode") != "embedded":
                print("error: .agent/spec.json mode must be embedded")
                return 1
            paths = spec_config.get("paths", {})
            for key in ("root", "changes", "archive", "specs", "project"):
                if key not in paths:
                    print(f"error: .agent/spec.json missing path: {key}")
                    return 1
        else:
            missing.append(".agent/spec.json")

    harness_path = root / ".agent/harness.json"
    if harness_path.exists():
        harness = load_json(harness_path, ".agent/harness.json")
        if harness.get("schema") != "agent-harness-v1":
            print("error: .agent/harness.json schema must be agent-harness-v1")
            return 1

    layout_path = root / ".agent/project-layout.json"
    if layout_path.exists():
        layout = load_json(layout_path, ".agent/project-layout.json")
        if layout.get("schema") != "agent-project-layout-v1":
            print("error: .agent/project-layout.json schema must be agent-project-layout-v1")
            return 1
        for directory in layout.get("directories", []):
            if not (root / directory).is_dir():
                missing.append(directory)

    workflow_path = root / ".agent/workflow.json"
    if workflow_path.exists():
        workflow = load_json(workflow_path, ".agent/workflow.json")
        if workflow.get("schema") != "agent-workflow-v1":
            print("error: .agent/workflow.json schema must be agent-workflow-v1")
            return 1
        gates = workflow.get("gates", {})
        for gate in (
            "risk_classification",
            "design_approval",
            "plan_quality",
            "implementation_discipline",
            "diff_traceability",
            "tdd",
            "systematic_debugging",
            "review_sequence",
            "human_review_evidence",
            "completion_verification",
        ):
            if gate not in gates:
                print(f"error: .agent/workflow.json missing gate: {gate}")
                return 1
        discipline = gates.get("implementation_discipline", {})
        for key in (
            "state_assumptions_when_ambiguous",
            "prefer_simple_direct_code",
            "avoid_speculative_features",
            "abstractions_require_repeated_complexity_or_existing_pattern",
            "touch_only_requested_scope",
            "every_changed_line_traces_to_request",
            "success_criteria_required",
        ):
            if key not in discipline:
                print(f"error: .agent/workflow.json implementation_discipline missing policy: {key}")
                return 1
        sequence = gates.get("review_sequence", {}).get("order", [])
        if sequence != ["spec_review", "quality_review"]:
            print("error: .agent/workflow.json review sequence must be spec_review then quality_review")
            return 1
        if not gates.get("risk_classification", {}).get("record_in_plan"):
            print("error: .agent/workflow.json risk classification must be recorded in plans")
            return 1
        if not gates.get("diff_traceability", {}).get("every_changed_line_traces_to_request"):
            print("error: .agent/workflow.json diff traceability gate must trace changed lines to request")
            return 1
        if not gates.get("human_review_evidence", {}).get("requires_diff_or_file_review"):
            print("error: .agent/workflow.json human review evidence must require diff or file review")
            return 1

    risk_path = root / ".agent/risk-zones.json"
    if risk_path.exists():
        risk = load_json(risk_path, ".agent/risk-zones.json")
        if risk.get("schema") != "agent-risk-zones-v1":
            print("error: .agent/risk-zones.json schema must be agent-risk-zones-v1")
            return 1
        levels = risk.get("autonomy_levels", {})
        for level in ("low", "medium", "high", "critical"):
            if level not in levels:
                print(f"error: .agent/risk-zones.json missing autonomy level: {level}")
                return 1
        if levels.get("high", {}).get("human_review_required") is not True:
            print("error: high risk changes must require human review")
            return 1
        if levels.get("critical", {}).get("agent_may_not_autonomously_modify") is not True:
            print("error: critical risk changes must block autonomous modification")
            return 1
        policy = risk.get("policy", {})
        for key in ("classify_before_implementation", "record_risk_in_plan_and_review", "stop_when_risk_increases"):
            if policy.get(key) is not True:
                print(f"error: .agent/risk-zones.json policy must enable {key}")
                return 1

    review_policy_path = root / ".agent/review-policy.json"
    if review_policy_path.exists():
        review_policy = load_json(review_policy_path, ".agent/review-policy.json")
        if review_policy.get("schema") != "agent-review-policy-v1":
            print("error: .agent/review-policy.json schema must be agent-review-policy-v1")
            return 1
        trace = review_policy.get("diff_traceability", {})
        categories = trace.get("categories", [])
        for category in ("requested", "necessary-support", "incidental", "risky"):
            if category not in categories:
                print(f"error: .agent/review-policy.json missing diff category: {category}")
                return 1
        if trace.get("every_changed_line_traces_to_request") is not True:
            print("error: .agent/review-policy.json must require changed-line traceability")
            return 1
        human = review_policy.get("human_review", {})
        for field in ("reviewer", "review_type", "diff_range", "files_reviewed", "conclusion"):
            if field not in human.get("evidence_fields", []):
                print(f"error: .agent/review-policy.json missing human review evidence field: {field}")
                return 1
        if "high" not in human.get("required_for_risk", []) or "critical" not in human.get("required_for_risk", []):
            print("error: .agent/review-policy.json must require human review for high and critical risk")
            return 1

    worktrees_path = root / ".agent/worktrees.json"
    if worktrees_path.exists():
        worktrees = load_json(worktrees_path, ".agent/worktrees.json")
        if worktrees.get("schema") != "agent-worktree-policy-v1":
            print("error: .agent/worktrees.json schema must be agent-worktree-policy-v1")
            return 1
        policy = worktrees.get("policy", {})
        for key in ("verify_project_local_dir_is_git_ignored", "run_baseline_validation_before_feature_edits", "discard_requires_typed_confirmation"):
            if key not in policy:
                print(f"error: .agent/worktrees.json missing policy: {key}")
                return 1

    subagents_path = root / ".agent/subagents.json"
    if subagents_path.exists():
        subagents = load_json(subagents_path, ".agent/subagents.json")
        if subagents.get("schema") != "agent-subagent-orchestration-v1":
            print("error: .agent/subagents.json schema must be agent-subagent-orchestration-v1")
            return 1
        roles = subagents.get("roles", {})
        for role in ("searcher", "explorer", "worker", "verifier", "spec_reviewer", "quality_reviewer", "reviewer"):
            if role not in roles:
                print(f"error: .agent/subagents.json missing role: {role}")
                return 1
        snapshot = subagents.get("snapshot_contract", {})
        if snapshot.get("marker") != "===SNAPSHOT===":
            print("error: .agent/subagents.json snapshot marker must be ===SNAPSHOT===")
            return 1
        if snapshot.get("status_values") != ["DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED"]:
            print("error: .agent/subagents.json snapshot status values are out of date")
            return 1
        if snapshot.get("risk_values") != ["low", "medium", "high", "critical"]:
            print("error: .agent/subagents.json snapshot risk values are out of date")
            return 1
        workflow = subagents.get("review_workflow", {})
        if workflow.get("review_sequence") != ["spec_reviewer", "quality_reviewer"]:
            print("error: .agent/subagents.json review sequence must be spec_reviewer then quality_reviewer")
            return 1

    hooks_path = root / ".agent/hooks.json"
    if hooks_path.exists():
        hooks = load_json(hooks_path, ".agent/hooks.json")
        if hooks.get("schema") != "agent-hooks-v1":
            print("error: .agent/hooks.json schema must be agent-hooks-v1")
            return 1

    knowledge_path = root / ".agent/knowledge.json"
    if knowledge_path.exists():
        knowledge = load_json(knowledge_path, ".agent/knowledge.json")
        if knowledge.get("schema") != "agent-knowledge-v1":
            print("error: .agent/knowledge.json schema must be agent-knowledge-v1")
            return 1

    memory_path = root / ".agent/memory.json"
    if memory_path.exists():
        memory = load_json(memory_path, ".agent/memory.json")
        if memory.get("schema") != "agent-memory-v1":
            print("error: .agent/memory.json schema must be agent-memory-v1")
            return 1
        stores = memory.get("stores", {})
        for key in ("events_jsonl", "sqlite_index", "summary_dir", "latest_digest"):
            if key not in stores:
                print(f"error: .agent/memory.json missing store: {key}")
                return 1
        taxonomy = memory.get("taxonomy", {})
        for key in ("episodic", "semantic", "procedural"):
            if key not in taxonomy:
                print(f"error: .agent/memory.json taxonomy missing {key}")
                return 1

    context_path = root / ".agent/context.json"
    if context_path.exists():
        context = load_json(context_path, ".agent/context.json")
        if context.get("schema") != "agent-context-budget-v1":
            print("error: .agent/context.json schema must be agent-context-budget-v1")
            return 1
        stores = context.get("stores", {})
        for key in ("stats_jsonl", "latest_digest"):
            if key not in stores:
                print(f"error: .agent/context.json missing store: {key}")
                return 1
        budgets = context.get("budgets", {})
        for key in ("max_total_tracked_tokens", "max_single_doc_tokens", "max_subagent_result_tokens"):
            if key not in budgets:
                print(f"error: .agent/context.json missing budget: {key}")
                return 1

    distribution_path = root / ".agent/skill-distribution.json"
    if distribution_path.exists():
        distribution = load_json(distribution_path, ".agent/skill-distribution.json")
        if distribution.get("schema") != "agent-skill-distribution-v1":
            print("error: .agent/skill-distribution.json schema must be agent-skill-distribution-v1")
            return 1

    capabilities_path = root / ".agent/capabilities.json"
    if capabilities_path.exists():
        capability_config = load_json(capabilities_path, ".agent/capabilities.json")
        if capability_config.get("schema") != "agent-capabilities-v1":
            print("error: .agent/capabilities.json schema must be agent-capabilities-v1")
            return 1
        capability_classes = capability_config.get("capability_classes", {})
        for class_name in ("instruction", "executable", "integration", "native_adapter"):
            if class_name not in capability_classes:
                print(f"error: .agent/capabilities.json missing capability class: {class_name}")
                return 1
        seen: set[str] = set()
        for item in capability_config.get("capabilities", []):
            cap_id = item.get("id")
            if not cap_id:
                print("error: capability entry missing id")
                return 1
            if cap_id in seen:
                print(f"error: duplicate capability id: {cap_id}")
                return 1
            seen.add(cap_id)
            if item.get("capability_class") not in capability_classes:
                print(f"error: capability {cap_id} has invalid capability_class")
                return 1
            if item.get("risk") not in capability_config.get("risk_values", ["low", "medium", "high"]):
                print(f"error: capability {cap_id} has invalid risk")
                return 1
        if not seen:
            print("error: .agent/capabilities.json has no capabilities")
            return 1

    tooling_path = root / ".agent/tooling.json"
    if tooling_path.exists():
        tooling = load_json(tooling_path, ".agent/tooling.json")
        if tooling.get("schema") != "agent-tooling-v1":
            print("error: .agent/tooling.json schema must be agent-tooling-v1")
            return 1
        limits = tooling.get("limits", {})
        for key in ("max_read_lines", "max_search_matches", "max_file_list"):
            if key not in limits:
                print(f"error: .agent/tooling.json missing limit: {key}")
                return 1

    security_path = root / ".agent/security.json"
    if security_path.exists():
        security = load_json(security_path, ".agent/security.json")
        if security.get("schema") != "agent-security-v1":
            print("error: .agent/security.json schema must be agent-security-v1")
            return 1
        suites = security.get("suites", {})
        for key in ("policy_as_code", "secret_scan", "dependency_audit", "sbom", "license_scan"):
            if key not in suites:
                print(f"error: .agent/security.json missing suite: {key}")
                return 1
            if not isinstance(suites[key], list):
                print(f"error: .agent/security.json suite must be a list: {key}")
                return 1

    evals_path = root / ".agent/evals.json"
    if evals_path.exists():
        evals = load_json(evals_path, ".agent/evals.json")
        if evals.get("schema") != "agent-evals-v1":
            print("error: .agent/evals.json schema must be agent-evals-v1")
            return 1
        dimensions = evals.get("dimensions", {})
        for key in (
            "project_integrity",
            "required_paths",
            "validation",
            "implementation_discipline",
            "risk_governance",
            "review_policy",
            "context_budget",
            "session_continuity",
            "memory",
            "capabilities",
            "security",
            "knowledge",
            "runlog",
        ):
            if key not in dimensions:
                print(f"error: .agent/evals.json missing dimension: {key}")
                return 1

    runlog_path = root / ".agent/runlog.jsonl"
    if runlog_path.exists():
        for item in load_jsonl(runlog_path, ".agent/runlog.jsonl"):
            if item.get("schema") != "agent-runlog-event-v1":
                print("error: .agent/runlog.jsonl entries must use schema agent-runlog-event-v1")
                return 1

    codex_config_path = root / ".codex/config.toml"
    if codex_config_path.exists() and tomllib is not None:
        try:
            tomllib.loads(codex_config_path.read_text(encoding="utf-8"))
        except tomllib.TOMLDecodeError as exc:
            print(f"error: .codex/config.toml is invalid TOML: {exc}")
            return 1
    elif codex_config_path.exists():
        print("warning: Python tomllib unavailable; skipped .codex/config.toml parse")

    codex_hooks_path = root / ".codex/hooks.json"
    if codex_hooks_path.exists():
        load_json(codex_hooks_path, ".codex/hooks.json")

    if claude_enabled:
        claude_settings_path = root / ".claude/settings.json"
        if claude_settings_path.exists():
            load_json(claude_settings_path, ".claude/settings.json")

    if missing:
        print("agent project check failed")
        for path in missing:
            print(f"missing: {path}")
        return 1

    print("agent project check passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
