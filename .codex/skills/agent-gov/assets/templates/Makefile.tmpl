.PHONY: agent-check
.PHONY: agent-validate
.PHONY: agent-sync-skills
.PHONY: agent-memory
.PHONY: agent-context
.PHONY: agent-capabilities
.PHONY: agent-runlog
.PHONY: agent-tooling
.PHONY: agent-security
.PHONY: agent-score

agent-check:
	python3 scripts/agent_check.py
	python3 scripts/agent_knowledge.py
	python3 scripts/agent_invariants.py
	python3 scripts/agent_capabilities.py doctor
	python3 scripts/agent_runlog.py doctor
	python3 scripts/agent_tooling.py doctor
	python3 scripts/agent_security.py doctor
	python3 scripts/agent_score.py doctor
	python3 .agent/tools/agent_memory.py doctor
	python3 .agent/tools/agent_context.py doctor
	python3 .agent/tools/agent_session.py status

agent-validate:
	python3 scripts/agent_validate.py

agent-sync-skills:
	python3 scripts/agent_sync_skills.py

agent-memory:
	python3 .agent/tools/agent_memory.py timeline --limit 10

agent-context:
	python3 .agent/tools/agent_context.py scan --limit 10

agent-capabilities:
	python3 scripts/agent_capabilities.py list --enabled

agent-runlog:
	python3 scripts/agent_runlog.py tail --limit 10

agent-tooling:
	python3 scripts/agent_tooling.py doctor

agent-security:
	python3 scripts/agent_security.py list
	python3 scripts/agent_security.py scan-paths

agent-score:
	python3 scripts/agent_score.py score --write
