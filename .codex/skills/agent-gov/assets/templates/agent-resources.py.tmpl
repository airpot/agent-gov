#!/usr/bin/env python3
"""Manage the agent-gov project resource catalog."""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import uuid
from datetime import date, datetime, timezone
from pathlib import Path
from typing import Any


CONFIG_PATH = Path(".agent/resources.json")
RUNLOG_PATH = Path(".agent/runlog.jsonl")
ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{1,80}$")
REF_RE = re.compile(r"^(env|file-ref|vault|proxy|op|keychain):[A-Za-z0-9_./:@~+-]+$")
SECRET_KEY_RE = re.compile(r"(?i)(password|passwd|secret|token|apikey|api_key|private[_-]?key|credential)")
SECRET_VALUE_RE = re.compile(
    r"(?is)("
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|ssh-rsa\s+[A-Za-z0-9+/=]{40,}"
    r"|ssh-ed25519\s+[A-Za-z0-9+/=]{40,}"
    r"|[A-Za-z0-9_]{0,20}(token|secret|password|passwd|apikey|api_key)[A-Za-z0-9_]{0,20}\s*[:=]\s*\S+"
    r"|://[^\s/:]+:[^\s/@]+@"
    r")"
)
SHELL_METACHAR_RE = re.compile(r"[;&|<>`$()]")
ENV_PLACEHOLDER_RE = re.compile(r"^\$[A-Za-z_][A-Za-z0-9_]*$")
HEALTHCHECK_FORBIDDEN_WORD_RE = re.compile(
    r"(?i)\b("
    r"rm|rmdir|shred|mkfs|dd|truncate|chmod|chown|chgrp|sudo|su|"
    r"delete|destroy|drop|shutdown|reboot|kill|"
    r"push|commit|checkout|reset|clean|apply|set-url|"
    r"insert|update|alter|create|grant|revoke"
    r")\b"
)
SHELL_EXECUTABLES = {"sh", "bash", "zsh", "fish", "cmd", "powershell", "pwsh"}
HEALTHCHECK_ALLOWED_EXECUTABLES = {"curl", "git", "nc", "pg_isready", "ping", "redis-cli", "test"}
HEALTHCHECK_FORBIDDEN_EXECUTABLES = {
    "awk",
    "bun",
    "deno",
    "env",
    "lua",
    "make",
    "node",
    "npx",
    "npm",
    "perl",
    "php",
    "psql",
    "python",
    "python2",
    "python3",
    "ruby",
    "uv",
}
DEFAULT_HEALTHCHECK_TIMEOUT_SECONDS = 30
MAX_HEALTHCHECK_TIMEOUT_SECONDS = 120
TOKEN_RE = re.compile(r"[a-z0-9]+")
RISK_ORDER = {"low": 0, "medium": 1, "high": 2, "critical": 3}


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_config(path: Path = CONFIG_PATH) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        print(f"error: missing {path}", file=sys.stderr)
        raise SystemExit(1)
    except json.JSONDecodeError as exc:
        print(f"error: invalid JSON in {path}: {exc}", file=sys.stderr)
        raise SystemExit(1)


def resources(config: dict[str, Any]) -> list[dict[str, Any]]:
    rows = config.get("resources", [])
    return [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []


def resource_by_id(config: dict[str, Any], resource_id: str) -> dict[str, Any] | None:
    return next((row for row in resources(config) if row.get("id") == resource_id), None)


def json_print(payload: Any) -> None:
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def is_ref(value: str) -> bool:
    return bool(REF_RE.match(value))


def command_to_argv(command: Any) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    if isinstance(command, list):
        argv = [str(part) for part in command]
        if not argv or any(not part.strip() for part in argv):
            return [], ["command argv must be a non-empty list of non-empty strings"]
        return argv, errors
    if not isinstance(command, str) or not command.strip():
        return [], ["command must be a non-empty string or argv list"]
    if SHELL_METACHAR_RE.search(command):
        errors.append("command contains shell metacharacters")
    try:
        argv = shlex.split(command)
    except ValueError as exc:
        return [], errors + [f"command is not valid shell-like argv syntax: {exc}"]
    if not argv:
        errors.append("command must contain at least one executable")
    return argv, errors


def positive_int(value: str, label: str, max_value: int | None = None) -> str | None:
    try:
        parsed = int(value)
    except ValueError:
        return f"{label} must be an integer"
    if parsed <= 0:
        return f"{label} must be greater than zero"
    if max_value is not None and parsed > max_value:
        return f"{label} must be <= {max_value}"
    return None


def validate_git_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    if len(argv) < 2:
        return ["git health checks must specify a read-only subcommand"]
    subcommand = argv[1]
    if subcommand == "status":
        allowed = {
            "--short",
            "-s",
            "--porcelain",
            "--porcelain=v1",
            "--porcelain=v2",
            "--branch",
            "-b",
            "--untracked-files=no",
            "--untracked-files=normal",
            "--untracked-files=all",
            "-uno",
            "-unormal",
            "-uall",
        }
        for arg in argv[2:]:
            if arg not in allowed:
                errors.append(f"git status option is not allowlisted: {arg}")
    elif subcommand == "ls-remote":
        allowed_options = {"--heads", "--tags", "--refs", "--quiet", "-q", "--exit-code"}
        targets = []
        for arg in argv[2:]:
            if arg.startswith("-"):
                if arg not in allowed_options:
                    errors.append(f"git ls-remote option is not allowlisted: {arg}")
            else:
                targets.append(arg)
        if not targets:
            errors.append("git ls-remote must include a remote or URL")
        if len(targets) > 4:
            errors.append("git ls-remote health checks must use a small target/ref set")
    elif subcommand == "rev-parse":
        allowed_options = {"--is-inside-work-tree", "--show-toplevel", "--abbrev-ref", "--verify", "--short"}
        for arg in argv[2:]:
            if arg.startswith("-") and arg not in allowed_options:
                errors.append(f"git rev-parse option is not allowlisted: {arg}")
    elif subcommand == "show-ref":
        allowed_options = {"--verify", "--quiet", "--heads", "--tags"}
        for arg in argv[2:]:
            if arg.startswith("-") and arg not in allowed_options:
                errors.append(f"git show-ref option is not allowlisted: {arg}")
    elif subcommand == "remote":
        tail = argv[2:]
        if tail != ["-v"] and not (len(tail) == 2 and tail[0] == "get-url" and not tail[1].startswith("-")):
            errors.append("git remote health checks may only use `git remote -v` or `git remote get-url <name>`")
    else:
        errors.append(f"git subcommand is not read-only allowlisted: {subcommand}")
    return errors


def validate_curl_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    safe_flags = {"--fail", "-f", "--fail-with-body", "--silent", "-s", "--show-error", "-S", "--head", "-I", "--location", "-L", "--ipv4", "-4", "--ipv6", "-6"}
    value_options = {"--url", "--connect-timeout", "--max-time", "--retry", "--retry-delay", "--retry-max-time", "--user-agent", "-A"}
    numeric_options = {"--connect-timeout", "--max-time", "--retry", "--retry-delay", "--retry-max-time"}
    blocked_prefixes = (
        "-d",
        "--data",
        "-F",
        "--form",
        "-T",
        "--upload-file",
        "-H",
        "--header",
        "-u",
        "--user",
        "--oauth2-bearer",
        "-o",
        "--output",
        "-O",
        "--remote-name",
        "-K",
        "--config",
        "--cookie",
        "--cookie-jar",
        "--proxy",
        "--proxy-user",
        "--request-target",
        "--next",
    )
    urls: list[str] = []
    method = "GET"
    explicit_methods: list[str] = []
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            errors.append("curl health checks must not use `--` argument passthrough")
            break
        if arg in {"-X", "--request"}:
            if index + 1 >= len(argv):
                errors.append(f"{arg} requires a method")
                break
            method = argv[index + 1].upper()
            explicit_methods.append(method)
            index += 2
            continue
        if arg.startswith("-X") and len(arg) > 2:
            method = arg[2:].upper()
            explicit_methods.append(method)
            index += 1
            continue
        if arg.startswith("--request="):
            method = arg.split("=", 1)[1].upper()
            explicit_methods.append(method)
            index += 1
            continue
        if arg in blocked_prefixes or any(arg.startswith(prefix + "=") for prefix in blocked_prefixes if prefix.startswith("--")):
            errors.append(f"curl option is not allowed for read-only health checks: {arg}")
            index += 1
            continue
        if any(arg.startswith(prefix) and prefix.startswith("-") and not prefix.startswith("--") and len(arg) > len(prefix) for prefix in blocked_prefixes):
            errors.append(f"curl option is not allowed for read-only health checks: {arg}")
            index += 1
            continue
        if arg in safe_flags:
            if arg in {"--head", "-I"}:
                method = "HEAD"
            index += 1
            continue
        if arg in value_options:
            if index + 1 >= len(argv):
                errors.append(f"{arg} requires a value")
                break
            value = argv[index + 1]
            if arg == "--url":
                urls.append(value)
            if arg in numeric_options:
                issue = positive_int(value, arg, 120)
                if issue:
                    errors.append(issue)
            index += 2
            continue
        matched_value_option = False
        for option in value_options:
            prefix = option + "="
            if option.startswith("--") and arg.startswith(prefix):
                value = arg.split("=", 1)[1]
                if option == "--url":
                    urls.append(value)
                if option in numeric_options:
                    issue = positive_int(value, option, 120)
                    if issue:
                        errors.append(issue)
                matched_value_option = True
                break
        if matched_value_option:
            index += 1
            continue
        if arg.startswith("-"):
            errors.append(f"curl option is not allowlisted: {arg}")
        else:
            urls.append(arg)
        index += 1
    for explicit_method in explicit_methods:
        if explicit_method not in {"GET", "HEAD"}:
            errors.append(f"curl method is not read-only allowlisted: {explicit_method}")
    if not explicit_methods and method not in {"GET", "HEAD"}:
        errors.append(f"curl method is not read-only allowlisted: {method}")
    if not urls:
        errors.append("curl health checks must include an http(s) URL")
    for url in urls:
        if not re.match(r"^https?://", url):
            errors.append(f"curl healthcheck target must be an http(s) URL: {url}")
    return errors


def validate_nc_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    targets: list[str] = []
    seen_zero_io = False
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            errors.append("nc health checks must not use `--` argument passthrough")
            break
        if arg in {"-w", "-G"}:
            if index + 1 >= len(argv):
                errors.append(f"{arg} requires a timeout value")
                break
            issue = positive_int(argv[index + 1], arg, 30)
            if issue:
                errors.append(issue)
            index += 2
            continue
        if arg.startswith("-w") and len(arg) > 2:
            issue = positive_int(arg[2:], "-w", 30)
            if issue:
                errors.append(issue)
            index += 1
            continue
        if arg.startswith("-"):
            flags = arg[1:]
            if not flags or any(flag not in {"z", "v", "n"} for flag in flags):
                errors.append(f"nc option is not allowlisted: {arg}")
            if "z" in flags:
                seen_zero_io = True
            index += 1
            continue
        targets.append(arg)
        index += 1
    if not seen_zero_io:
        errors.append("nc health checks must use zero-I/O port scanning mode (-z)")
    if len(targets) != 2:
        errors.append("nc health checks must include exactly host and port targets")
    elif positive_int(targets[1], "nc port", 65535):
        errors.append(positive_int(targets[1], "nc port", 65535) or "")
    return errors


def validate_ping_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    targets: list[str] = []
    count_seen = False
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg in {"-c", "-W", "-w"}:
            if index + 1 >= len(argv):
                errors.append(f"{arg} requires a value")
                break
            maximum = 5 if arg == "-c" else 30
            issue = positive_int(argv[index + 1], arg, maximum)
            if issue:
                errors.append(issue)
            if arg == "-c":
                count_seen = True
            index += 2
            continue
        if arg.startswith("-c") and len(arg) > 2:
            issue = positive_int(arg[2:], "-c", 5)
            if issue:
                errors.append(issue)
            count_seen = True
            index += 1
            continue
        if arg in {"-n", "-q", "-4", "-6"}:
            index += 1
            continue
        if arg.startswith("-"):
            errors.append(f"ping option is not allowlisted: {arg}")
        else:
            targets.append(arg)
        index += 1
    if not count_seen:
        errors.append("ping health checks must set a bounded packet count with -c")
    if len(targets) != 1:
        errors.append("ping health checks must include exactly one target")
    return errors


def validate_pg_isready_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    value_options = {"-h", "-p", "-U", "-d", "-t", "--host", "--port", "--username", "--dbname", "--timeout"}
    safe_flags = {"-q", "--quiet"}
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg in safe_flags:
            index += 1
            continue
        if arg in value_options:
            if index + 1 >= len(argv):
                errors.append(f"{arg} requires a value")
                break
            if arg in {"-p", "-t", "--port", "--timeout"}:
                issue = positive_int(argv[index + 1], arg, 65535 if arg in {"-p", "--port"} else 120)
                if issue:
                    errors.append(issue)
            index += 2
            continue
        matched = False
        for option in {"--host", "--port", "--username", "--dbname", "--timeout"}:
            if arg.startswith(option + "="):
                if option in {"--port", "--timeout"}:
                    issue = positive_int(arg.split("=", 1)[1], option, 65535 if option == "--port" else 120)
                    if issue:
                        errors.append(issue)
                matched = True
                break
        if matched:
            index += 1
            continue
        errors.append(f"pg_isready option is not allowlisted: {arg}")
        index += 1
    return errors


def validate_redis_cli_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    value_options = {"-h", "-p", "-n", "--host", "--port", "--user", "--db"}
    safe_flags = {"--tls", "--no-auth-warning", "--raw", "--no-raw"}
    blocked_options = {"-a", "-u", "--pass", "--askpass", "--pipe", "--eval", "--scan", "--rdb", "--cluster"}
    command_args: list[str] = []
    index = 1
    while index < len(argv):
        arg = argv[index]
        if command_args:
            command_args.append(arg)
            index += 1
            continue
        if arg in blocked_options or any(arg.startswith(option + "=") for option in blocked_options if option.startswith("--")):
            errors.append(f"redis-cli option is not allowed for health checks: {arg}")
            index += 1
            continue
        if arg in safe_flags:
            index += 1
            continue
        if arg in value_options:
            if index + 1 >= len(argv):
                errors.append(f"{arg} requires a value")
                break
            if arg in {"-p", "-n", "--port", "--db"}:
                issue = positive_int(argv[index + 1], arg, 65535 if arg in {"-p", "--port"} else 16)
                if issue:
                    errors.append(issue)
            index += 2
            continue
        matched = False
        for option in {"--host", "--port", "--user", "--db"}:
            if arg.startswith(option + "="):
                if option in {"--port", "--db"}:
                    issue = positive_int(arg.split("=", 1)[1], option, 65535 if option == "--port" else 16)
                    if issue:
                        errors.append(issue)
                matched = True
                break
        if matched:
            index += 1
            continue
        if arg.startswith("-"):
            errors.append(f"redis-cli option is not allowlisted: {arg}")
        else:
            command_args.append(arg)
        index += 1
    if [part.upper() for part in command_args] != ["PING"]:
        errors.append("redis-cli health checks may only run PING")
    return errors


def validate_test_healthcheck(argv: list[str]) -> list[str]:
    errors: list[str] = []
    args = argv[1:]
    unary_ops = {"-e", "-f", "-d", "-r", "-s", "-x"}
    if len(args) == 2 and args[0] in unary_ops:
        return []
    if len(args) == 3 and args[0] == "!" and args[1] in unary_ops:
        return []
    if len(args) == 3 and args[1] in {"=", "!="}:
        return []
    errors.append("test health checks must use a simple read-only unary file check or string comparison")
    return errors


def validate_healthcheck_argument_policy(executable: str, argv: list[str]) -> list[str]:
    validators = {
        "curl": validate_curl_healthcheck,
        "git": validate_git_healthcheck,
        "nc": validate_nc_healthcheck,
        "pg_isready": validate_pg_isready_healthcheck,
        "ping": validate_ping_healthcheck,
        "redis-cli": validate_redis_cli_healthcheck,
        "test": validate_test_healthcheck,
    }
    validator = validators.get(executable)
    return validator(argv) if validator else [f"no argument policy registered for {executable}"]


def validate_healthcheck_command(command: Any) -> list[str]:
    argv, errors = command_to_argv(command)
    if errors:
        return errors
    executable = Path(argv[0]).name.lower()
    if executable in SHELL_EXECUTABLES:
        errors.append("shell executables are not allowed in health checks")
    if executable in HEALTHCHECK_FORBIDDEN_EXECUTABLES:
        errors.append("unsafe executables are not allowed in health checks")
    if executable not in HEALTHCHECK_ALLOWED_EXECUTABLES:
        errors.append(f"health check executable is not allowlisted: {executable}")
    if executable in HEALTHCHECK_ALLOWED_EXECUTABLES:
        for error in validate_healthcheck_argument_policy(executable, argv):
            errors.append(f"health check command violates read-only argument policy: {error}")
    command_text = " ".join(argv).lower()
    if HEALTHCHECK_FORBIDDEN_WORD_RE.search(command_text):
        errors.append("health check command contains destructive or mutating words")
    return errors


def validate_healthcheck_timeout(value: Any) -> tuple[int, str | None]:
    if value in {None, ""}:
        return DEFAULT_HEALTHCHECK_TIMEOUT_SECONDS, None
    if isinstance(value, bool):
        return DEFAULT_HEALTHCHECK_TIMEOUT_SECONDS, "timeout_seconds must be an integer"
    try:
        timeout = int(value)
    except (TypeError, ValueError):
        return DEFAULT_HEALTHCHECK_TIMEOUT_SECONDS, "timeout_seconds must be an integer"
    if timeout <= 0:
        return timeout, "timeout_seconds must be greater than zero"
    if timeout > MAX_HEALTHCHECK_TIMEOUT_SECONDS:
        return timeout, f"timeout_seconds must be <= {MAX_HEALTHCHECK_TIMEOUT_SECONDS}"
    return timeout, None


def command_to_display(command: Any) -> str:
    argv, _ = command_to_argv(command)
    if argv:
        return shlex.join(argv)
    return str(command)


def suspicious_string(key: str, value: str) -> str | None:
    stripped = value.strip()
    if not stripped:
        return None
    if key == "secret_material" and stripped in {"not-required", "external-ref", "local-template"}:
        return None
    if is_ref(stripped):
        return None
    if ENV_PLACEHOLDER_RE.match(stripped) or (stripped.startswith("<") and stripped.endswith(">")):
        return None
    if SECRET_VALUE_RE.search(stripped):
        return "secret-looking inline value"
    if SECRET_KEY_RE.search(key) and not is_ref(stripped):
        return "secret-looking field should use a reference"
    return None


def scan_secret_values(value: Any, path: str = "") -> list[str]:
    findings: list[str] = []
    if isinstance(value, dict):
        for key, item in value.items():
            child_path = f"{path}.{key}" if path else str(key)
            findings.extend(scan_secret_values(item, child_path))
    elif isinstance(value, list):
        for index, item in enumerate(value):
            findings.extend(scan_secret_values(item, f"{path}[{index}]"))
    elif isinstance(value, str):
        key = path.rsplit(".", 1)[-1]
        issue = suspicious_string(key, value)
        if issue:
            findings.append(f"{path}: {issue}")
    return findings


def parse_date(value: str) -> date | None:
    if not value:
        return None
    try:
        return date.fromisoformat(value)
    except ValueError:
        return None


def validate_resource(item: dict[str, Any], config: dict[str, Any], seen: set[str]) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    resource_id = str(item.get("id", "")).strip()
    label = resource_id or "<missing-id>"
    required = {
        "id",
        "type",
        "environment",
        "owner",
        "risk",
        "lifecycle",
        "description",
        "when_to_use",
        "do_not_use_for",
        "endpoint",
        "access",
        "allowed_actions",
        "last_verified",
    }
    missing = sorted(required - set(item))
    if missing:
        errors.append(f"{label} missing fields: {', '.join(missing)}")
    if not resource_id or not ID_RE.match(resource_id):
        errors.append(f"{label} has invalid id")
    elif resource_id in seen:
        errors.append(f"duplicate resource id: {resource_id}")
    seen.add(resource_id)

    if item.get("type") not in config.get("resource_types", {}):
        errors.append(f"{label} has invalid type: {item.get('type')}")
    if item.get("risk") not in config.get("risk_values", []):
        errors.append(f"{label} has invalid risk: {item.get('risk')}")
    if item.get("lifecycle") not in config.get("lifecycle_values", []):
        errors.append(f"{label} has invalid lifecycle: {item.get('lifecycle')}")
    if not str(item.get("owner", "")).strip():
        errors.append(f"{label} missing owner")
    for list_field in ("when_to_use", "do_not_use_for"):
        values = item.get(list_field)
        if not isinstance(values, list) or not any(str(v).strip() for v in values):
            errors.append(f"{label} {list_field} must be a non-empty list")
    endpoint = item.get("endpoint")
    if not isinstance(endpoint, dict):
        errors.append(f"{label} endpoint must be an object")
    else:
        if not any(key in endpoint for key in ("path", "host", "host_ref", "url", "url_ref", "repository", "remote_ref")):
            errors.append(f"{label} endpoint must include a path, host/url, or reference")
        for key in ("host_ref", "url_ref", "port_ref", "remote_ref"):
            value = endpoint.get(key)
            if value and not is_ref(str(value)):
                errors.append(f"{label} endpoint.{key} must use a supported reference prefix")
    access = item.get("access")
    if not isinstance(access, dict):
        errors.append(f"{label} access must be an object")
    else:
        methods = access.get("methods")
        if not isinstance(methods, list) or not methods:
            errors.append(f"{label} access.methods must be a non-empty list")
        refs = access.get("credential_refs", [])
        if not isinstance(refs, list):
            errors.append(f"{label} access.credential_refs must be a list")
        else:
            for ref in refs:
                if not is_ref(str(ref)):
                    errors.append(f"{label} credential ref must use a supported prefix: {ref}")
        if access.get("secret_material") not in {"not-required", "external-ref", "local-template"}:
            errors.append(f"{label} access.secret_material has invalid value")
    allowed = item.get("allowed_actions")
    if not isinstance(allowed, dict):
        errors.append(f"{label} allowed_actions must be an object")
    else:
        policies = set(config.get("action_policies", []))
        for action in ("read", "write", "destructive"):
            if allowed.get(action) not in policies:
                errors.append(f"{label} allowed_actions.{action} has invalid policy: {allowed.get(action)}")
    checks = item.get("health_checks", [])
    if not isinstance(checks, list):
        errors.append(f"{label} health_checks must be a list")
    else:
        for check in checks:
            if not isinstance(check, dict):
                errors.append(f"{label} health check must be an object")
                continue
            if not check.get("id") or "command" not in check:
                errors.append(f"{label} health check missing id or command")
            else:
                command_errors = validate_healthcheck_command(check.get("command"))
                for error in command_errors:
                    errors.append(f"{label} health check {check.get('id')}: {error}")
                _, timeout_error = validate_healthcheck_timeout(check.get("timeout_seconds"))
                if timeout_error:
                    errors.append(f"{label} health check {check.get('id')}: {timeout_error}")
            if check.get("risk", "low") not in config.get("risk_values", []):
                errors.append(f"{label} health check {check.get('id')} has invalid risk")

    lifecycle = item.get("lifecycle")
    verified = parse_date(str(item.get("last_verified", "")))
    if lifecycle == "active" and verified is None:
        warnings.append(f"{label} active resource missing valid last_verified date")
    if verified is not None:
        stale_after = int(config.get("policy", {}).get("stale_after_days", 90))
        age = (datetime.now(timezone.utc).date() - verified).days
        if age > stale_after:
            warnings.append(f"{label} last_verified is stale: {age} days")
    for finding in scan_secret_values(item):
        errors.append(f"{label} {finding}")
    return errors, warnings


def validate_config(config: dict[str, Any]) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    if config.get("schema") != "agent-resource-catalog-v1":
        errors.append(".agent/resources.json schema must be agent-resource-catalog-v1")
    policy = config.get("policy", {})
    for key in ("repo_local_catalog", "raw_secret_values_forbidden", "match_requires_resolve_before_use"):
        if policy.get(key) is not True:
            errors.append(f".agent/resources.json policy must enable {key}")
    template = str(policy.get("local_secret_material_template", "")).strip()
    if template and not Path(template).exists():
        errors.append(f"local secret-material template is missing: {template}")
    if policy.get("local_secret_material_is_git_ignored") is not True:
        warnings.append("local secret-material path should be ignored by git")
    else:
        local_secret_path = str(policy.get("local_secret_material_path", "")).strip()
        if local_secret_path:
            result = subprocess.run(["git", "check-ignore", "--quiet", local_secret_path], text=True, capture_output=True, check=False)
            if result.returncode == 1:
                errors.append(f"local secret-material path is not git-ignored: {local_secret_path}")
            elif result.returncode not in {0, 1}:
                warnings.append(f"could not verify git ignore status for {local_secret_path}")
    seen: set[str] = set()
    rows = resources(config)
    if not rows:
        warnings.append(".agent/resources.json has no resources")
    for item in rows:
        item_errors, item_warnings = validate_resource(item, config, seen)
        errors.extend(item_errors)
        warnings.extend(item_warnings)
    return errors, warnings


def cmd_doctor(args: argparse.Namespace) -> int:
    config = load_config()
    errors, warnings = validate_config(config)
    for warning in warnings:
        print(f"warning: {warning}")
    for error in errors:
        print(f"error: {error}")
    if errors:
        return 1
    print("agent resource catalog doctor passed")
    return 0


def filtered_resources(config: dict[str, Any], args: argparse.Namespace) -> list[dict[str, Any]]:
    rows = resources(config)
    if getattr(args, "type", None):
        rows = [row for row in rows if row.get("type") == args.type]
    if getattr(args, "env", None):
        rows = [row for row in rows if row.get("environment") == args.env]
    if getattr(args, "enabled", False):
        rows = [row for row in rows if row.get("enabled", True) is True]
    return rows


def summarize_resource(item: dict[str, Any]) -> dict[str, Any]:
    return {
        "id": item.get("id"),
        "type": item.get("type"),
        "environment": item.get("environment"),
        "enabled": item.get("enabled", True),
        "risk": item.get("risk"),
        "lifecycle": item.get("lifecycle"),
        "owner": item.get("owner"),
        "description": item.get("description", ""),
    }


def cmd_list(args: argparse.Namespace) -> int:
    config = load_config()
    rows = filtered_resources(config, args)
    if args.json:
        json_print({"schema": "agent-resource-list-v1", "resources": [summarize_resource(row) for row in rows]})
        return 0
    for row in rows:
        enabled = "enabled" if row.get("enabled", True) else "disabled"
        print(f"{row.get('id')} | {row.get('type')} | {row.get('environment')} | {row.get('risk')} | {row.get('lifecycle')} | {enabled}")
        print(f"  {row.get('description', '')}")
    if not rows:
        print("no resources")
    return 0


def tokenize(value: Any) -> set[str]:
    text = " ".join(flatten_strings(value)).lower()
    return {token for token in TOKEN_RE.findall(text) if len(token) > 1}


def flatten_strings(value: Any) -> list[str]:
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        result: list[str] = []
        for item in value:
            result.extend(flatten_strings(item))
        return result
    if isinstance(value, dict):
        result = []
        for item in value.values():
            result.extend(flatten_strings(item))
        return result
    return []


def match_score(intent: str, item: dict[str, Any]) -> int:
    haystack_fields = {
        "id": item.get("id"),
        "type": item.get("type"),
        "environment": item.get("environment"),
        "aliases": item.get("aliases", []),
        "intent_tags": item.get("intent_tags", []),
        "description": item.get("description", ""),
        "when_to_use": item.get("when_to_use", []),
    }
    intent_tokens = tokenize(intent)
    haystack_tokens = tokenize(haystack_fields)
    score = len(intent_tokens & haystack_tokens)
    lowered = intent.lower()
    for field in (item.get("id", ""), item.get("type", ""), item.get("environment", "")):
        if str(field).lower() and str(field).lower() in lowered:
            score += 3
    for alias in item.get("aliases", []):
        if str(alias).lower() in lowered:
            score += 4
    for tag in item.get("intent_tags", []):
        tag_text = str(tag).replace("-", " ").lower()
        if tag_text in lowered:
            score += 5
    return score


def do_not_use_hits(intent: str, item: dict[str, Any]) -> list[str]:
    lowered = " ".join(intent.lower().split())
    intent_tokens = tokenize(intent)
    hits: list[str] = []
    for raw_rule in item.get("do_not_use_for", []):
        rule = str(raw_rule).strip()
        if not rule:
            continue
        normalized = " ".join(rule.lower().rstrip(".").split())
        if normalized and normalized in lowered:
            hits.append(rule)
            continue
        rule_tokens = tokenize(rule)
        if rule_tokens and rule_tokens <= intent_tokens:
            hits.append(rule)
    return hits


def approval_required(item: dict[str, Any]) -> bool:
    if item.get("risk") in {"high", "critical"}:
        return True
    if item.get("environment") in {"production", "prod", "release"}:
        return True
    allowed = item.get("allowed_actions", {})
    return any(value == "approval-required" for value in allowed.values())


def healthcheck_execution_requires_approval(item: dict[str, Any], selected_checks: list[dict[str, Any]]) -> bool:
    if item.get("risk") in {"high", "critical"}:
        return True
    if item.get("environment") in {"production", "prod", "release"}:
        return True
    allowed = item.get("allowed_actions", {})
    if allowed.get("read") == "approval-required":
        return True
    return any(str(check.get("risk", "low")) != "low" for check in selected_checks)


def cmd_match(args: argparse.Namespace) -> int:
    config = load_config()
    candidates = []
    excluded = []
    for item in resources(config):
        if not args.include_disabled and (item.get("enabled", True) is not True or item.get("lifecycle") in {"disabled", "retired"}):
            continue
        score = match_score(args.intent, item)
        if score <= 0:
            continue
        negative_hits = do_not_use_hits(args.intent, item)
        if negative_hits:
            excluded.append(
                {
                    "id": item.get("id"),
                    "reason": "intent matches do_not_use_for",
                    "do_not_use_for": negative_hits,
                }
            )
            continue
        candidates.append(
            {
                "id": item.get("id"),
                "score": score,
                "type": item.get("type"),
                "environment": item.get("environment"),
                "risk": item.get("risk"),
                "lifecycle": item.get("lifecycle"),
                "enabled": item.get("enabled", True),
                "approval_required": approval_required(item),
                "description": item.get("description", ""),
            }
        )
    candidates.sort(key=lambda row: (-int(row["score"]), RISK_ORDER.get(str(row["risk"]), 99), str(row["id"])))
    payload = {
        "schema": "agent-resource-match-v1",
        "intent": args.intent,
        "match_requires_resolve_before_use": config.get("policy", {}).get("match_requires_resolve_before_use", True),
        "candidates": candidates[: args.limit],
        "excluded": excluded,
    }
    if args.json:
        json_print(payload)
    else:
        for row in payload["candidates"]:
            print(f"{row['id']} | score={row['score']} | {row['type']} | {row['environment']} | {row['risk']} | approval={row['approval_required']}")
        for row in payload["excluded"]:
            print(f"excluded {row['id']}: {row['reason']}")
        if not payload["candidates"]:
            print("no matching resources")
    return 0


def scrub(value: Any) -> Any:
    if isinstance(value, dict):
        return {key: scrub(item) for key, item in value.items()}
    if isinstance(value, list):
        return [scrub(item) for item in value]
    if isinstance(value, str):
        if SECRET_VALUE_RE.search(value) and not is_ref(value):
            return "<redacted>"
    return value


def redact_output(text: str, limit: int = 4000) -> str:
    redacted = SECRET_VALUE_RE.sub("<redacted>", text)
    if len(redacted) > limit:
        return redacted[:limit] + "\n<truncated>"
    return redacted


def resolution_payload(config: dict[str, Any], item: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema": "agent-resource-resolution-v1",
        "id": item.get("id"),
        "type": item.get("type"),
        "environment": item.get("environment"),
        "enabled": item.get("enabled", True),
        "risk": item.get("risk"),
        "lifecycle": item.get("lifecycle"),
        "owner": item.get("owner"),
        "description": item.get("description", ""),
        "when_to_use": item.get("when_to_use", []),
        "do_not_use_for": item.get("do_not_use_for", []),
        "endpoint": scrub(item.get("endpoint", {})),
        "access": scrub(item.get("access", {})),
        "allowed_actions": item.get("allowed_actions", {}),
        "approval_required": approval_required(item),
        "health_checks": scrub(item.get("health_checks", [])),
        "last_verified": item.get("last_verified", ""),
        "secret_material_template": config.get("policy", {}).get("local_secret_material_template", ""),
        "local_secret_material_path": config.get("policy", {}).get("local_secret_material_path", ""),
        "notes": [
            "Resolve returns references and non-secret guidance only.",
            "Do not print or commit raw passwords, tokens, SSH private keys, or private credential values.",
        ],
    }


def cmd_resolve(args: argparse.Namespace) -> int:
    config = load_config()
    item = resource_by_id(config, args.resource_id)
    if not item:
        print(f"error: resource not found: {args.resource_id}", file=sys.stderr)
        return 2
    payload = resolution_payload(config, item)
    if args.json:
        json_print(payload)
    else:
        print(f"{payload['id']} | {payload['type']} | {payload['environment']} | risk={payload['risk']} | approval={payload['approval_required']}")
        print(payload["description"])
        print("endpoint:", json.dumps(payload["endpoint"], ensure_ascii=False))
        print("access:", json.dumps(payload["access"], ensure_ascii=False))
    return 0


def cmd_template(args: argparse.Namespace) -> int:
    config = load_config()
    template_path = Path(config.get("policy", {}).get("local_secret_material_template", ""))
    if not template_path.exists():
        print(f"error: missing template: {template_path}", file=sys.stderr)
        return 1
    text = template_path.read_text(encoding="utf-8")
    if args.print_template:
        print(text, end="" if text.endswith("\n") else "\n")
    if args.write:
        target = Path(args.write)
        if target.exists() and not args.force:
            print(f"error: target exists; use --force to overwrite: {target}", file=sys.stderr)
            return 1
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text, encoding="utf-8")
        print(f"wrote template: {target}")
    if not args.print_template and not args.write:
        print(template_path)
    return 0


def record_runlog(summary: str, outcome: str, command: str, resource_id: str, tags: list[str]) -> None:
    if not RUNLOG_PATH.parent.exists():
        return
    item = {
        "schema": "agent-runlog-event-v1",
        "id": f"run-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:8]}",
        "trace_id": uuid.uuid4().hex[:12],
        "created_at": utc_now(),
        "kind": "resource-use",
        "outcome": outcome,
        "summary": summary,
        "session_id": None,
        "command": command,
        "source": "scripts/agent_resources.py",
        "tags": ["resource", resource_id] + tags,
        "artifacts": [".agent/resources.json"],
    }
    with RUNLOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(item, ensure_ascii=False) + "\n")


def risk_allowed(check_risk: str, max_risk: str) -> bool:
    return RISK_ORDER.get(check_risk, 99) <= RISK_ORDER.get(max_risk, 0)


def cmd_healthcheck(args: argparse.Namespace) -> int:
    config = load_config()
    item = resource_by_id(config, args.resource_id)
    if not item:
        print(f"error: resource not found: {args.resource_id}", file=sys.stderr)
        return 2
    max_risk = args.allow_risk or str(config.get("policy", {}).get("healthcheck_default_max_risk", "low"))
    checks = item.get("health_checks", [])
    if not checks:
        print(f"no health checks declared for {args.resource_id}")
        return 0
    selected = []
    for check in checks:
        check_risk = str(check.get("risk", "low"))
        if not risk_allowed(check_risk, max_risk):
            print(f"skipped {check.get('id')}: risk {check_risk} exceeds allowed {max_risk}")
            continue
        selected.append(check)
    if not selected:
        return 1
    if healthcheck_execution_requires_approval(item, selected) and not args.dry_run and not args.approved:
        print(f"error: resource {args.resource_id} requires approval before running health checks; rerun with --approved after approval", file=sys.stderr)
        return 3
    for check in selected:
        command_value = check.get("command", "")
        argv, command_errors = command_to_argv(command_value)
        command_errors.extend(error for error in validate_healthcheck_command(command_value) if error not in command_errors)
        timeout_seconds, timeout_error = validate_healthcheck_timeout(check.get("timeout_seconds"))
        if timeout_error:
            command_errors.append(timeout_error)
        command_display = command_to_display(command_value)
        if command_errors:
            for error in command_errors:
                print(f"error: health check {check.get('id')}: {error}", file=sys.stderr)
            return 1
        print(f"[{args.resource_id}:{check.get('id')}] {command_display}")
        if args.dry_run:
            continue
        try:
            result = subprocess.run(
                argv,
                shell=False,
                text=True,
                env=os.environ.copy(),
                check=False,
                timeout=timeout_seconds,
                capture_output=True,
            )
        except subprocess.TimeoutExpired:
            print(f"error: health check {check.get('id')} timed out after {timeout_seconds}s", file=sys.stderr)
            return 124
        outcome = "pass" if result.returncode == 0 else "fail"
        print(f"[{args.resource_id}:{check.get('id')}] {outcome} rc={result.returncode}")
        if args.show_output:
            combined_output = (result.stdout or "") + (result.stderr or "")
            if combined_output:
                print(redact_output(combined_output), end="" if combined_output.endswith("\n") else "\n")
        if item.get("risk") in {"high", "critical"} or str(check.get("risk", "low")) != "low":
            record_runlog(
                summary=f"resource healthcheck {check.get('id')} {outcome}",
                outcome=outcome,
                command=command_display,
                resource_id=str(item.get("id")),
                tags=[str(item.get("risk")), str(check.get("risk", "low"))],
            )
        if result.returncode != 0:
            return result.returncode
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Validate the resource catalog")
    doctor.set_defaults(func=cmd_doctor)

    list_cmd = subparsers.add_parser("list", help="List resources")
    list_cmd.add_argument("--type")
    list_cmd.add_argument("--env")
    list_cmd.add_argument("--enabled", action="store_true")
    list_cmd.add_argument("--json", action="store_true")
    list_cmd.set_defaults(func=cmd_list)

    match = subparsers.add_parser("match", help="Match an intent to candidate resources")
    match.add_argument("--intent", required=True)
    match.add_argument("--limit", type=int, default=5)
    match.add_argument("--include-disabled", action="store_true")
    match.add_argument("--json", action="store_true")
    match.set_defaults(func=cmd_match)

    resolve = subparsers.add_parser("resolve", help="Resolve non-secret guidance for a resource")
    resolve.add_argument("resource_id")
    resolve.add_argument("--json", action="store_true")
    resolve.set_defaults(func=cmd_resolve)

    template = subparsers.add_parser("template", help="Print or write the local secret-material template")
    template.add_argument("--print", dest="print_template", action="store_true")
    template.add_argument("--write")
    template.add_argument("--force", action="store_true")
    template.set_defaults(func=cmd_template)

    healthcheck = subparsers.add_parser("healthcheck", help="Run declared resource health checks")
    healthcheck.add_argument("resource_id")
    healthcheck.add_argument("--allow-risk", choices=sorted(RISK_ORDER), default=None)
    healthcheck.add_argument("--dry-run", action="store_true")
    healthcheck.add_argument("--approved", action="store_true", help="Confirm approval for high-risk, production, or release resource healthchecks")
    healthcheck.add_argument("--show-output", action="store_true", help="Print bounded redacted healthcheck stdout/stderr")
    healthcheck.set_defaults(func=cmd_healthcheck)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
