#!/usr/bin/env python3
"""Advisory governance hook for Codex and Claude adapters."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path


def find_root(start: Path) -> Path:
    for path in [start, *start.parents]:
        if (path / ".agent").is_dir():
            return path
    return start


def run(command: list[str], cwd: Path) -> tuple[int, str, str]:
    try:
        result = subprocess.run(command, cwd=cwd, text=True, capture_output=True, check=False)
    except OSError as exc:
        return 127, "", str(exc)
    return result.returncode, result.stdout.strip(), result.stderr.strip()


def excerpt(text: str, limit: int = 80) -> str:
    lines = text.splitlines()
    return "\n".join(lines[:limit])


def read_stdin_payload() -> tuple[object | None, str]:
    if sys.stdin is None or sys.stdin.closed or sys.stdin.isatty():
        return None, ""
    try:
        text = sys.stdin.read()
    except OSError as exc:
        return None, f"stdin read failed: {exc}"
    if not text:
        return None, ""
    if text.startswith("\ufeff"):
        text = text[1:]
    try:
        return json.loads(text), ""
    except json.JSONDecodeError as exc:
        return None, f"stdin JSON parse failed: {exc}"


def emit_json(event: str, additional_context: str, *, error: str = "") -> None:
    output = {
        "hookSpecificOutput": {
            "hookEventName": event,
            "additionalContext": additional_context,
        },
        "additionalContext": additional_context,
        "status": "error" if error else "ok",
    }
    if error:
        output["error"] = error
    print(json.dumps(output, ensure_ascii=False))


def active_session_id(root: Path) -> str | None:
    index = root / ".agent" / "sessions" / "index.json"
    if not index.exists():
        return None
    try:
        data = json.loads(index.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return None
    return data.get("active_session")


def session_start(root: Path) -> tuple[int, str]:
    output: list[str] = []
    tool = root / ".agent" / "tools" / "agent_session.py"
    if not tool.exists():
        return 0, "governance hook: .agent/tools/agent_session.py is missing"

    code, stdout, stderr = run([sys.executable, str(tool), "status"], root)
    if stdout:
        output.append(stdout)
    if stderr:
        output.append(stderr)
    if code != 0:
        output.append("governance hook: status reported errors; inspect .agent/sessions before editing")
        return 0, "\n".join(output)

    bootstrap = root / ".agent" / "sessions" / "bootstrap.md"
    if bootstrap.exists():
        output.append("\n# Governance Bootstrap Excerpt\n")
        output.append(excerpt(bootstrap.read_text(encoding="utf-8")))
    memory_tool = root / ".agent" / "tools" / "agent_memory.py"
    if memory_tool.exists():
        code, stdout, _ = run([sys.executable, str(memory_tool), "timeline", "--limit", "5"], root)
        if code == 0 and stdout:
            output.append("\n# Recent Agent Memory\n")
            output.append(stdout)
    context_tool = root / ".agent" / "tools" / "agent_context.py"
    if context_tool.exists():
        code, stdout, _ = run([sys.executable, str(context_tool), "scan", "--limit", "5", "--no-write"], root)
        if code == 0 and stdout:
            output.append("\n# Context Budget\n")
            output.append(stdout)
    capabilities_tool = root / "scripts" / "agent_capabilities.py"
    if capabilities_tool.exists():
        code, stdout, _ = run([sys.executable, str(capabilities_tool), "list", "--enabled"], root)
        if code == 0 and stdout:
            output.append("\n# Enabled Capabilities\n")
            output.append(excerpt(stdout, 30))
    return 0, "\n".join(output)


def stop(root: Path) -> tuple[int, str]:
    output: list[str] = []
    memory_tool = root / ".agent" / "tools" / "agent_memory.py"
    if memory_tool.exists():
        run([sys.executable, str(memory_tool), "ingest-session", "--reason", "hook-stop"], root)
    context_tool = root / ".agent" / "tools" / "agent_context.py"
    if context_tool.exists():
        run([sys.executable, str(context_tool), "scan", "--limit", "5"], root)
    runlog_tool = root / "scripts" / "agent_runlog.py"
    if runlog_tool.exists():
        run(
            [
                sys.executable,
                str(runlog_tool),
                "record",
                "--kind",
                "hook",
                "--outcome",
                "info",
                "--summary",
                "stop hook checked governance handoff state",
                "--source",
                ".agent/tools/governance_hook.py",
            ],
            root,
        )
    if active_session_id(root):
        output.append(
            "governance hook: checkpoint meaningful changes with "
            "`python3 .agent/tools/agent_session.py checkpoint --summary \"...\"` "
            "or compact before handoff."
        )
    return 0, "\n".join(output)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--event", choices=["session-start", "stop"], required=True)
    parser.add_argument("--json-output", action="store_true", help="Emit host-compatible JSON with hookSpecificOutput/additionalContext")
    parser.add_argument("--strict-json-input", action="store_true", help="Fail if non-empty stdin is not valid JSON")
    args = parser.parse_args(argv)

    _payload, stdin_error = read_stdin_payload()
    if stdin_error and args.strict_json_input:
        if args.json_output:
            emit_json(args.event, "", error=stdin_error)
        else:
            print(f"governance hook: {stdin_error}", file=sys.stderr)
        return 2

    root = find_root(Path.cwd().resolve())
    if args.event == "session-start":
        code, text = session_start(root)
    elif args.event == "stop":
        code, text = stop(root)
    else:
        code, text = 0, ""
    if stdin_error and text:
        text = f"governance hook: {stdin_error}\n{text}"
    elif stdin_error:
        text = f"governance hook: {stdin_error}"
    if args.json_output:
        emit_json(args.event, text)
    elif text:
        print(text)
    return code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
