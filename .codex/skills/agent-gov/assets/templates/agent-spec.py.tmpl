#!/usr/bin/env python3
"""Small local OpenSpec change helper used by project skills."""

from __future__ import annotations

import argparse
import json
import re
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
CHANGES_ROOT = ROOT / "openspec" / "changes"
ARCHIVE_ROOT = CHANGES_ROOT / "archive"
BLUEPRINT_PATH = ROOT / ".agent" / "blueprint.json"
ARTIFACTS = ("proposal", "design", "tasks")
PROFILE_VALUES = {"tiny", "bugfix", "standard", "full"}
IMPACT_TYPES = {"none", "add", "modify", "deprecate"}
RUNTIME_IMPACT_TYPES = {"none", "add", "change", "exception"}
ARCHITECTURE_SURFACE_RE = re.compile(
    r"(architecture|runtime|framework|layout|data|state|resource|security|mcp|validation|harness)",
    re.IGNORECASE,
)
PLACEHOLDER_PATTERNS = (
    "TBD",
    "TODO",
    "fill in",
    "Implement the approved change.",
    "Complete proposal, design, and capability specs.",
)


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def change_dir(name: str) -> Path:
    return CHANGES_ROOT / name


def normalize_name(raw: str) -> str:
    name = raw.strip().lower()
    name = re.sub(r"[^a-z0-9]+", "-", name)
    return re.sub(r"-+", "-", name).strip("-")


def read_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid JSON in {path}: {exc}") from exc


def has_placeholder_text(text: str) -> bool:
    text = re.sub(r"`[^`]*`", "", text)
    text = re.sub(r'"[^"\n]*"', "", text)
    text = re.sub(r"'[^'\n]*'", "", text)
    lowered = text.lower()
    return any(pattern.lower() in lowered for pattern in PLACEHOLDER_PATTERNS)


def task_board_ids() -> set[str] | None:
    board_path = ROOT / ".agent" / "task-board.json"
    if not board_path.exists():
        return None
    board = read_json(board_path)
    items = board.get("items", []) if isinstance(board, dict) else []
    return {str(item.get("id")) for item in items if isinstance(item, dict) and item.get("id")}


def blueprint_enabled() -> bool:
    return BLUEPRINT_PATH.exists()


def blueprint_ids() -> set[str]:
    blueprint = read_json(BLUEPRINT_PATH)
    records = blueprint.get("records", []) if isinstance(blueprint, dict) else []
    ids: set[str] = set()
    if isinstance(records, list):
        for record in records:
            if isinstance(record, dict) and record.get("id"):
                ids.add(str(record["id"]))
    return ids


def default_blueprint_impact() -> dict[str, Any]:
    return {
        "affected_blueprint_ids": [],
        "impact_type": "none",
        "runtime_framework_impact": "none",
        "blueprint_update_required": False,
        "adr_required": False,
        "no_impact_reason": "",
    }


def artifact_path(base: Path, artifact: str) -> Path:
    return base / f"{artifact}.md"


def artifact_status(path: Path, artifact: str) -> str:
    if not path.exists():
        return "missing"
    text = path.read_text(encoding="utf-8").strip()
    if "TBD" in text:
        return "draft"
    if artifact == "tasks" and "Implement the approved change." in text:
        return "draft"
    return "done" if text else "draft"


def spec_files(base: Path) -> list[str]:
    specs = base / "specs"
    if not specs.exists():
        return []
    return [path.relative_to(ROOT).as_posix() for path in sorted(specs.rglob("*.md"))]


def spec_delta_errors(base: Path, metadata: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    if metadata.get("requires_spec_delta") is not True:
        return errors
    files = [ROOT / path for path in spec_files(base)]
    if not files:
        return ["requires_spec_delta is true but no specs/**/spec.md files exist"]
    for path in files:
        text = path.read_text(encoding="utf-8", errors="ignore")
        label = path.relative_to(ROOT).as_posix()
        if has_placeholder_text(text):
            errors.append(f"{label} contains placeholder text")
        if "## ADDED Requirements" not in text and "## MODIFIED Requirements" not in text:
            errors.append(f"{label} missing ADDED or MODIFIED requirements section")
        if "### Requirement:" not in text:
            errors.append(f"{label} missing requirement heading")
        if "#### Scenario:" not in text:
            errors.append(f"{label} missing scenario heading")
    return errors


def iter_change_metadata(*, include_archived: bool = False) -> list[tuple[Path, dict[str, Any], str]]:
    rows: list[tuple[Path, dict[str, Any], str]] = []
    for metadata_path in sorted(CHANGES_ROOT.glob("*/.agent-spec.json")):
        rows.append((metadata_path.parent, read_json(metadata_path), "active"))
    if include_archived:
        for metadata_path in sorted(ARCHIVE_ROOT.glob("*/.agent-spec.json")):
            rows.append((metadata_path.parent, read_json(metadata_path), "archived"))
    return rows


def _safe_resolved(path: Path) -> Path | None:
    try:
        resolved = path.resolve()
    except OSError:
        return None
    try:
        resolved.relative_to(ROOT)
    except ValueError:
        return None
    return resolved


def _candidate_from_path(raw: str) -> tuple[Path, dict[str, Any], str] | None:
    path = Path(raw)
    candidates = [path]
    if not path.is_absolute():
        candidates.append(ROOT / path)
    for candidate in candidates:
        resolved = _safe_resolved(candidate)
        if resolved is None:
            continue
        if resolved.name == ".agent-spec.json":
            base = resolved.parent
        else:
            base = resolved
        metadata_path = base / ".agent-spec.json"
        if not metadata_path.exists():
            continue
        try:
            base.relative_to(ARCHIVE_ROOT)
            state = "archived"
        except ValueError:
            state = "active"
        return base, read_json(metadata_path), state
    return None


def resolve_change(raw: str, *, include_archived: bool = False, require_active: bool = False) -> tuple[Path, dict[str, Any], str]:
    token = raw.strip()
    if not token:
        raise SystemExit("error: change name cannot be empty")

    path_candidate = _candidate_from_path(token)
    if path_candidate is not None:
        base, metadata, state = path_candidate
        if require_active and state != "active":
            raise SystemExit(f"error: change is archived, not active: {base.relative_to(ROOT)}")
        return base, metadata, state

    normalized = normalize_name(token)
    matches: list[tuple[Path, dict[str, Any], str]] = []
    for base, metadata, state in iter_change_metadata(include_archived=include_archived):
        names = {
            normalize_name(str(metadata.get("name", ""))),
            normalize_name(base.name),
        }
        if state == "archived" and base.name.endswith(f"-{normalized}"):
            names.add(normalized)
        if normalized in names:
            matches.append((base, metadata, state))

    if require_active:
        matches = [match for match in matches if match[2] == "active"]
    if not matches:
        suffix = " active or archived" if include_archived and not require_active else " active"
        raise SystemExit(f"error: change not found:{suffix} {token}")
    if len(matches) > 1:
        paths = ", ".join(match[0].relative_to(ROOT).as_posix() for match in matches)
        raise SystemExit(f"error: ambiguous change reference {token!r}: {paths}")
    return matches[0]


def blueprint_impact_errors(metadata_path: Path, metadata: dict[str, Any], known_ids: set[str]) -> list[str]:
    errors: list[str] = []
    name = str(metadata.get("name") or metadata_path.parent.name)
    if not blueprint_enabled() and "blueprint_impact" not in metadata:
        return errors
    impact = metadata.get("blueprint_impact")
    if not isinstance(impact, dict):
        return [f"change {name} metadata missing blueprint_impact object"]
    impact_type = str(impact.get("impact_type", "")).strip()
    runtime_impact = str(impact.get("runtime_framework_impact", "")).strip()
    affected = impact.get("affected_blueprint_ids", [])
    if impact_type not in IMPACT_TYPES:
        errors.append(f"change {name} blueprint_impact impact_type must be one of {', '.join(sorted(IMPACT_TYPES))}")
    if runtime_impact not in RUNTIME_IMPACT_TYPES:
        errors.append(f"change {name} blueprint_impact runtime_framework_impact must be one of {', '.join(sorted(RUNTIME_IMPACT_TYPES))}")
    if not isinstance(affected, list):
        errors.append(f"change {name} blueprint_impact affected_blueprint_ids must be a list")
        affected = []
    unknown = [str(item) for item in affected if known_ids and str(item) not in known_ids]
    if unknown:
        errors.append(f"change {name} blueprint_impact unknown affected_blueprint_ids: {', '.join(unknown)}")
    bootstrap_note = str(impact.get("bootstrap_note", "")).strip()
    bootstrap_allowed = bool(bootstrap_note and not blueprint_enabled() and impact_type == "add")
    if impact_type != "none" and not affected and not bootstrap_allowed:
        errors.append(f"change {name} blueprint_impact non-none impact requires affected_blueprint_ids")
    no_impact_reason = str(impact.get("no_impact_reason", "")).strip()
    if impact_type == "none" and ARCHITECTURE_SURFACE_RE.search(str(metadata.get("summary", "")) + " " + name):
        if len(no_impact_reason) < 12:
            errors.append(f"change {name} blueprint_impact no_impact_reason is required for architecture/runtime/harness-looking changes")
    if runtime_impact in {"change", "exception"}:
        has_decision = bool(str(impact.get("linked_adr", "")).strip() or str(impact.get("accepted_exception", "")).strip())
        if impact.get("adr_required") is not True and not has_decision:
            errors.append(f"change {name} runtime framework change or exception requires adr_required true, linked_adr, or accepted_exception")
    return errors


def archive_blueprint_errors(metadata: dict[str, Any]) -> list[str]:
    name = str(metadata.get("name", "<unknown>"))
    impact = metadata.get("blueprint_impact", {})
    if not isinstance(impact, dict):
        return []
    errors: list[str] = []
    if impact.get("blueprint_update_required") is True:
        evidence = [
            str(impact.get("blueprint_update_evidence", "")).strip(),
            str(impact.get("blueprint_already_current_reason", "")).strip(),
        ]
        if not any(evidence):
            errors.append(f"change {name} requires blueprint update evidence before archive")
    if str(impact.get("runtime_framework_impact", "")).strip() in {"change", "exception"}:
        if not (
            str(impact.get("linked_adr", "")).strip()
            or str(impact.get("accepted_exception", "")).strip()
            or str(impact.get("blueprint_update_evidence", "")).strip()
        ):
            errors.append(f"change {name} requires runtime framework ADR or exception evidence before archive")
    return errors


def metadata_errors(metadata_path: Path, metadata: dict[str, Any], task_ids: set[str] | None) -> list[str]:
    errors: list[str] = []
    name = str(metadata.get("name") or metadata_path.parent.name)
    if metadata.get("schema") != "agent-spec-change-v1":
        errors.append(f"change {name} metadata schema must be agent-spec-change-v1")
    profile = str(metadata.get("profile", "")).strip()
    if not profile:
        errors.append(f"change {name} metadata missing profile")
    elif profile not in PROFILE_VALUES:
        errors.append(f"change {name} metadata profile must be one of {', '.join(sorted(PROFILE_VALUES))}")
    task_id = str(metadata.get("task_id", "")).strip()
    exception = str(metadata.get("task_link_exception", "")).strip()
    if task_ids is not None and profile and profile != "tiny" and not task_id and not exception:
        errors.append(f"change {name} metadata missing task_id for non-tiny profile")
    if task_ids is not None and task_id and task_id not in task_ids:
        errors.append(f"change {name} task_id not found in .agent/task-board.json: {task_id}")
    errors.extend(blueprint_impact_errors(metadata_path, metadata, blueprint_ids()))
    return errors


def task_counts(path: Path) -> dict[str, int]:
    if not path.exists():
        return {"complete": 0, "incomplete": 0, "total": 0}
    complete = 0
    incomplete = 0
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if stripped.startswith("- [x]") or stripped.startswith("- [X]"):
            complete += 1
        elif stripped.startswith("- [ ]"):
            incomplete += 1
    return {"complete": complete, "incomplete": incomplete, "total": complete + incomplete}


def load_change(name: str, *, include_archived: bool = False, require_active: bool = False) -> tuple[Path, dict[str, Any]]:
    base, metadata, _state = resolve_change(name, include_archived=include_archived, require_active=require_active)
    if not metadata:
        metadata = {"name": base.name, "status": "active", "summary": ""}
    return base, metadata


def status_payload_from_base(base: Path, metadata: dict[str, Any]) -> dict[str, Any]:
    artifacts: list[dict[str, str]] = []
    missing_or_draft: list[str] = []
    for artifact in ARTIFACTS:
        path = artifact_path(base, artifact)
        status = artifact_status(path, artifact)
        if status != "done":
            missing_or_draft.append(artifact)
        artifacts.append(
            {
                "id": artifact,
                "path": path.relative_to(ROOT).as_posix(),
                "status": status,
            }
        )

    context_files = {
        "proposal": [artifact_path(base, "proposal").relative_to(ROOT).as_posix()] if artifact_path(base, "proposal").exists() else [],
        "design": [artifact_path(base, "design").relative_to(ROOT).as_posix()] if artifact_path(base, "design").exists() else [],
        "tasks": [artifact_path(base, "tasks").relative_to(ROOT).as_posix()] if artifact_path(base, "tasks").exists() else [],
        "specs": spec_files(base),
    }
    counts = task_counts(artifact_path(base, "tasks"))
    if missing_or_draft:
        state = "blocked"
    elif counts["total"] and counts["incomplete"] == 0:
        state = "all_done"
    else:
        state = "ready"

    return {
        "schemaName": "agent-gov-embedded",
        "change": metadata,
        "applyRequires": list(ARTIFACTS),
        "artifacts": artifacts,
        "contextFiles": context_files,
        "tasks": counts,
        "state": state,
    }


def status_payload(name: str) -> dict[str, Any]:
    base, metadata = load_change(name, include_archived=True)
    return status_payload_from_base(base, metadata)


def command_new_change(args: argparse.Namespace) -> int:
    name = normalize_name(args.name)
    if not name:
        print("error: change name cannot be empty", file=sys.stderr)
        return 2
    base = change_dir(name)
    if base.exists() and not args.force:
        print(f"error: change already exists: {name}", file=sys.stderr)
        return 1
    base.mkdir(parents=True, exist_ok=True)
    (base / "specs").mkdir(exist_ok=True)
    metadata = {
        "schema": "agent-spec-change-v1",
        "name": name,
        "created_at": utc_now(),
        "status": "active",
        "summary": args.summary,
        "profile": args.profile,
        "task_id": args.task_id,
        "requires_spec_delta": bool(args.requires_spec_delta),
    }
    if blueprint_enabled():
        metadata["blueprint_impact"] = default_blueprint_impact()
    if args.task_link_exception:
        metadata["task_link_exception"] = args.task_link_exception
    (base / ".agent-spec.json").write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    templates = {
        "proposal.md": f"# Proposal: {name}\n\n## Summary\n\n{args.summary}\n\n"
        + (
            "## Blueprint Impact\n\n```yaml\naffected_blueprint_ids: []\nimpact_type: none\nruntime_framework_impact: none\nblueprint_update_required: false\nadr_required: false\nno_impact_reason: \"\"\n```\n\nThe structured authority is `.agent-spec.json#/blueprint_impact`. This section mirrors that metadata for human review.\n\n"
            if blueprint_enabled()
            else ""
        )
        + "## Goals\n\n- TBD\n\n## Non-Goals\n\n- TBD\n\n## User Workflows\n\n- TBD\n\n## User Impact\n\n- TBD\n",
        "design.md": f"# Design: {name}\n\n## Architecture\n\nTBD\n\n## Validation Strategy\n\nTBD\n\n## Risks\n\nTBD\n",
        "tasks.md": f"# Tasks: {name}\n\n## Specification\n\n- [ ] Complete proposal, design, and capability specs.\n\n## Implementation\n\n- [ ] Implement the approved change.\n\n## Validation\n\n- [ ] Run relevant validation commands.\n\n## Review\n\n- [ ] Review implementation and update this checklist.\n",
    }
    for filename, text in templates.items():
        path = base / filename
        if not path.exists() or args.force:
            path.write_text(text, encoding="utf-8")
    print(f"created change: {name}")
    print(f"path: {base.relative_to(ROOT)}")
    return 0


def command_list(args: argparse.Namespace) -> int:
    rows = []
    for metadata_path in sorted(CHANGES_ROOT.glob("*/.agent-spec.json")):
        metadata = read_json(metadata_path)
        if args.active and metadata.get("status") != "active":
            continue
        rows.append(
            {
                "name": metadata.get("name", metadata_path.parent.name),
                "status": metadata.get("status", ""),
                "summary": metadata.get("summary", ""),
                "path": metadata_path.parent.relative_to(ROOT).as_posix(),
            }
        )
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for row in rows:
            print(f"{row['name']}\t{row['status']}\t{row['path']}\t{row['summary']}")
    return 0


def command_status(args: argparse.Namespace) -> int:
    payload = status_payload(args.change)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        change = payload["change"]
        tasks = payload["tasks"]
        print(f"change: {change.get('name', args.change)}")
        print(f"status: {change.get('status', '')}")
        print(f"state: {payload['state']}")
        print(f"tasks: {tasks['complete']}/{tasks['total']} complete")
        for artifact in payload["artifacts"]:
            print(f"{artifact['id']}: {artifact['status']} ({artifact['path']})")
    return 0


def command_validate(args: argparse.Namespace) -> int:
    errors: list[str] = []
    task_ids = task_board_ids()
    for metadata_path in sorted(CHANGES_ROOT.glob("*/.agent-spec.json")):
        metadata = read_json(metadata_path)
        name = metadata.get("name", metadata_path.parent.name)
        errors.extend(metadata_errors(metadata_path, metadata, task_ids))
        errors.extend(f"change {name} {error}" for error in spec_delta_errors(metadata_path.parent, metadata))
        status = status_payload_from_base(metadata_path.parent, metadata)
        if status["state"] == "all_done":
            errors.append(
                f"change {name} is complete but still active; run `python3 scripts/agent_spec.py archive {name}`"
            )
        elif status["state"] == "blocked":
            incomplete = [
                f"{artifact['id']} ({artifact['status']})"
                for artifact in status["artifacts"]
                if artifact["status"] != "done"
            ]
            if incomplete:
                errors.append(f"change {name} incomplete artifacts: {', '.join(incomplete)}")
        tasks = status["tasks"]
        if tasks["total"] == 0:
            errors.append(f"change {name} has no markdown checkbox tasks")
    if errors:
        print("agent spec validation failed")
        for error in errors:
            print(f"error: {error}")
        return 1
    print("agent spec validation passed")
    return 0


def command_archive(args: argparse.Namespace) -> int:
    base, metadata, _state = resolve_change(args.change, require_active=True)
    name = str(metadata.get("name") or base.name)
    payload = status_payload_from_base(base, metadata)
    if payload["state"] != "all_done" and not args.force:
        print(f"error: change is not complete ({payload['state']}); use --force to archive anyway", file=sys.stderr)
        return 1

    tasks = payload["tasks"]
    if tasks["total"] == 0 and not args.force:
        print("error: change has no markdown checkbox tasks; use --force to archive anyway", file=sys.stderr)
        return 1
    if tasks["incomplete"] and not args.force:
        print(f"error: change has {tasks['incomplete']} incomplete task(s); use --force to archive anyway", file=sys.stderr)
        return 1
    if not args.force:
        blueprint_errors = archive_blueprint_errors(metadata)
        if blueprint_errors:
            for error in blueprint_errors:
                print(f"error: {error}", file=sys.stderr)
            return 1

    archive_date = args.date or datetime.now(timezone.utc).date().isoformat()
    target = ARCHIVE_ROOT / f"{archive_date}-{normalize_name(name)}"
    if target.exists():
        print(f"error: archive target already exists: {target.relative_to(ROOT)}", file=sys.stderr)
        return 1

    metadata["status"] = "archived"
    metadata["archived_at"] = utc_now()
    (base / ".agent-spec.json").write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    ARCHIVE_ROOT.mkdir(parents=True, exist_ok=True)
    shutil.move(str(base), str(target))
    print(f"archived: {name}")
    print(f"path: {target.relative_to(ROOT)}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    new_parser = subparsers.add_parser("new-change")
    new_parser.add_argument("name")
    new_parser.add_argument("--summary", default="")
    new_parser.add_argument("--profile", default="standard", choices=sorted(PROFILE_VALUES))
    new_parser.add_argument("--task-id", default="")
    new_parser.add_argument("--requires-spec-delta", action="store_true")
    new_parser.add_argument("--task-link-exception", default="")
    new_parser.add_argument("--force", action="store_true")
    new_parser.set_defaults(func=command_new_change)

    list_parser = subparsers.add_parser("list")
    list_parser.add_argument("--json", action="store_true")
    list_parser.add_argument("--active", action="store_true")
    list_parser.set_defaults(func=command_list)

    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--change", required=True)
    status_parser.add_argument("--json", action="store_true")
    status_parser.set_defaults(func=command_status)

    validate_parser = subparsers.add_parser("validate", help="Validate active spec changes")
    validate_parser.set_defaults(func=command_validate)

    doctor_parser = subparsers.add_parser("doctor", help="Validate active spec changes")
    doctor_parser.set_defaults(func=command_validate)

    archive_parser = subparsers.add_parser("archive", help="Archive a completed change")
    archive_parser.add_argument("change")
    archive_parser.add_argument("--date")
    archive_parser.add_argument("--force", action="store_true")
    archive_parser.set_defaults(func=command_archive)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
