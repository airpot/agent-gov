#!/usr/bin/env python3
"""Small local OpenSpec change helper used by project skills."""

from __future__ import annotations

import argparse
import json
import re
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
CHANGES_ROOT = ROOT / "openspec" / "changes"
ARCHIVE_ROOT = CHANGES_ROOT / "archive"
ARTIFACTS = ("proposal", "design", "tasks")
PROFILE_VALUES = {"tiny", "bugfix", "standard", "full"}
PLACEHOLDER_PATTERNS = (
    "TBD",
    "TODO",
    "fill in",
    "Implement the approved change.",
    "Complete proposal, design, and capability specs.",
)


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def change_dir(name: str) -> Path:
    return CHANGES_ROOT / name


def normalize_name(raw: str) -> str:
    name = raw.strip().lower()
    name = re.sub(r"[^a-z0-9]+", "-", name)
    return re.sub(r"-+", "-", name).strip("-")


def read_json(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid JSON in {path}: {exc}") from exc


def has_placeholder_text(text: str) -> bool:
    text = re.sub(r"`[^`]*`", "", text)
    text = re.sub(r'"[^"\n]*"', "", text)
    text = re.sub(r"'[^'\n]*'", "", text)
    lowered = text.lower()
    return any(pattern.lower() in lowered for pattern in PLACEHOLDER_PATTERNS)


def task_board_ids() -> set[str] | None:
    board_path = ROOT / ".agent" / "task-board.json"
    if not board_path.exists():
        return None
    board = read_json(board_path)
    items = board.get("items", []) if isinstance(board, dict) else []
    return {str(item.get("id")) for item in items if isinstance(item, dict) and item.get("id")}


def artifact_path(base: Path, artifact: str) -> Path:
    return base / f"{artifact}.md"


def artifact_status(path: Path, artifact: str) -> str:
    if not path.exists():
        return "missing"
    text = path.read_text(encoding="utf-8").strip()
    if "TBD" in text:
        return "draft"
    if artifact == "tasks" and "Implement the approved change." in text:
        return "draft"
    return "done" if text else "draft"


def spec_files(base: Path) -> list[str]:
    specs = base / "specs"
    if not specs.exists():
        return []
    return [path.relative_to(ROOT).as_posix() for path in sorted(specs.rglob("*.md"))]


def spec_delta_errors(base: Path, metadata: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    if metadata.get("requires_spec_delta") is not True:
        return errors
    files = [ROOT / path for path in spec_files(base)]
    if not files:
        return ["requires_spec_delta is true but no specs/**/spec.md files exist"]
    for path in files:
        text = path.read_text(encoding="utf-8", errors="ignore")
        label = path.relative_to(ROOT).as_posix()
        if has_placeholder_text(text):
            errors.append(f"{label} contains placeholder text")
        if "## ADDED Requirements" not in text and "## MODIFIED Requirements" not in text:
            errors.append(f"{label} missing ADDED or MODIFIED requirements section")
        if "### Requirement:" not in text:
            errors.append(f"{label} missing requirement heading")
        if "#### Scenario:" not in text:
            errors.append(f"{label} missing scenario heading")
    return errors


def metadata_errors(metadata_path: Path, metadata: dict[str, Any], task_ids: set[str] | None) -> list[str]:
    errors: list[str] = []
    name = str(metadata.get("name") or metadata_path.parent.name)
    if metadata.get("schema") != "agent-spec-change-v1":
        errors.append(f"change {name} metadata schema must be agent-spec-change-v1")
    profile = str(metadata.get("profile", "")).strip()
    if not profile:
        errors.append(f"change {name} metadata missing profile")
    elif profile not in PROFILE_VALUES:
        errors.append(f"change {name} metadata profile must be one of {', '.join(sorted(PROFILE_VALUES))}")
    task_id = str(metadata.get("task_id", "")).strip()
    exception = str(metadata.get("task_link_exception", "")).strip()
    if task_ids is not None and profile and profile != "tiny" and not task_id and not exception:
        errors.append(f"change {name} metadata missing task_id for non-tiny profile")
    if task_ids is not None and task_id and task_id not in task_ids:
        errors.append(f"change {name} task_id not found in .agent/task-board.json: {task_id}")
    return errors


def task_counts(path: Path) -> dict[str, int]:
    if not path.exists():
        return {"complete": 0, "incomplete": 0, "total": 0}
    complete = 0
    incomplete = 0
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if stripped.startswith("- [x]") or stripped.startswith("- [X]"):
            complete += 1
        elif stripped.startswith("- [ ]"):
            incomplete += 1
    return {"complete": complete, "incomplete": incomplete, "total": complete + incomplete}


def load_change(name: str) -> tuple[Path, dict[str, Any]]:
    base = change_dir(name)
    if not base.exists():
        raise SystemExit(f"error: change not found: {name}")
    metadata = read_json(base / ".agent-spec.json")
    if not metadata:
        metadata = {"name": name, "status": "active", "summary": ""}
    return base, metadata


def status_payload(name: str) -> dict[str, Any]:
    base, metadata = load_change(name)
    artifacts: list[dict[str, str]] = []
    missing_or_draft: list[str] = []
    for artifact in ARTIFACTS:
        path = artifact_path(base, artifact)
        status = artifact_status(path, artifact)
        if status != "done":
            missing_or_draft.append(artifact)
        artifacts.append(
            {
                "id": artifact,
                "path": path.relative_to(ROOT).as_posix(),
                "status": status,
            }
        )

    context_files = {
        "proposal": [artifact_path(base, "proposal").relative_to(ROOT).as_posix()] if artifact_path(base, "proposal").exists() else [],
        "design": [artifact_path(base, "design").relative_to(ROOT).as_posix()] if artifact_path(base, "design").exists() else [],
        "tasks": [artifact_path(base, "tasks").relative_to(ROOT).as_posix()] if artifact_path(base, "tasks").exists() else [],
        "specs": spec_files(base),
    }
    counts = task_counts(artifact_path(base, "tasks"))
    if missing_or_draft:
        state = "blocked"
    elif counts["total"] and counts["incomplete"] == 0:
        state = "all_done"
    else:
        state = "ready"

    return {
        "schemaName": "agent-gov-embedded",
        "change": metadata,
        "applyRequires": list(ARTIFACTS),
        "artifacts": artifacts,
        "contextFiles": context_files,
        "tasks": counts,
        "state": state,
    }


def command_new_change(args: argparse.Namespace) -> int:
    name = normalize_name(args.name)
    if not name:
        print("error: change name cannot be empty", file=sys.stderr)
        return 2
    base = change_dir(name)
    if base.exists() and not args.force:
        print(f"error: change already exists: {name}", file=sys.stderr)
        return 1
    base.mkdir(parents=True, exist_ok=True)
    (base / "specs").mkdir(exist_ok=True)
    metadata = {
        "schema": "agent-spec-change-v1",
        "name": name,
        "created_at": utc_now(),
        "status": "active",
        "summary": args.summary,
        "profile": args.profile,
        "task_id": args.task_id,
        "requires_spec_delta": bool(args.requires_spec_delta),
    }
    if args.task_link_exception:
        metadata["task_link_exception"] = args.task_link_exception
    (base / ".agent-spec.json").write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    templates = {
        "proposal.md": f"# Proposal: {name}\n\n## Summary\n\n{args.summary}\n\n## Goals\n\n- TBD\n\n## Non-Goals\n\n- TBD\n\n## User Workflows\n\n- TBD\n\n## User Impact\n\n- TBD\n",
        "design.md": f"# Design: {name}\n\n## Architecture\n\nTBD\n\n## Validation Strategy\n\nTBD\n\n## Risks\n\nTBD\n",
        "tasks.md": f"# Tasks: {name}\n\n## Specification\n\n- [ ] Complete proposal, design, and capability specs.\n\n## Implementation\n\n- [ ] Implement the approved change.\n\n## Validation\n\n- [ ] Run relevant validation commands.\n\n## Review\n\n- [ ] Review implementation and update this checklist.\n",
    }
    for filename, text in templates.items():
        path = base / filename
        if not path.exists() or args.force:
            path.write_text(text, encoding="utf-8")
    print(f"created change: {name}")
    print(f"path: {base.relative_to(ROOT)}")
    return 0


def command_list(args: argparse.Namespace) -> int:
    rows = []
    for metadata_path in sorted(CHANGES_ROOT.glob("*/.agent-spec.json")):
        metadata = read_json(metadata_path)
        if args.active and metadata.get("status") != "active":
            continue
        rows.append(
            {
                "name": metadata.get("name", metadata_path.parent.name),
                "status": metadata.get("status", ""),
                "summary": metadata.get("summary", ""),
                "path": metadata_path.parent.relative_to(ROOT).as_posix(),
            }
        )
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for row in rows:
            print(f"{row['name']}\t{row['status']}\t{row['path']}\t{row['summary']}")
    return 0


def command_status(args: argparse.Namespace) -> int:
    payload = status_payload(args.change)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        change = payload["change"]
        tasks = payload["tasks"]
        print(f"change: {change.get('name', args.change)}")
        print(f"status: {change.get('status', '')}")
        print(f"state: {payload['state']}")
        print(f"tasks: {tasks['complete']}/{tasks['total']} complete")
        for artifact in payload["artifacts"]:
            print(f"{artifact['id']}: {artifact['status']} ({artifact['path']})")
    return 0


def command_validate(args: argparse.Namespace) -> int:
    errors: list[str] = []
    task_ids = task_board_ids()
    for metadata_path in sorted(CHANGES_ROOT.glob("*/.agent-spec.json")):
        metadata = read_json(metadata_path)
        name = metadata.get("name", metadata_path.parent.name)
        errors.extend(metadata_errors(metadata_path, metadata, task_ids))
        errors.extend(f"change {name} {error}" for error in spec_delta_errors(metadata_path.parent, metadata))
        status = status_payload(name)
        if status["state"] == "all_done":
            errors.append(
                f"change {name} is complete but still active; run `python3 scripts/agent_spec.py archive {name}`"
            )
        elif status["state"] == "blocked":
            incomplete = [
                f"{artifact['id']} ({artifact['status']})"
                for artifact in status["artifacts"]
                if artifact["status"] != "done"
            ]
            if incomplete:
                errors.append(f"change {name} incomplete artifacts: {', '.join(incomplete)}")
        tasks = status["tasks"]
        if tasks["total"] == 0:
            errors.append(f"change {name} has no markdown checkbox tasks")
    if errors:
        print("agent spec validation failed")
        for error in errors:
            print(f"error: {error}")
        return 1
    print("agent spec validation passed")
    return 0


def command_archive(args: argparse.Namespace) -> int:
    name = normalize_name(args.change)
    payload = status_payload(name)
    if payload["state"] != "all_done" and not args.force:
        print(f"error: change is not complete ({payload['state']}); use --force to archive anyway", file=sys.stderr)
        return 1

    tasks = payload["tasks"]
    if tasks["total"] == 0 and not args.force:
        print("error: change has no markdown checkbox tasks; use --force to archive anyway", file=sys.stderr)
        return 1
    if tasks["incomplete"] and not args.force:
        print(f"error: change has {tasks['incomplete']} incomplete task(s); use --force to archive anyway", file=sys.stderr)
        return 1

    base, metadata = load_change(name)
    archive_date = args.date or datetime.now(timezone.utc).date().isoformat()
    target = ARCHIVE_ROOT / f"{archive_date}-{name}"
    if target.exists():
        print(f"error: archive target already exists: {target.relative_to(ROOT)}", file=sys.stderr)
        return 1

    metadata["status"] = "archived"
    metadata["archived_at"] = utc_now()
    (base / ".agent-spec.json").write_text(json.dumps(metadata, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    ARCHIVE_ROOT.mkdir(parents=True, exist_ok=True)
    shutil.move(str(base), str(target))
    print(f"archived: {name}")
    print(f"path: {target.relative_to(ROOT)}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    new_parser = subparsers.add_parser("new-change")
    new_parser.add_argument("name")
    new_parser.add_argument("--summary", default="")
    new_parser.add_argument("--profile", default="standard", choices=sorted(PROFILE_VALUES))
    new_parser.add_argument("--task-id", default="")
    new_parser.add_argument("--requires-spec-delta", action="store_true")
    new_parser.add_argument("--task-link-exception", default="")
    new_parser.add_argument("--force", action="store_true")
    new_parser.set_defaults(func=command_new_change)

    list_parser = subparsers.add_parser("list")
    list_parser.add_argument("--json", action="store_true")
    list_parser.add_argument("--active", action="store_true")
    list_parser.set_defaults(func=command_list)

    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--change", required=True)
    status_parser.add_argument("--json", action="store_true")
    status_parser.set_defaults(func=command_status)

    validate_parser = subparsers.add_parser("validate", help="Validate active spec changes")
    validate_parser.set_defaults(func=command_validate)

    doctor_parser = subparsers.add_parser("doctor", help="Validate active spec changes")
    doctor_parser.set_defaults(func=command_validate)

    archive_parser = subparsers.add_parser("archive", help="Archive a completed change")
    archive_parser.add_argument("change")
    archive_parser.add_argument("--date")
    archive_parser.add_argument("--force", action="store_true")
    archive_parser.set_defaults(func=command_archive)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
