#!/usr/bin/env python3
"""Manage the agent-gov task board and feature-stage documents."""

from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


TASK_BOARD_PATH = Path(".agent/task-board.json")
PROFILES_PATH = Path(".agent/workflow-profiles.json")
TASK_ID_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{1,80}$")
REVIEW_STATUSES = {"pending", "needs-fix", "pass", "accepted-with-exceptions", "not-required"}
REQUIREMENT_STATUSES = {"pending", "in-progress", "complete", "blocked", "not-required"}
REQUIREMENT_PROTECTED_STAGES = {
    "plan",
    "gate_review",
    "isolation",
    "implementation",
    "spec_review",
    "quality_review",
    "human_review",
    "verification",
    "handoff",
    "finish",
}
STAGE_REVIEW_REQUIRED_STAGES = (
    "spec",
    "plan",
    "implementation",
    "spec_review",
    "quality_review",
    "verification",
    "handoff",
)


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise SystemExit(f"error: missing {path}")
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid JSON in {path}: {exc}")


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def render(text: str, values: dict[str, str]) -> str:
    for key, value in values.items():
        text = text.replace("{{" + key + "}}", value)
    return text


def load_board() -> dict:
    board = load_json(TASK_BOARD_PATH)
    if board.get("schema") != "agent-task-board-v1":
        raise SystemExit("error: .agent/task-board.json schema must be agent-task-board-v1")
    return board


def load_profiles() -> dict:
    profiles = load_json(PROFILES_PATH)
    if profiles.get("schema") != "agent-workflow-profiles-v1":
        raise SystemExit("error: .agent/workflow-profiles.json schema must be agent-workflow-profiles-v1")
    return profiles


def profile_requires_review_gate(profile_name: str, profile: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("done_requires_review_gate_pass_for_profiles", []))
    return profile.get("review_gate_required") is True or profile_name in required_profiles


def default_review_gate(required: bool) -> dict:
    return {
        "required": required,
        "status": "pending" if required else "not-required",
        "latest_review": "",
        "latest_fix": "",
        "open_findings": [],
        "accepted_exception": "",
    }


def default_stage_review() -> dict:
    return {
        "status": "pending",
        "latest_review": "",
        "latest_fix": "",
        "open_findings": [],
        "accepted_exception": "",
    }


def default_requirements(profile_name: str) -> dict:
    required = profile_name != "tiny"
    return {
        "required": required,
        "status": "pending" if required else "not-required",
        "shared_understanding": "",
        "domain_glossary_updated": False,
        "code_docs_cross_checked": False,
        "open_questions": [],
    }


def normalized_requirements(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    requirements = item.get("requirements")
    if not isinstance(requirements, dict):
        requirements = {}
    merged = default_requirements(profile_name)
    merged.update(requirements)
    merged["required"] = bool(profile_name != "tiny" or merged.get("required") is True)
    if merged.get("status") not in REQUIREMENT_STATUSES:
        merged["status"] = "pending" if merged["required"] else "not-required"
    if not isinstance(merged.get("open_questions"), list):
        merged["open_questions"] = [str(merged.get("open_questions"))]
    return merged


def normalized_review_gate(item: dict, profile: dict, policy: dict) -> dict:
    required = profile_requires_review_gate(str(item.get("profile", "")), profile, policy)
    gate = item.get("review_gate")
    if not isinstance(gate, dict):
        gate = {}
    merged = default_review_gate(required)
    merged.update(gate)
    merged["required"] = bool(required or merged.get("required") is True)
    if merged.get("status") not in REVIEW_STATUSES:
        merged["status"] = "pending" if merged["required"] else "not-required"
    if not isinstance(merged.get("open_findings"), list):
        merged["open_findings"] = [str(merged.get("open_findings"))]
    return merged


def stage_reviews(item: dict) -> dict:
    reviews = item.get("stage_reviews")
    return reviews if isinstance(reviews, dict) else {}


def stage_review_required_for_profile(profile_name: str, policy: dict) -> bool:
    required_profiles = set(policy.get("stage_review_loop_required_for_profiles", []))
    return profile_name in required_profiles


def stage_review_required_stages(policy: dict) -> list[str]:
    configured = policy.get("stage_review_required_before_stage_exit")
    if isinstance(configured, list) and configured:
        return [str(stage) for stage in configured]
    return list(STAGE_REVIEW_REQUIRED_STAGES)


def required_stage_reviews_for_item(item: dict, profile: dict, policy: dict) -> list[str]:
    profile_name = str(item.get("profile", ""))
    if not stage_review_required_for_profile(profile_name, policy):
        return []
    stages = [str(stage) for stage in profile.get("stages", [])]
    current_stage = str(item.get("current_stage", ""))
    required_before_exit = set(stage_review_required_stages(policy))
    if item.get("state") in {"done", "archived"}:
        exited = stages
    elif current_stage in stages:
        exited = stages[: stages.index(current_stage)]
    else:
        exited = []
    return [stage for stage in exited if stage in required_before_exit]


def stage_review_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    reviews = stage_reviews(item)
    if not isinstance(item.get("stage_reviews", {}), dict):
        errors.append(f"{task_id} stage_reviews must be an object")
        return errors
    pass_status = policy.get("review_gate_pass_status", "pass")
    for stage in required_stage_reviews_for_item(item, profile, policy):
        review = reviews.get(stage)
        if not isinstance(review, dict):
            errors.append(f"{task_id} missing stage review for exited stage: {stage}")
            continue
        status = review.get("status")
        if status not in REVIEW_STATUSES:
            errors.append(f"{task_id} stage review {stage} has invalid status: {status}")
        if status != pass_status:
            errors.append(f"{task_id} stage review {stage} must be {pass_status}")
        open_findings = [finding for finding in review.get("open_findings", []) if str(finding).strip()]
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            errors.append(f"{task_id} stage review {stage} has open findings")
        latest_review = str(review.get("latest_review", "")).strip()
        if not latest_review:
            errors.append(f"{task_id} stage review {stage} missing latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not Path(latest_review).exists():
            errors.append(f"{task_id} stage review {stage} latest_review path is missing: {latest_review}")
    return errors


def requirements_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    requirements = normalized_requirements(item)
    if requirements.get("status") not in REQUIREMENT_STATUSES:
        errors.append(f"{task_id} requirements has invalid status: {requirements.get('status')}")
    if not requirements.get("required"):
        return errors
    protected = set(profile.get("requirement_protected_stages", [])) or REQUIREMENT_PROTECTED_STAGES
    current_stage = item.get("current_stage")
    state_done = item.get("state") == "done" and policy.get("requirements_complete_before_done") is True
    stage_protected = current_stage in protected and policy.get("requirements_complete_before_protected_stages") is True
    if not state_done and not stage_protected:
        return errors
    if requirements.get("status") != "complete":
        errors.append(f"{task_id} requirements must be complete before {current_stage or item.get('state')}")
    if not str(requirements.get("shared_understanding", "")).strip():
        errors.append(f"{task_id} requirements missing shared_understanding")
    if requirements.get("domain_glossary_updated") is not True:
        errors.append(f"{task_id} requirements must confirm domain_glossary_updated")
    if requirements.get("code_docs_cross_checked") is not True:
        errors.append(f"{task_id} requirements must confirm code_docs_cross_checked")
    docs_path = item.get("docs_path")
    if docs_path and not (Path(docs_path) / "01_REQUIREMENT_ANALYSIS.md").exists():
        errors.append(f"{task_id} missing requirement analysis document")
    return errors


def review_gate_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    gate = normalized_review_gate(item, profile, policy)
    if gate.get("status") not in REVIEW_STATUSES:
        errors.append(f"{task_id} review_gate has invalid status: {gate.get('status')}")
    open_findings = [finding for finding in gate.get("open_findings", []) if str(finding).strip()]
    if item.get("state") == "done" and gate.get("required"):
        pass_status = policy.get("review_gate_pass_status", "pass")
        if gate.get("status") != pass_status:
            errors.append(f"{task_id} done without review_gate status {pass_status}")
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            errors.append(f"{task_id} done with open review findings")
        latest_review = str(gate.get("latest_review", "")).strip()
        if not latest_review:
            errors.append(f"{task_id} done without review_gate latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not Path(latest_review).exists():
            errors.append(f"{task_id} review_gate latest_review path is missing: {latest_review}")
    return errors


def validate_board(board: dict, profiles: dict) -> list[str]:
    errors: list[str] = []
    states = set(board.get("states", []))
    required_fields = set(board.get("required_fields", []))
    policy = board.get("policy", {})
    for field in ("id", "title", "state", "risk", "profile", "current_stage", "docs_path", "requirements", "review_gate", "stage_reviews"):
        if field not in required_fields:
            errors.append(f"missing required field declaration: {field}")
    if set(policy.get("done_requires_review_gate_pass_for_profiles", [])) != {"standard", "full"}:
        errors.append("task board must require review_gate pass for standard and full done tasks")
    if policy.get("review_fix_loop_required_at_stage_exit") is not True:
        errors.append("task board must require review-fix loops at stage exit")
    if set(policy.get("stage_review_loop_required_for_profiles", [])) != {"standard", "full"}:
        errors.append("task board must require stage review loops for standard and full profiles")
    seen: set[str] = set()
    profile_names = set(profiles.get("profiles", {}))
    for item in board.get("items", []):
        task_id = item.get("id")
        if not task_id:
            errors.append("task item missing id")
            continue
        if task_id in seen:
            errors.append(f"duplicate task id: {task_id}")
        seen.add(task_id)
        for field in required_fields:
            if field not in item:
                errors.append(f"{task_id} missing field: {field}")
        if item.get("state") not in states:
            errors.append(f"{task_id} has invalid state: {item.get('state')}")
        if item.get("profile") not in profile_names:
            errors.append(f"{task_id} has invalid profile: {item.get('profile')}")
            continue
        docs_path = item.get("docs_path")
        profile = profiles.get("profiles", {}).get(item.get("profile"), {})
        allowed_stages = set(profile.get("stages", []))
        if allowed_stages and item.get("current_stage") not in allowed_stages:
            errors.append(f"{task_id} has invalid current_stage for profile {item.get('profile')}: {item.get('current_stage')}")
        if item.get("state") == "done" and policy.get("done_requires_delivery_conclusion") is True:
            if not str(item.get("delivery_conclusion", "")).strip():
                errors.append(f"{task_id} is done without delivery_conclusion")
        errors.extend(requirements_errors(task_id, item, profile, policy))
        errors.extend(review_gate_errors(task_id, item, profile, policy))
        errors.extend(stage_review_errors(task_id, item, profile, policy))
        if profile.get("feature_doc_templates") and (not docs_path or not Path(docs_path).exists()):
            errors.append(f"{task_id} docs_path missing or absent: {docs_path}")
    return errors


def cmd_doctor(args: argparse.Namespace) -> int:
    board = load_board()
    profiles = load_profiles()
    errors = validate_board(board, profiles)
    template_dir = Path(board.get("paths", {}).get("feature_template_dir", ".agent/templates/features"))
    for profile in profiles.get("profiles", {}).values():
        for doc_name in profile.get("feature_doc_templates", []):
            template_path = template_dir / f"{doc_name}.tmpl"
            if not template_path.exists():
                errors.append(f"missing feature template: {template_path}")
    if errors:
        for error in errors:
            print(f"error: {error}")
        return 1
    print("agent task board doctor passed")
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    board = load_board()
    items = board.get("items", [])
    if args.json:
        print(json.dumps({"schema": "agent-task-list-v1", "items": items}, indent=2))
        return 0
    if not items:
        print("no tasks")
        return 0
    for item in items:
        print(
            f"{item.get('id')} | {item.get('state')} | {item.get('profile')} | "
            f"{item.get('risk')} | {item.get('current_stage')} | {item.get('title')}"
        )
    return 0


def create_feature_docs(board: dict, profile: dict, values: dict[str, str], force: bool) -> str:
    doc_names = profile.get("feature_doc_templates", [])
    if not doc_names:
        return ""
    features_dir = Path(board.get("paths", {}).get("features_dir", "docs/features"))
    template_dir = Path(board.get("paths", {}).get("feature_template_dir", ".agent/templates/features"))
    task_dir = features_dir / values["task_id"]
    task_dir.mkdir(parents=True, exist_ok=True)
    for doc_name in doc_names:
        template_path = template_dir / f"{doc_name}.tmpl"
        if not template_path.exists():
            raise SystemExit(f"error: missing feature template: {template_path}")
        target = task_dir / doc_name
        if target.exists() and not force:
            continue
        target.write_text(render(template_path.read_text(encoding="utf-8"), values), encoding="utf-8")
    return str(task_dir)


def cmd_new(args: argparse.Namespace) -> int:
    if not TASK_ID_RE.match(args.task_id):
        print("error: task id must be lowercase letters, numbers, dot, underscore, or hyphen", file=sys.stderr)
        return 2
    board = load_board()
    profiles = load_profiles()
    profile = profiles.get("profiles", {}).get(args.profile)
    if not profile:
        print(f"error: unknown profile: {args.profile}", file=sys.stderr)
        return 2
    if any(item.get("id") == args.task_id for item in board.get("items", [])):
        print(f"error: task already exists: {args.task_id}", file=sys.stderr)
        return 2
    now = utc_now()
    values = {
        "task_id": args.task_id,
        "task_title": args.title,
        "task_profile": args.profile,
        "task_risk": args.risk,
        "created_at": now,
    }
    docs_path = create_feature_docs(board, profile, values, args.force)
    item = {
        "id": args.task_id,
        "title": args.title,
        "state": "proposed",
        "risk": args.risk,
        "profile": args.profile,
        "current_stage": "intake",
        "docs_path": docs_path,
        "requirements": default_requirements(args.profile),
        "created_at": now,
        "updated_at": now,
        "delivery_conclusion": "",
        "review_gate": default_review_gate(profile_requires_review_gate(args.profile, profile, board.get("policy", {}))),
        "stage_reviews": {},
        "related_tasks": [],
    }
    board.setdefault("items", []).append(item)
    write_json(TASK_BOARD_PATH, board)
    print(f"created task: {args.task_id}")
    if docs_path:
        print(f"docs: {docs_path}")
    return 0


def cmd_update(args: argparse.Namespace) -> int:
    board = load_board()
    profiles = load_profiles()
    items = board.get("items", [])
    item = next((entry for entry in items if entry.get("id") == args.task_id), None)
    if not item:
        print(f"error: task not found: {args.task_id}", file=sys.stderr)
        return 2
    profile = profiles.get("profiles", {}).get(item.get("profile"), {})
    if args.state:
        if args.state not in board.get("states", []):
            print(f"error: invalid state: {args.state}", file=sys.stderr)
            return 2
        item["state"] = args.state
    if args.stage:
        allowed_stages = set(profile.get("stages", []))
        if allowed_stages and args.stage not in allowed_stages:
            print(f"error: invalid stage for profile {item.get('profile')}: {args.stage}", file=sys.stderr)
            return 2
        item["current_stage"] = args.stage
    if args.conclusion is not None:
        item["delivery_conclusion"] = args.conclusion
    requirements = normalized_requirements(item)
    if args.requirements_status:
        requirements["status"] = args.requirements_status
    if args.shared_understanding is not None:
        requirements["shared_understanding"] = args.shared_understanding
    if args.domain_glossary_updated:
        requirements["domain_glossary_updated"] = True
    if args.no_domain_glossary_update:
        requirements["domain_glossary_updated"] = False
    if args.code_docs_cross_checked:
        requirements["code_docs_cross_checked"] = True
    if args.no_code_docs_cross_check:
        requirements["code_docs_cross_checked"] = False
    if args.clear_open_questions:
        requirements["open_questions"] = []
    if args.open_question:
        requirements.setdefault("open_questions", [])
        requirements["open_questions"].extend(args.open_question)
    item["requirements"] = requirements
    gate = normalized_review_gate(item, profile, board.get("policy", {}))
    if args.review_status:
        gate["status"] = args.review_status
    if args.review_path is not None:
        gate["latest_review"] = args.review_path
    if args.fix_path is not None:
        gate["latest_fix"] = args.fix_path
    if args.clear_open_findings:
        gate["open_findings"] = []
    if args.open_finding:
        gate.setdefault("open_findings", [])
        gate["open_findings"].extend(args.open_finding)
    if args.accepted_exception is not None:
        gate["accepted_exception"] = args.accepted_exception
    item["review_gate"] = gate
    if (
        args.stage_review_stage
        or args.stage_review_status
        or args.stage_review_path is not None
        or args.stage_fix_path is not None
        or args.stage_open_finding
        or args.clear_stage_open_findings
        or args.stage_accepted_exception is not None
    ):
        stage = args.stage_review_stage or item.get("current_stage")
        if not stage:
            print("error: stage review update requires --stage-review-stage or current_stage", file=sys.stderr)
            return 2
        reviews = stage_reviews(item)
        review = dict(default_stage_review())
        existing = reviews.get(stage)
        if isinstance(existing, dict):
            review.update(existing)
        if args.stage_review_status:
            review["status"] = args.stage_review_status
        if args.stage_review_path is not None:
            review["latest_review"] = args.stage_review_path
        if args.stage_fix_path is not None:
            review["latest_fix"] = args.stage_fix_path
        if args.clear_stage_open_findings:
            review["open_findings"] = []
        if args.stage_open_finding:
            review.setdefault("open_findings", [])
            review["open_findings"].extend(args.stage_open_finding)
        if args.stage_accepted_exception is not None:
            review["accepted_exception"] = args.stage_accepted_exception
        reviews[stage] = review
        item["stage_reviews"] = reviews
    if item.get("state") == "done" and board.get("policy", {}).get("done_requires_delivery_conclusion") is True:
        if not str(item.get("delivery_conclusion", "")).strip():
            print("error: done tasks require --conclusion", file=sys.stderr)
            return 2
    errors = validate_board(board, profiles)
    if errors:
        for error in errors:
            print(f"error: {error}", file=sys.stderr)
        return 2
    item["updated_at"] = utc_now()
    write_json(TASK_BOARD_PATH, board)
    print(f"updated task: {args.task_id}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Validate the task board")
    doctor.set_defaults(func=cmd_doctor)

    list_cmd = subparsers.add_parser("list", help="List tasks")
    list_cmd.add_argument("--json", action="store_true")
    list_cmd.set_defaults(func=cmd_list)

    new = subparsers.add_parser("new", help="Create a task and feature docs")
    new.add_argument("task_id")
    new.add_argument("--title", required=True)
    new.add_argument("--profile", default="standard")
    new.add_argument("--risk", default="medium", choices=["low", "medium", "high", "critical"])
    new.add_argument("--force", action="store_true", help="Overwrite existing feature docs for this task")
    new.set_defaults(func=cmd_new)

    update = subparsers.add_parser("update", help="Update task state")
    update.add_argument("task_id")
    update.add_argument("--state")
    update.add_argument("--stage")
    update.add_argument("--conclusion")
    update.add_argument("--requirements-status", choices=sorted(REQUIREMENT_STATUSES))
    update.add_argument("--shared-understanding")
    update.add_argument("--domain-glossary-updated", action="store_true")
    update.add_argument("--no-domain-glossary-update", action="store_true")
    update.add_argument("--code-docs-cross-checked", action="store_true")
    update.add_argument("--no-code-docs-cross-check", action="store_true")
    update.add_argument("--open-question", action="append", default=[])
    update.add_argument("--clear-open-questions", action="store_true")
    update.add_argument("--review-status", choices=sorted(REVIEW_STATUSES))
    update.add_argument("--review-path")
    update.add_argument("--fix-path")
    update.add_argument("--open-finding", action="append", default=[])
    update.add_argument("--clear-open-findings", action="store_true")
    update.add_argument("--accepted-exception")
    update.add_argument("--stage-review-stage")
    update.add_argument("--stage-review-status", choices=sorted(REVIEW_STATUSES))
    update.add_argument("--stage-review-path")
    update.add_argument("--stage-fix-path")
    update.add_argument("--stage-open-finding", action="append", default=[])
    update.add_argument("--clear-stage-open-findings", action="store_true")
    update.add_argument("--stage-accepted-exception")
    update.set_defaults(func=cmd_update)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
