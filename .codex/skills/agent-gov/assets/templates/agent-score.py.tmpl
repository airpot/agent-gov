def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path, fallback: dict | None = None) -> dict:
    if not path.exists():
        return fallback or {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return fallback or {}


def governance_manifest() -> dict:
    manifest = load_json(Path(".agent/manifest.json"), {})
    if manifest.get("schema") != "agent-governance-manifest-v1":
        return {}
    return manifest


def schema_json_files() -> dict[str, str]:
    manifest = governance_manifest()
    schemas = manifest.get("json_schemas", {})
    return schemas if isinstance(schemas, dict) and schemas else SCHEMA_JSON_FILES


def critical_json_files() -> set[str]:
    manifest = governance_manifest()
    critical = manifest.get("critical_json", [])
    return set(critical) if isinstance(critical, list) and critical else CRITICAL_JSON_FILES


def jsonl_files() -> list[str]:
    manifest = governance_manifest()
    files = manifest.get("jsonl_files", [])
    return files if isinstance(files, list) and files else JSONL_FILES


def json_without_schema_files() -> list[str]:
    manifest = governance_manifest()
    files = manifest.get("json_without_schema", [])
    return files if isinstance(files, list) else JSON_FILES_WITHOUT_SCHEMA


def expected_dimensions(config: dict | None = None) -> list[str]:
    config = config if config is not None else load_json(CONFIG_PATH)
    configured = config.get("dimensions", {})
    if isinstance(configured, dict) and configured:
        return list(configured)
    manifest = governance_manifest()
    manifest_dimensions = manifest.get("score_dimensions", [])
    if isinstance(manifest_dimensions, list) and manifest_dimensions:
        return [name for name in manifest_dimensions if isinstance(name, str)]
    return list(DEFAULT_DIMENSION_WEIGHTS)


def iter_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    rows: list[dict] = []
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            rows.append({"schema": "invalid", "raw": line})
    return rows


def run_json_command(args: list[str]) -> tuple[dict | None, str | None]:
    if len(args) > 1 and args[1].endswith(".py") and not Path(args[1]).exists():
        return None, f"missing {args[1]}"
    result = subprocess.run(args, text=True, capture_output=True, check=False)
    if not result.stdout.strip():
        output = (result.stderr or "").strip()
        suffix = f": {output}" if output else ""
        return None, f"{' '.join(args)} produced no JSON output{suffix}"
    try:
        return json.loads(result.stdout), None
    except json.JSONDecodeError as exc:
        output = (result.stdout + result.stderr).strip()
        return None, f"{' '.join(args)} produced invalid JSON: {exc}: {output[:500]}"


def estimate_tokens(path: Path) -> int:
    if not path.exists() or not path.is_file():
        return 0
    return int(math.ceil(len(path.read_text(encoding="utf-8", errors="ignore")) / 4))


def status_for(score: float) -> str:
    if score >= 85:
        return "pass"
    if score >= 70:
        return "warn"
    return "fail"


def dimension(name: str, score: float, findings: list[str], evidence: list[str]) -> dict:
    score = max(0.0, min(100.0, score))
    return {
        "name": name,
        "score": round(score, 1),
        "status": status_for(score),
        "findings": findings,
        "evidence": evidence,
    }


def read_json_for_integrity(path: Path) -> tuple[dict | None, str | None]:
    try:
        return json.loads(path.read_text(encoding="utf-8")), None
    except OSError as exc:
        return None, f"cannot read {path}: {exc}"
    except json.JSONDecodeError as exc:
        return None, f"invalid JSON: {path}: {exc}"


def jsonl_error_count(path: Path) -> int:
    errors = 0
    try:
        lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return 1
    for line in lines:
        if not line.strip():
            continue
        try:
            json.loads(line)
        except json.JSONDecodeError:
            errors += 1
    return errors


def score_project_integrity() -> dict:
    findings: list[str] = []
    evidence: list[str] = []
    valid_json = 0
    checked_json = 0
    invalid_json = 0
    schema_mismatches = 0
    missing_critical = 0

    schemas = schema_json_files()
    critical = critical_json_files()
    stores = jsonl_files()

    for name, expected_schema in schemas.items():
        path = Path(name)
        if not path.exists():
            if name in critical:
                missing_critical += 1
                findings.append(f"missing critical JSON: {name}")
            continue
        checked_json += 1
        data, error = read_json_for_integrity(path)
        if error:
            invalid_json += 1
            findings.append(error)
            continue
        valid_json += 1
        if expected_schema and data.get("schema") != expected_schema:
            schema_mismatches += 1
            findings.append(f"{name} schema must be {expected_schema}")

    for name in json_without_schema_files():
        path = Path(name)
        if not path.exists():
            continue
        checked_json += 1
        _, error = read_json_for_integrity(path)
        if error:
            invalid_json += 1
            findings.append(error)
        else:
            valid_json += 1

    invalid_jsonl = 0
    for name in stores:
        path = Path(name)
        if not path.exists():
            continue
        errors = jsonl_error_count(path)
        if errors:
            invalid_jsonl += errors
            findings.append(f"{name} has {errors} invalid JSONL line(s)")

    evidence.append(f"{valid_json}/{checked_json} JSON files parse")
    evidence.append(f"{len([name for name in stores if Path(name).exists()])} JSONL store(s) checked")
    penalty = min(100, invalid_json * 45 + schema_mismatches * 25 + missing_critical * 25 + invalid_jsonl * 20)
    return dimension("project_integrity", 100 - penalty, findings, evidence)


def score_required_paths() -> dict:
    harness = load_json(Path(".agent/harness.json"))
    required = harness.get("invariants", {}).get("required_paths", [])
    if not required:
        return dimension("required_paths", 0, ["no required paths configured"], [])
    existing = [path for path in required if Path(path).exists()]
    missing = [path for path in required if not Path(path).exists()]
    score = 100 * len(existing) / len(required)
    findings = [f"missing: {path}" for path in missing[:10]]
    return dimension("required_paths", score, findings, [f"{len(existing)}/{len(required)} required paths exist"])


def score_validation() -> dict:
    harness = load_json(Path(".agent/harness.json"))
    validation = harness.get("validation", {})
    commands = [command for values in validation.values() for command in values]
    findings: list[str] = []
    if not validation:
        return dimension("validation", 0, ["no validation registry"], [])
    if not commands:
        findings.append("no validation commands configured")
        return dimension("validation", 70, findings, ["validation registry exists"])
    suites = [suite for suite, values in validation.items() if values]
    return dimension("validation", 100, findings, [f"{len(commands)} commands in {len(suites)} suite(s)"])


def score_workflow_profiles() -> dict:
    profiles = load_json(Path(".agent/workflow-profiles.json"))
    workflow = load_json(Path(".agent/workflow.json"))
    findings: list[str] = []
    configured = profiles.get("profiles", {})
    workflow_stages = set(workflow.get("stages", []))
    for name in ("tiny", "bugfix", "standard", "full"):
        spec = configured.get(name)
        if not spec:
            findings.append(f"missing workflow profile: {name}")
            continue
        for key in ("stages", "max_risk", "task_board_record", "feature_doc_templates", "required_evidence"):
            if key not in spec:
                findings.append(f"profile {name} missing {key}")
        for stage in spec.get("stages", []):
            if workflow_stages and stage not in workflow_stages:
                findings.append(f"profile {name} references unknown stage: {stage}")
    policy = profiles.get("policy", {})
    if policy.get("choose_lightest_profile_that_covers_risk") is not True:
        findings.append("profiles must choose the lightest profile that covers risk")
    if workflow.get("profile_source") != ".agent/workflow-profiles.json":
        findings.append("workflow does not point to workflow profiles")
    standard_docs = configured.get("standard", {}).get("feature_doc_templates", [])
    full_docs = configured.get("full", {}).get("feature_doc_templates", [])
    if len(standard_docs) < 4:
        findings.append("standard profile should require durable feature docs")
    if len(full_docs) < 7:
        findings.append("full profile should require all seven stage docs")
    score = 100 - min(90, len(findings) * 15)
    evidence = [f"{len(configured)} profiles", f"default={profiles.get('default_profile') or 'none'}"]
    return dimension("workflow_profiles", score, findings, evidence)


def score_task_board() -> dict:
    board = load_json(Path(".agent/task-board.json"))
    profiles = load_json(Path(".agent/workflow-profiles.json"))
    findings: list[str] = []
    if board.get("schema") != "agent-task-board-v1":
        findings.append("invalid task-board schema")
    for field in ("id", "title", "state", "risk", "profile", "current_stage", "docs_path", "delivery_conclusion", "related_tasks"):
        if field not in board.get("required_fields", []):
            findings.append(f"task board missing required field declaration: {field}")
    policy = board.get("policy", {})
    if policy.get("non_tiny_work_requires_task") is not True:
        findings.append("task board must require records for non-tiny work")
    if policy.get("new_session_reads_board_before_edits") is not True:
        findings.append("new sessions must read task board before edits")
    if not Path("docs/features/INDEX.md").exists():
        findings.append("missing docs/features/INDEX.md")
    if not Path("scripts/agent_task.py").exists():
        findings.append("missing scripts/agent_task.py")
    states = set(board.get("states", []))
    profile_names = set(profiles.get("profiles", {}))
    policy = board.get("policy", {})
    ids: set[str] = set()
    for item in board.get("items", []):
        task_id = item.get("id", "unknown")
        if task_id in ids:
            findings.append(f"duplicate task id: {task_id}")
        ids.add(task_id)
        if item.get("state") not in states:
            findings.append(f"{task_id} has invalid state")
        if item.get("profile") not in profile_names:
            findings.append(f"{task_id} has invalid profile")
            continue
        profile = profiles.get("profiles", {}).get(item.get("profile"), {})
        allowed_stages = set(profile.get("stages", []))
        if allowed_stages and item.get("current_stage") not in allowed_stages:
            findings.append(f"{task_id} has invalid current_stage for profile {item.get('profile')}: {item.get('current_stage')}")
        if item.get("state") == "done" and policy.get("done_requires_delivery_conclusion") is True:
            if not str(item.get("delivery_conclusion", "")).strip():
                findings.append(f"{task_id} is done without delivery_conclusion")
        docs_path = item.get("docs_path")
        if profile.get("feature_doc_templates") and (not docs_path or not Path(docs_path).exists()):
            findings.append(f"{task_id} docs_path missing or absent: {docs_path}")
    score = 100 - min(90, len(findings) * 15)
    evidence = [f"{len(board.get('items', []))} task(s)", f"{len(states)} states"]
    return dimension("task_board", score, findings, evidence)


def score_role_contracts() -> dict:
    contracts = load_json(Path(".agent/role-contracts.json"))
    subagent_path = Path(".agent/subagents.json")
    subagents = load_json(subagent_path) if subagent_path.exists() else {}
    workflow = load_json(Path(".agent/workflow.json"))
    findings: list[str] = []
    if contracts.get("schema") != "agent-role-contracts-v1":
        findings.append("invalid role-contracts schema")
    if contracts.get("policy", {}).get("finder_cannot_fix") is not True:
        findings.append("role contracts must enforce finder_cannot_fix")
    if contracts.get("separation_of_duties", {}).get("finder_cannot_modify_files") is not True:
        findings.append("finder roles must not modify files")
    for role in ("coordinator", "worker", "verifier", "spec_reviewer", "quality_reviewer", "reviewer"):
        contract = contracts.get("contracts", {}).get(role, {})
        if not contract:
            findings.append(f"missing role contract: {role}")
            continue
        for key in ("owner_for_stages", "must_read", "may_write", "must_write", "forbidden_actions", "blocking_conditions"):
            if key not in contract:
                findings.append(f"{role} missing {key}")
    if subagent_path.exists() and subagents.get("role_contracts") != ".agent/role-contracts.json":
        findings.append("subagent policy does not point to role contracts")
    if workflow.get("role_contracts") != ".agent/role-contracts.json":
        findings.append("workflow does not point to role contracts")
    stage_defs = workflow.get("stage_definitions", {})
    for stage in ("implementation", "spec_review", "quality_review", "verification"):
        if not stage_defs.get(stage, {}).get("owner_role"):
            findings.append(f"workflow stage missing owner role: {stage}")
    score = 100 - min(90, len(findings) * 12)
    evidence = [f"{len(contracts.get('contracts', {}))} contracts", f"{len(stage_defs)} stage definitions"]
    return dimension("role_contracts", score, findings, evidence)


def score_mechanical_verification() -> dict:
    config = load_json(Path(".agent/mechanical-checks.json"))
    baselines = load_json(Path(".agent/baselines.json"))
    findings: list[str] = []
    if config.get("schema") != "agent-mechanical-checks-v1":
        findings.append("invalid mechanical-checks schema")
    checks = config.get("checks", {})
    for name in ("json_integrity", "jsonl_integrity", "required_paths", "feature_templates", "task_board", "role_contracts", "manifest", "markdown_links"):
        if name not in checks:
            findings.append(f"missing mechanical check: {name}")
    if checks.get("json_integrity", {}).get("fail_on_invalid") is not True:
        findings.append("json_integrity must fail on invalid JSON")
    if checks.get("required_paths", {}).get("fail_on_missing") is not True:
        findings.append("required_paths must fail on missing paths")
    if checks.get("role_contracts", {}).get("enforce_finder_cannot_fix") is not True:
        findings.append("role contract check must enforce finder_cannot_fix")
    if baselines.get("schema") != "agent-baselines-v1":
        findings.append("invalid baselines schema")
    if not Path("scripts/agent_verify.py").exists():
        findings.append("missing scripts/agent_verify.py")
    if not Path(".agent/baselines").exists():
        findings.append("missing .agent/baselines directory")
    policy = config.get("baseline_policy", {})
    if policy.get("fail_on_new_invalid_json") is not True:
        findings.append("baseline policy must fail on new invalid JSON")
    snapshot, error = run_json_command([sys.executable, "scripts/agent_verify.py", "snapshot", "--json"])
    hard_count = 0
    soft_count = 0
    if error:
        findings.append(f"agent_verify snapshot unavailable: {error}")
        hard_count += 1
    else:
        counts = snapshot.get("counts", {})
        hard_keys = (
            "invalid_json",
            "invalid_jsonl",
            "missing_required_paths",
            "missing_feature_templates",
            "task_board",
            "role_contracts",
            "governance_configs",
        )
        soft_keys = ("broken_local_links",)
        hard_count += sum(int(counts.get(key, 0)) for key in hard_keys)
        soft_count += sum(int(counts.get(key, 0)) for key in soft_keys)
        for category, values in snapshot.get("findings", {}).items():
            for value in values[:5]:
                findings.append(f"{category}: {value}")
    score = 100 - min(90, len(findings) * 10) - min(90, hard_count * 50) - min(40, soft_count * 10)
    evidence = [
        f"{len(checks)} mechanical check(s)",
        f"{len(baselines.get('snapshots', []))} baseline snapshot(s)",
        f"{hard_count} hard issue(s)",
        f"{soft_count} soft issue(s)",
    ]
    return dimension("mechanical_verification", score, findings, evidence)


def score_dev_map() -> dict:
    dev_map = load_json(Path(".agent/dev-map.json"))
    findings: list[str] = []
    if dev_map.get("schema") != "agent-dev-map-v1":
        findings.append("invalid dev-map schema")
    if dev_map.get("doc") != "docs/DEV_MAP.md":
        findings.append("dev map must point to docs/DEV_MAP.md")
    if not Path("docs/DEV_MAP.md").exists():
        findings.append("missing docs/DEV_MAP.md")
    policy = dev_map.get("policy", {})
    for key in ("map_is_index_not_inventory", "update_when_entry_points_change", "new_sessions_read_before_broad_edits"):
        if policy.get(key) is not True:
            findings.append(f"dev map policy missing {key}")
    areas = dev_map.get("areas", [])
    if not areas:
        findings.append("dev map has no areas")
    else:
        for area in areas:
            for key in ("id", "entry_points", "read_before_edit", "owned_paths", "common_patterns"):
                if key not in area:
                    findings.append(f"dev map area {area.get('id', 'unknown')} missing {key}")
    score = 100 - min(90, len(findings) * 15)
    return dimension("dev_map", score, findings, [f"{len(areas)} area(s)"])


def score_harness_evolution() -> dict:
    evolution = load_json(Path(".agent/harness-evolution.json"))
    findings: list[str] = []
    if evolution.get("schema") != "agent-harness-evolution-v1":
        findings.append("invalid harness-evolution schema")
    categories = evolution.get("incident_categories", {})
    for category in ("rule_gap", "skill_gap", "script_gap", "workflow_gap", "role_contract_gap", "tool_or_mcp_gap", "knowledge_gap", "session_gap", "context_gap"):
        if category not in categories:
            findings.append(f"missing incident category: {category}")
    policy = evolution.get("policy", {})
    for key in ("classify_governance_failures", "turn_repeat_failures_into_harness_changes", "prefer_script_for_mechanical_rules"):
        if policy.get(key) is not True:
            findings.append(f"harness evolution policy missing {key}")
    postmortem = Path(".agent/templates/postmortem.md.tmpl")
    if not postmortem.exists() or "Harness Evolution" not in postmortem.read_text(encoding="utf-8", errors="ignore"):
        findings.append("postmortem template lacks Harness Evolution section")
    score = 100 - min(90, len(findings) * 12)
    return dimension("harness_evolution", score, findings, [f"{len(categories)} incident categor(ies)"])


def score_mcp_policy() -> dict:
    policy = load_json(Path(".agent/mcp-policy.json"))
    findings: list[str] = []
    if policy.get("schema") != "agent-mcp-policy-v1":
        findings.append("invalid MCP policy schema")
    rules = policy.get("policy", {})
    for key in ("credentials_must_not_be_stored_in_repo", "destructive_or_release_operations_need_human_approval", "record_high_risk_mcp_use_in_runlog"):
        if rules.get(key) is not True:
            findings.append(f"MCP policy missing {key}")
    boundaries = policy.get("trust_boundaries", {})
    for key in ("repo_local", "external_read", "external_write", "release_or_signing"):
        if key not in boundaries:
            findings.append(f"MCP policy missing trust boundary: {key}")
    if policy.get("mode") != "optional-disabled-by-default" and not policy.get("servers"):
        findings.append("MCP policy is enabled-like but has no server registry")
    score = 100 - min(90, len(findings) * 15)
    return dimension("mcp_policy", score, findings, [f"{len(policy.get('servers', []))} server(s)", f"mode={policy.get('mode') or 'unknown'}"])


def score_governance_gc() -> dict:
    config = load_json(Path(".agent/governance-gc.json"))
    findings: list[str] = []
    if config.get("schema") != "agent-governance-gc-v1":
        findings.append("invalid governance-gc schema")
    checks = config.get("checks", {})
    for key in ("knowledge_owners", "stale_docs", "task_board_stale_active_items", "baseline_age", "config_pointer_consistency", "dev_map_presence", "mcp_policy_disabled_or_audited"):
        if key not in checks:
            findings.append(f"governance-gc missing check: {key}")
    if not Path("scripts/agent_gc.py").exists():
        findings.append("missing scripts/agent_gc.py")
    policy = config.get("policy", {})
    if policy.get("doctor_is_non_destructive") is not True:
        findings.append("governance-gc doctor must be non-destructive")
    report, error = run_json_command([sys.executable, "scripts/agent_gc.py", "report", "--json"])
    errors = 0
    warnings = 0
    if error:
        findings.append(f"agent_gc report unavailable: {error}")
        errors += 1
    else:
        counts = report.get("counts", {})
        errors = int(counts.get("errors", 0))
        warnings = int(counts.get("warnings", 0))
        for item in report.get("findings", [])[:10]:
            path = f" ({item.get('path')})" if item.get("path") else ""
            findings.append(f"{item.get('severity')}: {item.get('kind')}: {item.get('summary')}{path}")
    score = 100 - min(90, len(findings) * 10) - min(90, errors * 50) - min(50, warnings * 20)
    return dimension(
        "governance_gc",
        score,
        findings,
        [f"{len(checks)} configured check(s)", f"{errors} gc error(s)", f"{warnings} gc warning(s)"],
    )


def score_implementation_discipline() -> dict:
    workflow = load_json(Path(".agent/workflow.json"))
    gates = workflow.get("gates", {})
    discipline = gates.get("implementation_discipline", {})
    findings: list[str] = []
    required = {
        "state_assumptions_when_ambiguous",
        "prefer_simple_direct_code",
        "avoid_speculative_features",
        "abstractions_require_repeated_complexity_or_existing_pattern",
        "touch_only_requested_scope",
        "every_changed_line_traces_to_request",
        "success_criteria_required",
        "exceptions_require_session_note",
    }
    if not discipline:
        findings.append("missing implementation_discipline gate")
    else:
        for key in sorted(required):
            if key not in discipline:
                findings.append(f"implementation_discipline missing {key}")
    plan_template = Path(".agent/templates/implementation-plan.md.tmpl")
    review_template = Path(".agent/templates/project-review.md.tmpl")
    if not plan_template.exists():
        findings.append("missing implementation plan template")
    elif "Implementation Discipline Gate" not in plan_template.read_text(encoding="utf-8", errors="ignore"):
        findings.append("implementation plan template lacks discipline gate")
    if not review_template.exists():
        findings.append("missing project review template")
    elif "Implementation discipline evidence" not in review_template.read_text(encoding="utf-8", errors="ignore"):
        findings.append("project review template lacks discipline evidence")
    score = 100 - min(90, len(findings) * 15)
    evidence = [
        f"{len(required) - len([key for key in required if key not in discipline])}/{len(required)} policy keys present",
    ]
    return dimension("implementation_discipline", score, findings, evidence)


def score_risk_governance() -> dict:
    risk = load_json(Path(".agent/risk-zones.json"))
    workflow = load_json(Path(".agent/workflow.json"))
    findings: list[str] = []
    levels = risk.get("autonomy_levels", {})
    for level in ("low", "medium", "high", "critical"):
        if level not in levels:
            findings.append(f"missing autonomy level: {level}")
    if levels.get("high", {}).get("human_review_required") is not True:
        findings.append("high risk changes must require human review")
    if levels.get("critical", {}).get("agent_may_not_autonomously_modify") is not True:
        findings.append("critical risk changes must block autonomous modification")
    policy = risk.get("policy", {})
    for key in ("classify_before_implementation", "record_risk_in_plan_and_review", "stop_when_risk_increases"):
        if policy.get(key) is not True:
            findings.append(f"risk policy missing {key}")
    gate = workflow.get("gates", {}).get("risk_classification", {})
    if not gate:
        findings.append("workflow missing risk_classification gate")
    elif not gate.get("record_in_plan"):
        findings.append("risk classification must be recorded in the implementation plan")
    plan_template = Path(".agent/templates/implementation-plan.md.tmpl")
    review_template = Path(".agent/templates/project-review.md.tmpl")
    if not plan_template.exists() or "Task Risk and Autonomy" not in plan_template.read_text(encoding="utf-8", errors="ignore"):
        findings.append("implementation plan template lacks risk and autonomy section")
    if not review_template.exists() or "Task Risk Review" not in review_template.read_text(encoding="utf-8", errors="ignore"):
        findings.append("project review template lacks task risk review section")
    score = 100 - min(90, len(findings) * 15)
    evidence = [f"{len(levels)}/4 autonomy levels configured", f"{len(risk.get('high_risk_patterns', []))} high-risk patterns"]
    return dimension("risk_governance", score, findings, evidence)


def score_review_policy() -> dict:
    policy = load_json(Path(".agent/review-policy.json"))
    workflow = load_json(Path(".agent/workflow.json"))
    findings: list[str] = []
    trace = policy.get("diff_traceability", {})
    categories = trace.get("categories", [])
    for category in ("requested", "necessary-support", "incidental", "risky"):
        if category not in categories:
            findings.append(f"missing diff category: {category}")
    if trace.get("every_changed_line_traces_to_request") is not True:
        findings.append("diff traceability must require changed-line request mapping")
    if trace.get("incidental_requires_removal_or_exception") is not True:
        findings.append("incidental changes must require removal or exception")
    human = policy.get("human_review", {})
    if human.get("agent_summary_is_not_review") is not True:
        findings.append("human review must not be satisfied by agent summary alone")
    if "high" not in human.get("required_for_risk", []) or "critical" not in human.get("required_for_risk", []):
        findings.append("human review must be required for high and critical risk")
    for field in ("reviewer", "review_type", "diff_range", "files_reviewed", "high_risk_paths_checked", "conclusion"):
        if field not in human.get("evidence_fields", []):
            findings.append(f"missing human review evidence field: {field}")
    gates = workflow.get("gates", {})
    if "diff_traceability" not in gates:
        findings.append("workflow missing diff_traceability gate")
    if "human_review_evidence" not in gates:
        findings.append("workflow missing human_review_evidence gate")
    review_template = Path(".agent/templates/project-review.md.tmpl")
    if not review_template.exists():
        findings.append("missing project review template")
    else:
        text = review_template.read_text(encoding="utf-8", errors="ignore")
        for marker in ("Diff Traceability", "Human Review Evidence", "Automated Review Boundary"):
            if marker not in text:
                findings.append(f"project review template lacks {marker}")
    score = 100 - min(90, len(findings) * 12)
    evidence = [f"{len(categories)} diff categories", f"{len(human.get('evidence_fields', []))} human review evidence fields"]
    return dimension("review_policy", score, findings, evidence)


def threshold_for(path: Path, context: dict) -> int:
    budgets = context.get("budgets", {})
    text_path = str(path)
    if text_path == "AGENTS.md":
        return int(budgets.get("max_agent_instruction_tokens", 1600))
    if text_path == "CLAUDE.md":
        return int(budgets.get("max_claude_instruction_tokens", 2500))
    if text_path == ".agent/sessions/bootstrap.md":
        return int(budgets.get("max_bootstrap_tokens", 5000))
    if text_path == ".agent/memory/latest.md":
        return int(budgets.get("max_memory_digest_tokens", 1200))
    return int(budgets.get("max_single_doc_tokens", 3000))


def score_context_budget() -> dict:
    context = load_json(Path(".agent/context.json"))
    tracked = [Path(path) for path in context.get("tracked_files", []) if Path(path).exists()]
    total_budget = int(context.get("budgets", {}).get("max_total_tracked_tokens", 20000))
    findings: list[str] = []
    total = 0
    for path in tracked:
        tokens = estimate_tokens(path)
        total += tokens
        threshold = threshold_for(path, context)
        if tokens > threshold:
            findings.append(f"{path} over budget: {tokens} > {threshold}")
    if total > total_budget:
        findings.append(f"total context over budget: {total} > {total_budget}")
    if not tracked:
        return dimension("context_budget", 0, ["no tracked context files found"], [])
    over_penalty = min(60, len(findings) * 15)
    total_penalty = 0 if total <= total_budget else min(30, ((total - total_budget) / total_budget) * 100)
    score = 100 - over_penalty - total_penalty
    return dimension("context_budget", score, findings, [f"{total}/{total_budget} estimated tokens", f"{len(tracked)} tracked files"])


def score_session_continuity() -> dict:
    required = [
        ".agent/sessions/index.json",
        ".agent/sessions/active.md",
        ".agent/sessions/bootstrap.md",
        ".agent/tools/agent_session.py",
    ]
    existing = [path for path in required if Path(path).exists()]
    findings = [f"missing: {path}" for path in required if not Path(path).exists()]
    score = 100 * len(existing) / len(required)
    index = load_json(Path(".agent/sessions/index.json"), {})
    evidence = [f"{len(existing)}/{len(required)} session paths exist"]
    evidence.append(f"active_session={index.get('active_session') or 'none'}")
    return dimension("session_continuity", score, findings, evidence)


def score_memory() -> dict:
    memory = load_json(Path(".agent/memory.json"))
    findings: list[str] = []
    if memory.get("schema") != "agent-memory-v1":
        findings.append("invalid memory schema")
    taxonomy = memory.get("taxonomy", {})
    for name in ("episodic", "semantic", "procedural"):
        if name not in taxonomy:
            findings.append(f"taxonomy missing {name}")
    events = iter_jsonl(Path(memory.get("stores", {}).get("events_jsonl", ".agent/memory/events.jsonl")))
    for item in events:
        if item.get("memory_class") == "procedural" and (not item.get("reviewed") or not item.get("review_ref")):
            findings.append(f"procedural memory lacks review evidence: {item.get('id')}")
    score = 100 - min(80, len(findings) * 20)
    return dimension("memory", score, findings, [f"{len(events)} memory records"])


def score_capabilities() -> dict:
    config = load_json(Path(".agent/capabilities.json"))
    caps = config.get("capabilities", [])
    findings: list[str] = []
    required = {"id", "kind", "provider", "enabled", "risk", "owner", "permissions", "validation", "capability_class"}
    capability_classes = set(config.get("capability_classes", {}))
    for class_name in ("instruction", "executable", "integration", "native_adapter"):
        if class_name not in capability_classes:
            findings.append(f"missing capability class: {class_name}")
    seen: set[str] = set()
    owner_gaps = 0
    for item in caps:
        cap_id = item.get("id", "unknown")
        missing = required - set(item)
        if missing:
            findings.append(f"{cap_id} missing {', '.join(sorted(missing))}")
        if cap_id in seen:
            findings.append(f"duplicate capability id: {cap_id}")
        seen.add(cap_id)
        if item.get("enabled") and item.get("owner") == "unassigned":
            owner_gaps += 1
        if item.get("capability_class") not in capability_classes:
            findings.append(f"{cap_id} has invalid capability_class")
        if item.get("enabled") and not item.get("validation"):
            findings.append(f"{cap_id} enabled without validation")
    if not caps:
        findings.append("no capabilities registered")
    score = 100 - min(50, len(findings) * 15) - min(20, owner_gaps * 2)
    evidence = [f"{len(caps)} capabilities", f"{owner_gaps} enabled owner gaps"]
    return dimension("capabilities", score, findings, evidence)


def is_ignored(path: Path) -> bool:
    return bool(set(path.parts) & IGNORE_DIRS)


def is_sensitive_path(path: Path) -> bool:
    if SENSITIVE_BASENAME_RE.match(path.name):
        return True
    lowered_parts = {part.lower() for part in path.parts}
    return bool(lowered_parts & SENSITIVE_COMPONENTS)


def sensitive_path_count(limit: int = 100) -> int:
    count = 0
    for path in Path(".").rglob("*"):
        if count >= limit:
            break
        if not path.is_file() or is_ignored(path):
            continue
        try:
            rel = path.resolve().relative_to(Path.cwd().resolve())
        except ValueError:
            continue
        if is_sensitive_path(rel):
            count += 1
    return count


def score_security() -> dict:
    security = load_json(Path(".agent/security.json"))
    suites = security.get("suites", {})
    findings: list[str] = []
    for name in ("policy_as_code", "secret_scan", "dependency_audit", "sbom", "license_scan"):
        if name not in suites:
            findings.append(f"missing suite: {name}")
        elif not isinstance(suites[name], list):
            findings.append(f"suite must be list: {name}")
    sensitive = sensitive_path_count()
    if sensitive:
        findings.append(f"{sensitive} sensitive-looking path(s) found")
    configured = sum(len(value) for value in suites.values() if isinstance(value, list))
    score = 100 - min(50, len(findings) * 15)
    if configured == 0:
        score -= 10
    return dimension("security", score, findings, [f"{configured} configured security command(s)"])


def parse_date(value: str) -> datetime | None:
    try:
        return datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def score_knowledge() -> dict:
    knowledge = load_json(Path(".agent/knowledge.json"))
    docs = knowledge.get("documents", [])
    findings: list[str] = []
    owner_gaps = 0
    stale = 0
    now = datetime.now(timezone.utc)
    for doc in docs:
        path = Path(doc.get("path", ""))
        if not path.exists():
            findings.append(f"missing doc: {path}")
        if doc.get("owner") == "unassigned":
            owner_gaps += 1
        reviewed = parse_date(doc.get("last_reviewed", ""))
        if reviewed is None:
            findings.append(f"invalid review date: {path}")
        elif (now - reviewed).days > 180:
            stale += 1
    score = 100 - min(40, len(findings) * 10) - min(30, owner_gaps * 2) - min(20, stale * 5)
    return dimension("knowledge", score, findings, [f"{len(docs)} docs", f"{owner_gaps} owner gaps", f"{stale} stale docs"])


def score_runlog(extra_events: int = 0) -> dict:
    rows = iter_jsonl(RUNLOG_PATH)
    findings: list[str] = []
    invalid = [row for row in rows if row.get("schema") != "agent-runlog-event-v1"]
    if invalid:
        findings.append(f"{len(invalid)} invalid runlog line(s)")
    score = 100 - min(80, len(invalid) * 20)
    event_count = len(rows) + extra_events
    if event_count == 0:
        score = 80
    evidence = [f"{event_count} events"]
    if extra_events:
        evidence.append(f"includes {extra_events} event(s) from current write")
    return dimension("runlog", score, findings, evidence)


def collect_scores(extra_runlog_events: int = 0) -> dict:
    config = load_json(CONFIG_PATH)
    configured_dimensions = expected_dimensions(config)
    weights = {
        name: int(config.get("dimensions", {}).get(name, {}).get("weight", DEFAULT_DIMENSION_WEIGHTS.get(name, 0)))
        for name in configured_dimensions
    }
    score_functions = {
        "project_integrity": score_project_integrity,
        "required_paths": score_required_paths,
        "validation": score_validation,
        "workflow_profiles": score_workflow_profiles,
        "task_board": score_task_board,
        "role_contracts": score_role_contracts,
        "mechanical_verification": score_mechanical_verification,
        "dev_map": score_dev_map,
        "harness_evolution": score_harness_evolution,
        "mcp_policy": score_mcp_policy,
        "governance_gc": score_governance_gc,
        "implementation_discipline": score_implementation_discipline,
        "risk_governance": score_risk_governance,
        "review_policy": score_review_policy,
        "context_budget": score_context_budget,
        "session_continuity": score_session_continuity,
        "memory": score_memory,
        "capabilities": score_capabilities,
        "security": score_security,
        "knowledge": score_knowledge,
        "runlog": lambda: score_runlog(extra_runlog_events),
    }
    checks = {}
    for name in configured_dimensions:
        score_function = score_functions.get(name)
        if score_function is None:
            checks[name] = dimension(name, 0, [f"unknown score dimension: {name}"], [])
        else:
            checks[name] = score_function()
    total_weight = sum(weights.values()) or 1
    total = sum(checks[name]["score"] * weights.get(name, 0) for name in checks) / total_weight
    hard_fail_dimensions = [
        name for name in HARD_FAIL_DIMENSIONS if checks.get(name, {}).get("status") == "fail"
    ]
    if hard_fail_dimensions:
        total = min(total, 69.9)
    result = {
        "schema": "agent-governance-score-v1",
        "created_at": utc_now(),
        "score": round(total, 1),
        "status": "fail" if hard_fail_dimensions else status_for(total),
        "dimensions": checks,
        "weights": weights,
        "hard_fail_dimensions": hard_fail_dimensions,
    }
    return result


def render_markdown(report: dict) -> str:
    lines = [
        "# Agent Governance Score",
        "",
        f"- Scored: {report['created_at']}",
        f"- Score: {report['score']} ({report['status']})",
    ]
    if report.get("hard_fail_dimensions"):
        lines.append(f"- Hard fail dimensions: {', '.join(report['hard_fail_dimensions'])}")
    lines.extend(["", "## Dimensions", ""])
    for name, item in report["dimensions"].items():
        lines.append(f"- `{name}`: {item['score']} ({item['status']})")
        for evidence in item.get("evidence", []):
            lines.append(f"  - {evidence}")
        for finding in item.get("findings", [])[:5]:
            lines.append(f"  - finding: {finding}")
    lines.extend(
        [
            "",
            "## Commands",
            "",
            "```bash",
            "python3 scripts/agent_score.py score",
            "python3 scripts/agent_score.py score --write",
            "python3 scripts/agent_runlog.py tail --limit 10",
            "```",
            "",
        ]
    )
    return "\n".join(lines)


def record_runlog(report: dict) -> None:
    item = {
        "schema": "agent-runlog-event-v1",
        "id": f"run-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}-{uuid.uuid4().hex[:8]}",
        "trace_id": uuid.uuid4().hex[:12],
        "created_at": utc_now(),
        "kind": "eval",
        "outcome": report["status"],
        "summary": f"governance score {report['score']} ({report['status']})",
        "session_id": None,
        "command": "scripts/agent_score.py score --write",
        "source": "scripts/agent_score.py",
        "tags": ["governance-score"],
        "artifacts": [str(LATEST_PATH)],
    }
    RUNLOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with RUNLOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(item, ensure_ascii=False) + "\n")


def cmd_doctor(args: argparse.Namespace) -> int:
    errors: list[str] = []
    if not CONFIG_PATH.exists():
        errors.append(f"missing {CONFIG_PATH}")
    else:
        config = load_json(CONFIG_PATH)
        if config.get("schema") != "agent-evals-v1":
            errors.append(".agent/evals.json schema must be agent-evals-v1")
        dimensions = config.get("dimensions", {})
        for name in expected_dimensions(config):
            if name not in dimensions:
                errors.append(f".agent/evals.json missing dimension: {name}")
            if name not in DEFAULT_DIMENSION_WEIGHTS:
                errors.append(f".agent/evals.json uses unknown dimension: {name}")
    integrity = score_project_integrity()
    if integrity["status"] == "fail":
        errors.extend(integrity["findings"])
    LATEST_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not LATEST_PATH.exists():
        LATEST_PATH.write_text("# Agent Governance Score\n\nNo score recorded yet.\n", encoding="utf-8")
    for error in errors:
        print(f"error: {error}")
    if errors:
        return 1
    print("agent score doctor passed")
    return 0


def cmd_score(args: argparse.Namespace) -> int:
    report = collect_scores(extra_runlog_events=1 if args.write else 0)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(render_markdown(report))
    if args.write:
        LATEST_PATH.parent.mkdir(parents=True, exist_ok=True)
        LATEST_PATH.write_text(render_markdown(report), encoding="utf-8")
        record_runlog(report)
    if report.get("hard_fail_dimensions"):
        return 1
    if args.fail_under is not None and report["score"] < args.fail_under:
        return 1
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Check score configuration")
    doctor.set_defaults(func=cmd_doctor)

    score = subparsers.add_parser("score", help="Compute governance score")
    score.add_argument("--json", action="store_true")
    score.add_argument("--write", action="store_true", help="Write .agent/evals/latest.md and append runlog evidence")
    score.add_argument("--fail-under", type=float)
    score.set_defaults(func=cmd_score)

    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
