def score_agent_runtime_architecture() -> dict:
    findings: list[str] = []
    expected = {
        ".agent/runtime-policy.json": "agent-runtime-policy-v1",
        ".agent/model-profiles.json": "agent-model-profiles-v1",
        ".agent/agent-runtime.json": "agent-runtime-selection-v1",
    }
    for path, schema in expected.items():
        config = load_json(Path(path))
        if config.get("schema") != schema:
            findings.append(f"{path} schema must be {schema}")
    if not Path("scripts/agent_runtime.py").exists():
        findings.append("missing scripts/agent_runtime.py")
        report = {}
    else:
        result = subprocess.run([sys.executable, "scripts/agent_runtime.py", "doctor"], text=True, capture_output=True, check=False)
        if result.returncode != 0:
            output = (result.stdout + result.stderr).strip()
            findings.append(f"agent_runtime doctor failed: {output}")
        report, error = run_json_command([sys.executable, "scripts/agent_runtime.py", "report", "--json"])
        if error:
            findings.append(f"agent_runtime report unavailable: {error}")
            report = {}
    if report:
        if report.get("project_target") not in {"agent", "mcp-server", "hybrid", "library"}:
            findings.append("runtime project target is unknown")
        if report.get("architecture_style") not in {"skill-first", "skill-first-mcp", "skill-first-hybrid", "skill-first-library", "project-defined"}:
            findings.append("runtime architecture style is unknown")
        if not report.get("default_adapter"):
            findings.append("runtime default adapter is missing")
        if report.get("model_profiles_required") is True and not report.get("selected_model_profiles"):
            findings.append("runtime selected model profiles are missing")
    score = 100 - min(90, len(findings) * 15)
    evidence = [
        f"target={report.get('project_target', 'unknown')}" if report else "target=unknown",
        f"adapter={report.get('default_adapter', 'unknown')}" if report else "adapter=unknown",
        f"models={','.join(report.get('selected_model_profiles', []))}" if report else "models=unknown",
    ]
    return dimension("agent_runtime_architecture", score, findings, evidence)


def score_skill_runtime() -> dict:
    runtime = load_json(Path(".agent/skill-runtime.json"))
    findings: list[str] = []
    if runtime.get("schema") != "agent-skill-runtime-v1":
        findings.append(".agent/skill-runtime.json schema must be agent-skill-runtime-v1")
    for section in (
        "source_evidence",
        "canonical_core",
        "host_adapters",
        "runtime_modes",
        "command_lanes",
        "review_lanes",
        "impact_benchmarks",
        "shortcut_debt",
        "dependency_policy",
    ):
        if section not in runtime:
            findings.append(f"missing skill runtime section: {section}")
    evidence_items = runtime.get("source_evidence", [])
    if not isinstance(evidence_items, list) or not evidence_items:
        findings.append("skill runtime source evidence is missing")
    else:
        for item in evidence_items:
            if item.get("status") not in {"verified", "partial", "blocked"}:
                findings.append("skill runtime source evidence uses unknown status")
    core = runtime.get("canonical_core", {})
    path_patterns = set(core.get("path_patterns", []))
    for pattern in ("SKILL.md", "AGENTS.md", "references/", "scripts/", "assets/"):
        if pattern not in path_patterns:
            findings.append(f"canonical core missing {pattern}")
    if core.get("adapters_must_be_thin") is not True:
        findings.append("host adapters must be thin")
    host_adapters = runtime.get("host_adapters", {})
    adapter_count = len(host_adapters.get("adapter_targets", [])) if isinstance(host_adapters.get("adapter_targets", []), list) else 0
    parity_policy = host_adapters.get("parity_policy", {})
    for key in (
        "canonical_source_required",
        "adapter_drift_must_be_detected",
        "release_claim_requires_parity_evidence",
        "hook_projection_boundary_required",
        "orphaned_hook_files_are_findings",
        "empty_hooks_object_may_suppress_autodiscovery",
    ):
        if parity_policy.get(key) is not True:
            findings.append(f"adapter parity policy missing {key}")
    modes = runtime.get("runtime_modes", {})
    mode_count = len(modes.get("allowed_modes", [])) if isinstance(modes.get("allowed_modes", []), list) else 0
    if "off" not in modes.get("allowed_modes", []):
        findings.append("runtime modes must include off")
    hook_boundaries = modes.get("hook_boundaries", {})
    for key in (
        "stdin_must_not_deadlock",
        "stdin_errors_degrade_safely",
        "strip_utf8_bom_before_json_parse",
        "valid_json_required_when_host_requires_json",
        "preserve_empty_additional_context",
        "invalid_mandatory_output_exits_nonzero",
        "hook_must_not_store_secrets",
    ):
        if hook_boundaries.get(key) is not True:
            findings.append(f"hook boundary must enable {key}")
    lanes = runtime.get("command_lanes", {})
    review_lanes = runtime.get("review_lanes", {})
    for lane in ("mode_switch", "complexity_review", "repository_audit", "debt_harvest", "impact_scoreboard", "help_status"):
        if lane not in lanes:
            findings.append(f"missing command lane: {lane}")
    for lane in ("spec_compliance", "quality_security", "complexity_only", "debt_ledger", "impact_benchmark"):
        if lane not in review_lanes:
            findings.append(f"missing review lane: {lane}")
    forbidden = set(review_lanes.get("complexity_only", {}).get("forbidden_findings", []))
    for finding in ("correctness", "security", "privacy", "data-loss", "accessibility"):
        if finding not in forbidden:
            findings.append(f"complexity-only review must route {finding} elsewhere")
    benchmark_policy = runtime.get("impact_benchmarks", {}).get("policy", {})
    for key in ("baseline_arm_required", "skill_enabled_arm_required", "contamination_selftest_required", "correctness_or_safety_gate_required"):
        if benchmark_policy.get(key) is not True:
            findings.append(f"impact benchmark policy missing {key}")
    debt = runtime.get("shortcut_debt", {})
    if debt.get("marker") != "agent-gov-debt:":
        findings.append("shortcut debt marker must be agent-gov-debt:")
    for field in ("ceiling", "upgrade_trigger"):
        if field not in debt.get("required_fields", []):
            findings.append(f"shortcut debt required field missing: {field}")
    dependency_policy = runtime.get("dependency_policy", {})
    for key in ("local_doctors_dependency_free", "python_standard_library_only_for_generated_checks", "no_network_required_for_doctor"):
        if dependency_policy.get(key) is not True:
            findings.append(f"skill runtime dependency policy missing {key}")
    if not Path("docs/SKILL_RUNTIME.md").exists():
        findings.append("missing docs/SKILL_RUNTIME.md")
    score = 100 - min(90, len(findings) * 10)
    return dimension(
        "skill_runtime",
        score,
        findings,
        [f"{adapter_count} adapter target(s)", f"{mode_count} mode(s)", f"{len(lanes)} command lane(s)", f"{len(review_lanes)} review lane(s)"],
    )


def score_skill_optimization() -> dict:
    config = load_json(Path(".agent/skill-optimization.json"))
    findings: list[str] = []
    if config.get("schema") != "agent-skill-optimization-v1":
        findings.append(".agent/skill-optimization.json schema must be agent-skill-optimization-v1")
    modes = set(config.get("modes", []))
    for mode in ("manual-only", "auto-candidate", "auto-apply-staged", "auto-promote"):
        if mode not in modes:
            findings.append(f"skill optimization mode missing: {mode}")
    triggers = config.get("triggers", {})
    trigger_count = len(triggers) if isinstance(triggers, dict) else 0
    for trigger in ("manual", "failure-threshold", "release-gate", "scheduled-sleep"):
        if not isinstance(triggers, dict) or trigger not in triggers:
            findings.append(f"skill optimization trigger missing: {trigger}")
    default_policy = config.get("default_skill_policy", {})
    if not isinstance(default_policy, dict) or default_policy.get("mode") not in modes:
        findings.append("default skill optimization policy must use an allowed mode")
    release = config.get("release_preflight", {})
    if not isinstance(release, dict):
        findings.append("release preflight policy must be an object")
    else:
        for key in ("required", "release_check_validates_existing_only", "fail_closed"):
            if release.get(key) is not True:
                findings.append(f"release preflight policy must enable {key}")
        artifacts = set(release.get("artifact_names", []))
        for artifact in ("signal-scan.md", "candidate-summary.md", "gate-report.md", "rejected-edits.jsonl", "release-decision.md", "rollback-plan.md"):
            if artifact not in artifacts:
                findings.append(f"release preflight artifact missing: {artifact}")
    scheduled = config.get("scheduled_sleep", {})
    if not isinstance(scheduled, dict) or scheduled.get("primitive") != "scheduled_routine":
        findings.append("scheduled sleep must be governed as scheduled_routine")
    else:
        for key in ("disable_or_expiry_policy", "resource_boundary", "cost_boundary", "evidence_path", "dry_run_default", "human_interrupt_points", "fail_closed"):
            if key not in scheduled:
                findings.append(f"scheduled sleep missing {key}")
    promotion = config.get("promotion", {})
    if promotion.get("auto_promote_boundary") != "local production skill files only":
        findings.append("auto-promote boundary must be local production skill files only")
    forbidden = set(promotion.get("forbidden_auto_promote_actions", []))
    for action in ("publish package", "push remote", "sign release", "bypass release-check"):
        if action not in forbidden:
            findings.append(f"auto-promote forbidden action missing: {action}")
    roles = config.get("role_boundaries", {})
    if not isinstance(roles, dict) or roles.get("finder_cannot_fix") is not True:
        findings.append("role boundaries must enforce finder_cannot_fix")
    if not Path("scripts/agent_skill_opt.py").exists():
        findings.append("missing scripts/agent_skill_opt.py")
    if not Path("docs/SKILL_OPTIMIZATION.md").exists():
        findings.append("missing docs/SKILL_OPTIMIZATION.md")
    score = 100 - min(90, len(findings) * 10)
    return dimension(
        "skill_optimization",
        score,
        findings,
        [f"{len(modes)} mode(s)", f"{trigger_count} trigger(s)", f"{len(config.get('skills', {})) if isinstance(config.get('skills'), dict) else 0} skill override(s)"],
    )


