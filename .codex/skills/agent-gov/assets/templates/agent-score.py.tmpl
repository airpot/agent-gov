def existing_repo_file(value: str, root: Path = Path(".")) -> bool:
    candidate = Path(value)
    if not value or candidate.is_absolute():
        return False
    repository = root.resolve()
    try:
        resolved = (repository / candidate).resolve(strict=True)
        resolved.relative_to(repository)
    except (OSError, RuntimeError, ValueError):
        return False
    return resolved.is_file()


def parse_utc(value: object) -> datetime | None:
    try:
        return datetime.strptime(str(value), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso_datetime(value: str) -> datetime | None:
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def has_placeholder_text(text: str) -> bool:
    text = re.sub(r"`[^`]*`", "", text)
    text = re.sub(r'"[^"\n]*"', "", text)
    text = re.sub(r"'[^'\n]*'", "", text)
    lowered = text.lower()
    return any(pattern.lower() in lowered for pattern in PLACEHOLDER_PATTERNS)


def load_json(path: Path, fallback: dict | None = None) -> dict:
    if not path.exists():
        return fallback or {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return fallback or {}


def governance_manifest() -> dict:
    manifest = load_json(Path(".agent/manifest.json"), {})
    if manifest.get("schema") != "agent-governance-manifest-v1":
        return {}
    return manifest


def schema_json_files() -> dict[str, str]:
    manifest = governance_manifest()
    schemas = manifest.get("json_schemas", {})
    return schemas if isinstance(schemas, dict) and schemas else SCHEMA_JSON_FILES


def critical_json_files() -> set[str]:
    manifest = governance_manifest()
    critical = manifest.get("critical_json", [])
    return set(critical) if isinstance(critical, list) and critical else CRITICAL_JSON_FILES


def jsonl_files() -> list[str]:
    manifest = governance_manifest()
    files = manifest.get("jsonl_files", [])
    return files if isinstance(files, list) and files else JSONL_FILES


def json_without_schema_files() -> list[str]:
    manifest = governance_manifest()
    files = manifest.get("json_without_schema", [])
    return files if isinstance(files, list) else JSON_FILES_WITHOUT_SCHEMA


def expected_dimensions(config: dict | None = None) -> list[str]:
    config = config if config is not None else load_json(CONFIG_PATH)
    configured = config.get("dimensions", {})
    if isinstance(configured, dict) and configured:
        return list(configured)
    manifest = governance_manifest()
    manifest_dimensions = manifest.get("score_dimensions", [])
    if isinstance(manifest_dimensions, list) and manifest_dimensions:
        return [name for name in manifest_dimensions if isinstance(name, str)]
    return list(DEFAULT_DIMENSION_WEIGHTS)


def iter_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    rows: list[dict] = []
    for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            rows.append({"schema": "invalid", "raw": line})
    return rows


def iter_jsonl_with_errors(path: Path) -> tuple[list[dict], list[str]]:
    rows: list[dict] = []
    errors: list[str] = []
    if not path.exists():
        return rows, errors
    for index, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            errors.append(f"{path}:{index}: {exc}")
    return rows, errors


def strip_line_suffix(handle: str) -> str:
    match = re.match(r"^(.+?):\d+(?::\d+)?$", handle)
    return match.group(1) if match else handle


def jsonl_ids(path: Path) -> set[str]:
    rows, _ = iter_jsonl_with_errors(path)
    return {str(item.get("id")) for item in rows if item.get("id")}


def evidence_exists(handle: str, runlog_ids: set[str], event_ids: set[str]) -> bool:
    handle = handle.strip()
    if not handle:
        return False
    if handle in runlog_ids or handle in event_ids:
        return True
    return Path(strip_line_suffix(handle)).exists()


def run_json_command(args: list[str]) -> tuple[dict | None, str | None]:
    if len(args) > 1 and args[1].endswith(".py") and not Path(args[1]).exists():
        return None, f"missing {args[1]}"
    result = subprocess.run(args, text=True, capture_output=True, check=False)
    if not result.stdout.strip():
        output = (result.stderr or "").strip()
        suffix = f": {output}" if output else ""
        return None, f"{' '.join(args)} produced no JSON output{suffix}"
    try:
        return json.loads(result.stdout), None
    except json.JSONDecodeError as exc:
        output = (result.stdout + result.stderr).strip()
        return None, f"{' '.join(args)} produced invalid JSON: {exc}: {output[:500]}"


def estimate_tokens(path: Path) -> int:
    if not path.exists() or not path.is_file():
        return 0
    return int(math.ceil(len(path.read_text(encoding="utf-8", errors="ignore")) / 4))


def status_for(score: float) -> str:
    if score >= 85:
        return "pass"
    if score >= 70:
        return "warn"
    return "fail"


def dimension(name: str, score: float, findings: list[str], evidence: list[str]) -> dict:
    score = max(0.0, min(100.0, score))
    return {
        "name": name,
        "score": round(score, 1),
        "status": status_for(score),
        "findings": findings,
        "evidence": evidence,
    }


def read_json_for_integrity(path: Path) -> tuple[dict | None, str | None]:
    try:
        return json.loads(path.read_text(encoding="utf-8")), None
    except OSError as exc:
        return None, f"cannot read {path}: {exc}"
    except json.JSONDecodeError as exc:
        return None, f"invalid JSON: {path}: {exc}"


def jsonl_error_count(path: Path) -> int:
    errors = 0
    try:
        lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return 1
    for line in lines:
        if not line.strip():
            continue
        try:
            json.loads(line)
        except json.JSONDecodeError:
            errors += 1
    return errors


def score_project_integrity() -> dict:
    findings: list[str] = []
    evidence: list[str] = []
    valid_json = 0
    checked_json = 0
    invalid_json = 0
    schema_mismatches = 0
    missing_critical = 0

    schemas = schema_json_files()
    critical = critical_json_files()
    stores = jsonl_files()

    for name, expected_schema in schemas.items():
        path = Path(name)
        if not path.exists():
            if name in critical:
                missing_critical += 1
                findings.append(f"missing critical JSON: {name}")
            continue
        checked_json += 1
        data, error = read_json_for_integrity(path)
        if error:
            invalid_json += 1
            findings.append(error)
            continue
        valid_json += 1
        if expected_schema and data.get("schema") != expected_schema:
            schema_mismatches += 1
            findings.append(f"{name} schema must be {expected_schema}")
        if name == ".agent/spec.json" and data.get("schema") == "agent-spec-v1":
            policy = data.get("policy", {})
            for key in (
                "archive_requires_completed_tasks_or_force",
                "completed_active_changes_fail_validation",
                "archive_before_completion_claim",
            ):
                if policy.get(key) is not True:
                    schema_mismatches += 1
                    findings.append(f".agent/spec.json policy must enable {key}")

    for name in json_without_schema_files():
        path = Path(name)
        if not path.exists():
            continue
        checked_json += 1
        _, error = read_json_for_integrity(path)
        if error:
            invalid_json += 1
            findings.append(error)
        else:
            valid_json += 1

    invalid_jsonl = 0
    for name in stores:
        path = Path(name)
        if not path.exists():
            continue
        errors = jsonl_error_count(path)
        if errors:
            invalid_jsonl += errors
            findings.append(f"{name} has {errors} invalid JSONL line(s)")

    evidence.append(f"{valid_json}/{checked_json} JSON files parse")
    evidence.append(f"{len([name for name in stores if Path(name).exists()])} JSONL store(s) checked")
    penalty = min(100, invalid_json * 45 + schema_mismatches * 25 + missing_critical * 25 + invalid_jsonl * 20)
    return dimension("project_integrity", 100 - penalty, findings, evidence)


def score_required_paths() -> dict:
    harness = load_json(Path(".agent/harness.json"))
    required = harness.get("invariants", {}).get("required_paths", [])
    if not required:
        return dimension("required_paths", 0, ["no required paths configured"], [])
    existing = [path for path in required if Path(path).exists()]
    missing = [path for path in required if not Path(path).exists()]
    score = 100 * len(existing) / len(required)
    findings = [f"missing: {path}" for path in missing[:10]]
    return dimension("required_paths", score, findings, [f"{len(existing)}/{len(required)} required paths exist"])


def score_validation() -> dict:
    harness = load_json(Path(".agent/harness.json"))
    evals = load_json(CONFIG_PATH)
    validation = harness.get("validation", {})
    commands = [command for values in validation.values() for command in values]
    findings: list[str] = []
    if not validation:
        return dimension("validation", 0, ["no validation registry"], [])
    if not commands:
        findings.append("no validation commands configured")
        return dimension("validation", 70, findings, ["validation registry exists"])
    suites = [suite for suite, values in validation.items() if values]
    policy = evals.get("policy", {})
    freshness_days = int(policy.get("validation_freshness_days", 7))
    require_fresh = policy.get("validation_freshness_required", True) is True
    cutoff = datetime.now(timezone.utc) if freshness_days < 0 else datetime.now(timezone.utc)
    if freshness_days >= 0:
        cutoff = cutoff.replace(microsecond=0)
    rows = iter_jsonl(RUNLOG_PATH)
    fresh_commands: set[str] = set()
    latest_seen: dict[str, str] = {}
    for row in rows:
        command = str(row.get("command") or "")
        if command not in commands or row.get("kind") != "validation" or row.get("outcome") != "pass":
            continue
        created = parse_iso_datetime(str(row.get("created_at") or ""))
        if created is None:
            continue
        latest_seen[command] = max(latest_seen.get(command, ""), str(row.get("created_at") or ""))
        if freshness_days < 0 or (cutoff - created).days <= freshness_days:
            fresh_commands.add(command)
    missing_fresh = [command for command in commands if command not in fresh_commands]
    if require_fresh and missing_fresh:
        findings.append(f"{len(missing_fresh)} validation command(s) missing fresh pass evidence")
        for command in missing_fresh[:5]:
            findings.append(f"missing fresh validation pass: {command}")
    score = 100 - min(70, len(missing_fresh) * 12 if require_fresh else 0)
    if require_fresh and missing_fresh:
        score = min(score, 69)
    evidence = [
        f"{len(commands)} commands in {len(suites)} suite(s)",
        f"{len(fresh_commands)}/{len(commands)} command(s) have pass evidence within {freshness_days} day(s)",
    ]
    if latest_seen:
        evidence.append(f"{len(latest_seen)} command(s) have historical pass evidence")
    return dimension("validation", score, findings, evidence)


def score_workflow_profiles() -> dict:
    profiles = load_json(Path(".agent/workflow-profiles.json"))
    workflow = load_json(Path(".agent/workflow.json"))
    findings: list[str] = []
    configured = profiles.get("profiles", {})
    workflow_stages = set(workflow.get("stages", []))
    for name in ("tiny", "bugfix", "standard", "full"):
        spec = configured.get(name)
        if not spec:
            findings.append(f"missing workflow profile: {name}")
            continue
        for key in ("stages", "max_risk", "task_board_record", "review_gate_required", "feature_doc_templates", "required_evidence"):
            if key not in spec:
                findings.append(f"profile {name} missing {key}")
        for stage in spec.get("stages", []):
            if workflow_stages and stage not in workflow_stages:
                findings.append(f"profile {name} references unknown stage: {stage}")
        for stage in ("goal_refinement", "task_decomposition"):
            if stage not in spec.get("stages", []):
                findings.append(f"profile {name} missing {stage}")
    policy = profiles.get("policy", {})
    if policy.get("choose_lightest_profile_that_covers_risk") is not True:
        findings.append("profiles must choose the lightest profile that covers risk")
    if workflow.get("profile_source") != ".agent/workflow-profiles.json":
        findings.append("workflow does not point to workflow profiles")
    standard_docs = configured.get("standard", {}).get("feature_doc_templates", [])
    full_docs = configured.get("full", {}).get("feature_doc_templates", [])
    if len(standard_docs) < 4:
        findings.append("standard profile should require durable feature docs")
    if len(full_docs) < 7:
        findings.append("full profile should require all seven stage docs")
    gate = workflow.get("gates", {}).get("requirements_interview", {})
    for key in ("ask_one_question_at_a_time", "provide_recommended_answer_and_reason", "cross_check_user_claims_against_code_and_docs", "update_domain_glossary_for_new_or_ambiguous_terms"):
        if gate.get(key) is not True:
            findings.append(f"requirements_interview gate missing {key}")
    for profile_name in ("tiny", "bugfix", "standard", "full"):
        if configured.get(profile_name, {}).get("review_gate_required") is not True:
            findings.append(f"{profile_name} profile must require review gate")
    gates = workflow.get("gates", {})
    goal_refinement = gates.get("goal_refinement", {})
    technology_stack = gates.get("technology_stack_intake", {})
    task_decomposition = gates.get("task_decomposition", {})
    stage_loop = gates.get("stage_review_loop", {})
    review_fix = gates.get("review_fix_gate", {})
    completion = gates.get("completion_verification", {})
    for stage in ("goal_refinement", "task_decomposition"):
        if stage not in workflow_stages:
            findings.append(f"workflow missing lifecycle stage {stage}")
        if stage not in workflow.get("stage_definitions", {}):
            findings.append(f"workflow missing stage definition {stage}")
    if goal_refinement.get("preserve_raw_user_goal") is not True:
        findings.append("goal_refinement must preserve raw_user_goal")
    if goal_refinement.get("write_refined_goal_before_durable_goal") is not True:
        findings.append("goal_refinement must write refined goal before durable goal")
    if set(goal_refinement.get("required_for_profiles", [])) != {"bugfix", "standard", "full"}:
        findings.append("goal_refinement must apply to bugfix, standard, and full profiles")
    for key in ("ask_one_question_at_a_time", "provide_recommended_answer_and_reason", "do_not_rely_on_transient_chat"):
        if technology_stack.get(key) is not True:
            findings.append(f"technology_stack_intake missing {key}")
    if set(task_decomposition.get("required_for_profiles", [])) != {"tiny", "bugfix", "standard", "full"}:
        findings.append("task_decomposition must apply to all profiles")
    if set(stage_loop.get("required_for_profiles", [])) != {"standard", "full"}:
        findings.append("stage_review_loop must apply to standard and full profiles")
    if stage_loop.get("loop") != ["review", "fix", "re_review"]:
        findings.append("stage_review_loop must require review, fix, and re_review")
    for key in ("latest_stage_review_must_be_clean", "fix_requires_revalidation", "fix_requires_next_review_round"):
        if stage_loop.get(key) is not True:
            findings.append(f"stage_review_loop missing {key}")
    if review_fix.get("applies_to_stage_review_loop") is not True:
        findings.append("review_fix_gate must apply to stage review loops")
    if set(completion.get("review_fix_gate_required_for_profiles", [])) != {"tiny", "bugfix", "standard", "full"}:
        findings.append("completion gate must require review_fix_gate for all profiles")
    if completion.get("completed_spec_changes_must_be_archived") is not True:
        findings.append("completion gate must require completed spec changes to be archived")
    score = 100 - min(90, len(findings) * 15)
    evidence = [f"{len(configured)} profiles", f"default={profiles.get('default_profile') or 'none'}"]
    return dimension("workflow_profiles", score, findings, evidence)


def score_loop_engineering() -> dict:
    config = load_json(Path(".agent/loop-engineering.json"))
    workflow = load_json(Path(".agent/workflow.json"))
    evolution = load_json(Path(".agent/harness-evolution.json"))
    findings: list[str] = []
    if config.get("schema") != "agent-loop-engineering-v1":
        findings.append("invalid loop-engineering schema")
    policy = config.get("policy", {})
    for key in (
        "loop_contract_required_for_non_tiny_work",
        "primitive_selection_required_for_non_tiny_loops",
        "readiness_level_required_for_non_tiny_loops",
        "unattended_requires_attempt_ledger",
        "bounded_iterations_required",
        "observation_signal_required",
        "stop_conditions_required",
        "evidence_per_iteration_required",
        "attempt_ledger_required",
        "failure_signature_required",
        "same_failure_requires_strategy_change",
        "strategy_change_required_before_same_failure_retry",
        "quota_policy_required",
        "circuit_breaker_required",
        "budget_exhaustion_blocks_completion_claim",
        "human_interrupt_for_high_risk_or_destructive",
        "safe_fallback_lane_required",
        "loop_state_transitions_required",
        "resume_requires_last_committed_step_and_side_effect_boundary",
        "external_mutation_requires_idempotency_or_approval",
        "self_approval_is_not_release_evidence",
        "prevalidate_inputs_before_expensive_work",
        "failed_runs_exit_nonzero",
        "failed_runs_record_evidence_paths",
        "failed_optimization_cannot_be_improvement",
        "goal_based_requires_verifiable_convergence",
        "external_polling_must_not_be_goal_only",
        "scheduled_routine_requires_disable_policy",
        "scripted_workflow_requires_pilot_and_cross_check",
        "usage_evidence_required_for_expensive_or_autonomous_loops",
        "host_native_features_are_optional_mappings",
        "dependency_free_control_plane",
    ):
        if policy.get(key) is not True:
            findings.append(f"loop policy missing {key}")
    if not isinstance(policy.get("repeat_failure_threshold"), int) or policy.get("repeat_failure_threshold") < 2:
        findings.append("repeat_failure_threshold must be >= 2")
    for source in config.get("sources", []):
        if isinstance(source, dict):
            if source.get("source_status") not in {"verified", "partial", "blocked"}:
                findings.append("loop sources must record source_status")
            if source.get("dependency_policy") != "source_only":
                findings.append("loop sources must be source_only")
    source_status_by_url = {
        str(source.get("url", "")): str(source.get("source_status", ""))
        for source in config.get("sources", [])
        if isinstance(source, dict)
    }
    for url in (
        "https://claude.com/blog/getting-started-with-loops",
        "https://code.claude.com/docs/en/goal",
        "https://code.claude.com/docs/en/scheduled-tasks",
        "https://code.claude.com/docs/en/workflows",
    ):
        if source_status_by_url.get(url) != "verified":
            findings.append(f"loop source must be verified: {url}")
    if source_status_by_url.get("https://x.com/ClaudeDevs/article/2074208949205881033") != "blocked":
        findings.append("inaccessible X article must be recorded as blocked")
    selection = config.get("primitive_selection", {})
    if not isinstance(selection, dict):
        findings.append("missing primitive_selection")
        selection = {}
    if selection.get("required_for_non_tiny_work") is not True:
        findings.append("primitive selection must be required for non-tiny work")
    required_selection_fields = {"primitive", "trigger_source", "stop_condition", "task_shape", "evidence_quality", "durability_requirement", "misuse_check"}
    if not required_selection_fields.issubset(set(selection.get("selection_fields", []))):
        findings.append("primitive selection missing required fields")
    primitives = selection.get("primitives", {})
    required_primitives = {"turn_based", "goal_based", "time_based", "scheduled_routine", "scripted_workflow"}
    for primitive in required_primitives:
        spec = primitives.get(primitive, {})
        if not spec:
            findings.append(f"missing primitive {primitive}")
            continue
        for key in ("trigger_source", "stop_condition", "task_shape", "required_evidence", "misuse_signals"):
            if not spec.get(key):
                findings.append(f"{primitive} missing {key}")
    goal_evidence = set(primitives.get("goal_based", {}).get("required_evidence", []))
    if not {"measurable_done_state", "proof_method", "protected_constraints", "turn_or_time_cap", "evidence_path", "evaluator_boundary", "stop_reason"}.issubset(goal_evidence):
        findings.append("goal_based primitive missing proof evidence fields")
    routine_evidence = set(primitives.get("scheduled_routine", {}).get("required_evidence", []))
    if "disable_or_expiry_policy" not in routine_evidence:
        findings.append("scheduled_routine primitive must require disable_or_expiry_policy")
    scripted_evidence = set(primitives.get("scripted_workflow", {}).get("required_evidence", []))
    if not {"pilot_scope", "cross_check_strategy", "cost_or_usage_evidence"}.issubset(scripted_evidence):
        findings.append("scripted_workflow primitive missing pilot/cross-check/cost evidence")
    external_polling = selection.get("external_polling_policy", {})
    if set(external_polling.get("allowed_primitives", [])) != {"time_based", "scheduled_routine"}:
        findings.append("external polling must use time_based or scheduled_routine")
    if external_polling.get("forbidden_as_goal_only") is not True:
        findings.append("external polling must not be goal-only")
    if external_polling.get("requires_observed_signal_and_check_frequency") is not True:
        findings.append("external polling must record signal and check frequency")
    host_mapping = selection.get("host_feature_mapping", {})
    if host_mapping.get("dependency_required") is not False:
        findings.append("host-native loop features must be optional mappings")
    goal_contract = config.get("goal_contract", {})
    if not isinstance(goal_contract, dict):
        findings.append("missing loop goal_contract")
        goal_contract = {}
    if not {"raw_goal", "refined_goal", "measurable_done_state", "proof_method", "protected_constraints", "turn_or_time_cap", "evidence_path", "owner_role", "evaluator_boundary", "stop_reason"}.issubset(set(goal_contract.get("goal_based_required_fields", []))):
        findings.append("loop goal_contract missing goal-based required fields")
    if not {"evaluator_type", "can_read_files", "can_run_tools", "evidence_required_for_judgment"}.issubset(set(goal_contract.get("evaluator_boundary_fields", []))):
        findings.append("loop goal_contract missing evaluator boundary fields")
    if goal_contract.get("self_approval_forbidden") is not True:
        findings.append("loop goal_contract must forbid self-approval")
    if goal_contract.get("cap_exhaustion_is_not_success") is not True:
        findings.append("loop goal_contract must reject cap exhaustion as success")
    routine = config.get("scheduled_routine", {})
    if not isinstance(routine, dict):
        findings.append("missing scheduled_routine")
        routine = {}
    routine_required = {"routine_id_or_name", "trigger_type", "cadence_or_event_source", "run_location", "permission_mode", "target_resources", "credential_boundary", "per_run_stop_condition", "disable_or_expiry_policy", "owner", "evidence_path"}
    if not routine_required.issubset(set(routine.get("required_fields", []))):
        findings.append("scheduled_routine missing required metadata fields")
    if routine.get("session_local_interval_polling_remains") != "time_based":
        findings.append("session-local interval polling must remain time_based")
    if routine.get("missing_approval_behavior") != "fail_closed":
        findings.append("scheduled_routine missing approvals must fail closed")
    workflow_meta = config.get("scripted_workflow", {})
    if not isinstance(workflow_meta, dict):
        findings.append("missing scripted_workflow")
        workflow_meta = {}
    scripted_required = {"script_artifact_path_or_source", "phase_plan", "worker_role_boundaries", "concurrency_or_agent_cap", "pilot_scope", "cross_check_or_adversarial_review_strategy", "state_or_resume_boundary", "save_or_reuse_policy", "cost_or_usage_evidence", "intermediate_result_storage"}
    if not scripted_required.issubset(set(workflow_meta.get("required_fields", []))):
        findings.append("scripted_workflow missing required metadata fields")
    if workflow_meta.get("broad_execution_requires_pilot") is not True:
        findings.append("scripted_workflow must require a pilot")
    if workflow_meta.get("pilot_exception_requires_review") is not True:
        findings.append("scripted_workflow pilot exception must require review")
    if workflow_meta.get("host_runtime_required") is not False:
        findings.append("scripted_workflow must not require host-specific runtime")
    usage = config.get("usage_evidence", {})
    if not isinstance(usage, dict):
        findings.append("missing usage_evidence")
        usage = {}
    if not {"assisted", "unattended", "scheduled_routine", "scripted_workflow"}.issubset(set(usage.get("required_for", []))):
        findings.append("usage_evidence must apply to assisted, unattended, scheduled_routine, and scripted_workflow")
    if not {"turn_count", "elapsed_time", "token_or_cost_summary", "agent_or_worker_count", "validation_result", "stop_reason", "human_interrupt_or_approval_evidence"}.issubset(set(usage.get("fields", []))):
        findings.append("usage_evidence missing required fields")
    if usage.get("unavailable_metrics_policy") != "record_unavailable_do_not_guess":
        findings.append("usage evidence must record unavailable metrics instead of guessing")
    if "cap_exhausted" not in set(usage.get("valid_stop_reasons", [])):
        findings.append("usage evidence stop reasons must include cap_exhausted")
    if usage.get("cap_exhaustion_success") is not False:
        findings.append("cap exhaustion must not count as success")
    readiness = config.get("readiness_levels", {})
    if set(readiness) != {"manual", "report_only", "assisted", "unattended"}:
        findings.append("readiness levels must be manual/report_only/assisted/unattended")
    unattended_controls = set(readiness.get("unattended", {}).get("required_controls", []))
    for control in ("attempt_ledger", "failure_signature", "quota_policy", "circuit_breaker", "human_interrupt_points", "non_empty_stop_conditions", "state_transition_contract", "safe_stop"):
        if control not in unattended_controls:
            findings.append(f"unattended readiness missing {control}")
    ledger = config.get("attempt_ledger", {})
    required_fields = set(ledger.get("required_fields", [])) if isinstance(ledger, dict) else set()
    for field in ("loop_id", "iteration_id", "readiness_level", "owner_role", "action_summary", "evidence_paths", "result_status", "failure_signature", "strategy_changed", "budget_usage_summary", "next_transition"):
        if field not in required_fields:
            findings.append(f"attempt ledger missing {field}")
    signature = ledger.get("failure_signature_policy", {}) if isinstance(ledger, dict) else {}
    if signature.get("stable_signature_required") is not True:
        findings.append("attempt ledger must require stable signatures")
    if signature.get("same_signature_retry_requires_strategy_changed") is not True:
        findings.append("same-signature retry must require strategy change")
    quota = config.get("quota_policy", {})
    for key in ("iteration_count_required", "elapsed_time_budget_required", "token_budget_required_when_available", "cost_budget_required_when_available"):
        if quota.get(key) is not True:
            findings.append(f"quota policy missing {key}")
    if quota.get("budget_exhaustion_transition") != "replan":
        findings.append("budget exhaustion must transition to replan")
    breaker = config.get("circuit_breakers", {})
    protected = set(breaker.get("protected_actions", []))
    for action in ("destructive", "production_write", "release", "billing", "credential", "privileged", "external_mutation"):
        if action not in protected:
            findings.append(f"circuit breaker missing {action}")
    if breaker.get("missing_approval_behavior") != "fail_closed":
        findings.append("missing approval must fail closed")
    fallback = config.get("safe_fallback_lane", {})
    if fallback.get("must_preserve_human_gate") is not True:
        findings.append("safe fallback must preserve human gate")
    if not fallback.get("allowed_work") or not fallback.get("forbidden_work"):
        findings.append("safe fallback must list allowed and forbidden work")
    transitions = config.get("state_transitions", {})
    states = set(transitions.get("states", []))
    required_states = {"pending", "running", "waiting_human", "waiting_tool", "paused", "retrying", "replan", "blocked", "completed", "failed", "cancelled"}
    if not required_states.issubset(states):
        findings.append("state transitions missing required loop states")
    exhaustion = set(transitions.get("exhaustion_transitions", []))
    if not exhaustion or not exhaustion.issubset({"replan", "blocked", "waiting_human", "failed", "accepted_exception"}):
        findings.append("loop exhaustion transitions must stop into safe terminal/replan states")
    resume_requirements = set(transitions.get("resume_requirements", []))
    if not {"last_committed_step", "external_side_effect_boundary", "idempotency_or_approval_for_external_mutation"}.issubset(resume_requirements):
        findings.append("resume requirements must protect committed steps and external side effects")
    boundary = config.get("dependency_boundary", {})
    if boundary.get("external_projects_are_sources_only") is not True:
        findings.append("external loop projects must be source-only")
    if boundary.get("runtime_dependencies_allowed") not in ([], None):
        findings.append("loop control plane must not require runtime dependencies")
    if boundary.get("local_validation_requires_network") is not False:
        findings.append("loop control plane local validation must not require network")
    loop_types = config.get("loop_types", {})
    required_types = ("work_loop", "review_fix_loop", "debugging_loop", "eval_optimization_loop", "session_recovery_loop")
    for loop_type in required_types:
        spec = loop_types.get(loop_type, {})
        if not spec:
            findings.append(f"missing loop type {loop_type}")
            continue
        if not isinstance(spec.get("default_iteration_budget"), int) or spec.get("default_iteration_budget") < 1:
            findings.append(f"{loop_type} budget must be positive")
        for key in ("sequence", "observation_signals", "stop_conditions", "evidence"):
            if not isinstance(spec.get(key), list) or not spec.get(key):
                findings.append(f"{loop_type} missing {key}")
        if loop_type == "eval_optimization_loop":
            if "prevalidate" not in spec.get("sequence", []):
                findings.append("eval optimization loop must prevalidate inputs")
            if "failed_run" not in spec.get("stop_conditions", []):
                findings.append("eval optimization loop must stop on failed runs")
    gate = workflow.get("gates", {}).get("loop_engineering", {})
    if set(gate.get("required_for_profiles", [])) != {"standard", "full"}:
        findings.append("workflow loop_engineering gate must apply to standard and full profiles")
    if gate.get("policy") != ".agent/loop-engineering.json":
        findings.append("workflow loop_engineering gate must point to .agent/loop-engineering.json")
    for key in (
        "primitive_selection_required",
        "loop_contract_required",
        "readiness_level_required",
        "attempt_ledger_required",
        "failure_signature_required",
        "iteration_budget_required",
        "quota_policy_required",
        "circuit_breaker_required",
        "observation_signal_required",
        "stop_conditions_required",
        "evidence_per_iteration_required",
        "safe_fallback_lane_required",
        "state_transition_contract_required",
        "same_failure_requires_strategy_change",
        "repeat_failures_promote_to_harness_evolution",
        "human_interrupt_for_high_risk_or_destructive",
        "self_approval_forbidden",
        "goal_based_requires_verifiable_convergence",
        "external_polling_must_not_be_goal_only",
        "scheduled_routine_requires_disable_policy",
        "scripted_workflow_requires_pilot_and_cross_check",
        "usage_evidence_required_for_expensive_or_autonomous_loops",
        "host_native_features_optional_mappings",
        "dependency_free_control_plane",
    ):
        if gate.get(key) is not True:
            findings.append(f"workflow loop_engineering gate missing {key}")
    if "loop_gap" not in evolution.get("incident_categories", {}):
        findings.append("harness evolution missing loop_gap category")
    if ".agent/loop-engineering.json" not in evolution.get("promotion_targets", {}).get("loop_gap", []):
        findings.append("loop_gap promotion targets must include .agent/loop-engineering.json")
    score = 100 - min(90, len(findings) * 15)
    evidence = [
        f"{len(loop_types)} loop type(s)",
        f"{len(readiness)} readiness level(s)",
        f"{len(primitives)} loop primitive(s)",
        f"{len(required_fields)} attempt ledger field(s)",
    ]
    return dimension("loop_engineering", score, findings, evidence)


def profile_requires_review_gate(profile_name: str, profile: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("done_requires_review_gate_pass_for_profiles", []))
    return profile.get("review_gate_required") is True or profile_name in required_profiles


def normalized_review_gate(item: dict, profile: dict, policy: dict) -> dict:
    required = profile_requires_review_gate(str(item.get("profile", "")), profile, policy)
    gate = item.get("review_gate")
    if not isinstance(gate, dict):
        gate = {}
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "latest_review": "",
        "latest_fix": "",
        "open_findings": [],
        "accepted_exception": "",
    }
    merged.update(gate)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_findings"), list):
        merged["open_findings"] = [str(merged.get("open_findings"))]
    return merged


def review_gate_findings(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    findings: list[str] = []
    gate = normalized_review_gate(item, profile, policy)
    if gate.get("status") not in REVIEW_STATUSES:
        findings.append(f"{task_id} review_gate invalid status: {gate.get('status')}")
    open_findings = [finding for finding in gate.get("open_findings", []) if str(finding).strip()]
    if item.get("state") == "done" and gate.get("required"):
        pass_status = policy.get("review_gate_pass_status", "pass")
        if gate.get("status") != pass_status:
            findings.append(f"{task_id} done without review_gate status {pass_status}")
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            findings.append(f"{task_id} done with open review findings")
        latest_review = str(gate.get("latest_review", "")).strip()
        if not latest_review:
            findings.append(f"{task_id} done without review_gate latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not existing_repo_file(latest_review):
            findings.append(f"{task_id} review_gate latest_review must be an existing repository-local file: {latest_review}")
    return findings


def stage_reviews(item: dict) -> dict:
    reviews = item.get("stage_reviews")
    return reviews if isinstance(reviews, dict) else {}


def stage_review_required_for_profile(profile_name: str, policy: dict) -> bool:
    required_profiles = set(policy.get("stage_review_loop_required_for_profiles", []))
    return profile_name in required_profiles


def stage_review_required_stages(policy: dict) -> list[str]:
    configured = policy.get("stage_review_required_before_stage_exit")
    if isinstance(configured, list) and configured:
        return [str(stage) for stage in configured]
    return list(STAGE_REVIEW_REQUIRED_STAGES)


def required_stage_reviews_for_item(item: dict, profile: dict, policy: dict) -> list[str]:
    profile_name = str(item.get("profile", ""))
    if not stage_review_required_for_profile(profile_name, policy):
        return []
    stages = [str(stage) for stage in profile.get("stages", [])]
    current_stage = str(item.get("current_stage", ""))
    required_before_exit = set(stage_review_required_stages(policy))
    if item.get("state") in {"done", "archived"}:
        exited = stages
    elif current_stage in stages:
        exited = stages[: stages.index(current_stage)]
    else:
        exited = []
    return [stage for stage in exited if stage in required_before_exit]


def stage_review_findings(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    findings: list[str] = []
    if not isinstance(item.get("stage_reviews", {}), dict):
        return [f"{task_id} stage_reviews must be an object"]
    reviews = stage_reviews(item)
    pass_status = policy.get("review_gate_pass_status", "pass")
    for stage in required_stage_reviews_for_item(item, profile, policy):
        review = reviews.get(stage)
        if not isinstance(review, dict):
            findings.append(f"{task_id} missing stage review for exited stage: {stage}")
            continue
        status = review.get("status")
        if status not in REVIEW_STATUSES:
            findings.append(f"{task_id} stage review {stage} invalid status: {status}")
        if status != pass_status:
            findings.append(f"{task_id} stage review {stage} must be {pass_status}")
        open_findings = [finding for finding in review.get("open_findings", []) if str(finding).strip()]
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            findings.append(f"{task_id} stage review {stage} has open findings")
        latest_review = str(review.get("latest_review", "")).strip()
        if not latest_review:
            findings.append(f"{task_id} stage review {stage} missing latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not existing_repo_file(latest_review):
            findings.append(f"{task_id} stage review {stage} latest_review must be an existing repository-local file: {latest_review}")
    return findings


def task_risk_findings(task_id: str, item: dict, profile: dict) -> list[str]:
    risk = str(item.get("risk", ""))
    max_risk = str(profile.get("max_risk", ""))
    if risk not in RISK_ORDER:
        return [f"{task_id} invalid risk: {risk}"]
    if max_risk not in RISK_ORDER:
        return [f"{task_id} profile invalid max_risk: {max_risk}"]
    if RISK_ORDER[risk] > RISK_ORDER[max_risk]:
        return [f"{task_id} risk {risk} exceeds profile {item.get('profile')} max_risk {max_risk}"]
    return []


def human_review_findings(task_id: str, item: dict, policy: dict) -> list[str]:
    if str(item.get("risk", "")) not in set(policy.get("human_review_required_for_risks", ["high", "critical"])):
        return []
    legacy = policy.get("human_review_legacy_exemptions", [])
    exemption = next((entry for entry in legacy if isinstance(entry, dict) and entry.get("task_id") == task_id), None)
    enforcement_started = parse_utc(policy.get("human_review_enforcement_started_at"))
    completed_at = parse_utc(item.get("updated_at"))
    if exemption is not None and item.get("state") in {"done", "archived"} and completed_at and enforcement_started and completed_at < enforcement_started:
        return []
    if item.get("state") not in set(policy.get("human_review_required_before_states", ["done", "archived"])) and item.get("current_stage") not in set(policy.get("human_review_required_before_stages", ["verification", "handoff", "finish"])):
        return []
    review = stage_reviews(item).get("human_review")
    if not isinstance(review, dict):
        return [f"{task_id} requires human_review evidence for risk {item.get('risk')}"]
    findings: list[str] = []
    if review.get("status") != policy.get("review_gate_pass_status", "pass"):
        findings.append(f"{task_id} human_review must be pass")
    if any(str(finding).strip() for finding in review.get("open_findings", [])):
        findings.append(f"{task_id} human_review has open findings")
    latest_review = str(review.get("latest_review", "")).strip()
    if not latest_review:
        findings.append(f"{task_id} human_review missing latest_review")
    elif policy.get("review_gate_latest_review_must_exist") is True and not existing_repo_file(latest_review):
        findings.append(f"{task_id} human_review latest_review must be an existing repository-local file: {latest_review}")
    evidence = review.get("evidence")
    if not isinstance(evidence, dict):
        return findings + [f"{task_id} human_review evidence must be an object"]
    for field in policy.get("human_review_required_fields") or DEFAULT_HUMAN_REVIEW_FIELDS:
        value = evidence.get(field)
        if field in {"files_reviewed", "high_risk_paths_checked"}:
            if not isinstance(value, list) or not any(str(entry).strip() for entry in value):
                findings.append(f"{task_id} human_review evidence missing {field}")
        elif not str(value or "").strip():
            findings.append(f"{task_id} human_review evidence missing {field}")
    if evidence.get("reviewer_type") != "human":
        findings.append(f"{task_id} human_review reviewer_type must be human")
    return findings


def normalized_requirements(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    requirements = item.get("requirements")
    if not isinstance(requirements, dict):
        requirements = {}
    required = profile_name != "tiny"
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "shared_understanding": "",
        "domain_glossary_updated": False,
        "code_docs_cross_checked": False,
        "open_questions": [],
    }
    merged.update(requirements)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_questions"), list):
        merged["open_questions"] = [str(merged.get("open_questions"))]
    return merged


def default_goal_contract(task_id: str = "", spec_change: str = "") -> dict:
    return {
        "raw_user_goal": "",
        "refined_goal": "",
        "refinement_rationale": "",
        "user_confirmation_status": "pending",
        "objective": "",
        "user_approved_outcome": "",
        "non_goals": [],
        "constraints": [],
        "success_evidence": [],
        "stop_conditions": [],
        "current_decision_summary": "",
        "open_decisions": [],
        "linked_task_id": task_id,
        "linked_spec_change_id": spec_change,
    }


def normalized_goal_contract(item: dict) -> dict:
    contract = item.get("goal_contract")
    if not isinstance(contract, dict):
        contract = {}
    merged = default_goal_contract(str(item.get("id", "")), str(item.get("spec_change", "")))
    merged.update(contract)
    for field in GOAL_CONTRACT_LIST_FIELDS:
        value = merged.get(field)
        if value is None or value == "":
            merged[field] = []
        elif not isinstance(value, list):
            merged[field] = [str(value)]
    return merged


def default_task_decomposition(profile_name: str) -> dict:
    return {
        "required": True,
        "status": "pending",
        "summary": "",
        "next_task": "",
        "subtasks": [],
        "dependencies": [],
        "evidence_path": "",
        "no_task_board_tiny_evidence": "" if profile_name == "tiny" else "not-applicable",
    }


def normalized_task_decomposition(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    decomposition = item.get("task_decomposition")
    if not isinstance(decomposition, dict):
        decomposition = {}
    merged = default_task_decomposition(profile_name)
    merged.update(decomposition)
    merged["required"] = bool(merged.get("required") is not False)
    if merged.get("status") not in DECOMPOSITION_STATUSES:
        merged["status"] = "pending" if merged["required"] else "not-required"
    for field in ("subtasks", "dependencies"):
        if not isinstance(merged.get(field), list):
            merged[field] = [str(merged.get(field))]
    return merged


def goal_contract_required(item: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("goal_contract_required_for_profiles", ["standard", "full"]))
    required_states = set(policy.get("goal_contract_required_states", ["active", "review", "done"]))
    required_stages = set(policy.get("goal_contract_required_before_stages", []))
    return str(item.get("profile", "")) in required_profiles and (
        str(item.get("state", "")) in required_states or str(item.get("current_stage", "")) in required_stages
    )


def goal_contract_findings(task_id: str, item: dict, policy: dict) -> list[str]:
    findings: list[str] = []
    if not goal_contract_required(item, policy):
        return findings
    contract = normalized_goal_contract(item)
    required_fields = policy.get("goal_contract_required_fields") or list(GOAL_CONTRACT_REQUIRED_FIELDS)
    for field in required_fields:
        value = contract.get(field)
        if field in GOAL_CONTRACT_LIST_FIELDS:
            present = isinstance(value, list) and (
                field not in GOAL_CONTRACT_NONEMPTY_LIST_FIELDS or any(str(entry).strip() for entry in value)
            )
            if not present:
                findings.append(f"{task_id} goal_contract missing {field}")
        elif not str(value or "").strip():
            findings.append(f"{task_id} goal_contract missing {field}")
    if contract.get("linked_task_id") and contract.get("linked_task_id") != task_id:
        findings.append(f"{task_id} goal_contract linked_task_id must match task id")
    if contract.get("user_confirmation_status") not in GOAL_CONFIRMATION_STATUSES:
        findings.append(f"{task_id} goal_contract user_confirmation_status is invalid")
    return findings


def task_decomposition_findings(task_id: str, item: dict, policy: dict) -> list[str]:
    findings: list[str] = []
    decomposition = normalized_task_decomposition(item)
    if decomposition.get("status") not in DECOMPOSITION_STATUSES:
        findings.append(f"{task_id} task_decomposition invalid status: {decomposition.get('status')}")
    if not decomposition.get("required"):
        return findings
    complete_before_done = policy.get("task_decomposition_complete_before_done") is True
    protected = set(policy.get("task_decomposition_required_before_stages", []))
    current_stage = str(item.get("current_stage", ""))
    must_be_complete = (item.get("state") == "done" and complete_before_done) or current_stage in protected
    if not must_be_complete:
        return findings
    if decomposition.get("status") != "complete":
        findings.append(f"{task_id} task_decomposition must be complete before {current_stage or item.get('state')}")
    has_evidence = any(str(decomposition.get(field, "")).strip() for field in TASK_DECOMPOSITION_EVIDENCE_FIELDS)
    has_subtasks = any(str(entry).strip() for entry in decomposition.get("subtasks", []))
    if not has_evidence and not has_subtasks:
        findings.append(f"{task_id} task_decomposition missing summary, next_task, evidence_path, or subtasks")
    return findings


def requirement_findings(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    findings: list[str] = []
    requirements = normalized_requirements(item)
    if requirements.get("status") not in REQUIREMENT_STATUSES:
        findings.append(f"{task_id} requirements invalid status: {requirements.get('status')}")
    if not requirements.get("required"):
        return findings
    protected = set(profile.get("requirement_protected_stages", [])) or REQUIREMENT_PROTECTED_STAGES
    state_done = item.get("state") == "done" and policy.get("requirements_complete_before_done") is True
    stage_protected = item.get("current_stage") in protected and policy.get("requirements_complete_before_protected_stages") is True
    if not state_done and not stage_protected:
        return findings
    if requirements.get("status") != "complete":
        findings.append(f"{task_id} requirements must be complete before {item.get('current_stage') or item.get('state')}")
    if not str(requirements.get("shared_understanding", "")).strip():
        findings.append(f"{task_id} requirements missing shared_understanding")
    if requirements.get("domain_glossary_updated") is not True:
        findings.append(f"{task_id} requirements must confirm domain_glossary_updated")
    if requirements.get("code_docs_cross_checked") is not True:
        findings.append(f"{task_id} requirements must confirm code_docs_cross_checked")
    docs_path = item.get("docs_path")
    if docs_path and not (Path(docs_path) / "01_REQUIREMENT_ANALYSIS.md").exists():
        findings.append(f"{task_id} missing requirement analysis document")
    return findings


def score_task_board() -> dict:
    board = load_json(Path(".agent/task-board.json"))
    profiles = load_json(Path(".agent/workflow-profiles.json"))
    findings: list[str] = []
    if board.get("schema") != "agent-task-board-v1":
        findings.append("invalid task-board schema")
    for field in ("id", "title", "state", "risk", "profile", "current_stage", "docs_path", "requirements", "task_decomposition", "delivery_conclusion", "review_gate", "stage_reviews", "related_tasks"):
        if field not in board.get("required_fields", []):
            findings.append(f"task board missing required field declaration: {field}")
    policy = board.get("policy", {})
    if policy.get("non_tiny_work_requires_task") is not True:
        findings.append("task board must require records for non-tiny work")
    if policy.get("new_session_reads_board_before_edits") is not True:
        findings.append("new sessions must read task board before edits")
    if set(policy.get("done_requires_review_gate_pass_for_profiles", [])) != {"tiny", "bugfix", "standard", "full"}:
        findings.append("task board must require review_gate pass for all task profiles")
    if set(policy.get("goal_contract_required_for_profiles", [])) != {"bugfix", "standard", "full"}:
        findings.append("task board must require refined goal contracts for bugfix, standard, and full profiles")
    if set(policy.get("goal_contract_required_states", [])) != {"active", "review", "done"}:
        findings.append("task board must require refined goal contracts for active, review, and done states")
    if not {"plan", "implementation", "verification", "handoff"}.issubset(set(policy.get("goal_contract_required_before_stages", []))):
        findings.append("task board must require refined goal contracts before protected implementation stages")
    if set(policy.get("goal_contract_required_fields", [])) != set(GOAL_CONTRACT_REQUIRED_FIELDS):
        findings.append("task board goal_contract required fields must match generated policy")
    if set(policy.get("task_decomposition_required_for_profiles", [])) != {"tiny", "bugfix", "standard", "full"}:
        findings.append("task board must require task_decomposition for all task profiles")
    if policy.get("task_decomposition_complete_before_done") is not True:
        findings.append("task board must require task_decomposition before done")
    if policy.get("review_gate_open_findings_must_be_empty") is not True:
        findings.append("task board must require empty review_gate open findings")
    if policy.get("review_fix_loop_required_at_stage_exit") is not True:
        findings.append("task board must require review-fix loops at stage exit")
    if set(policy.get("stage_review_loop_required_for_profiles", [])) != {"standard", "full"}:
        findings.append("task board must require stage review loops for standard and full profiles")
    if set(policy.get("human_review_required_for_risks", [])) != {"high", "critical"}:
        findings.append("task board must require human review for high and critical risks")
    if set(policy.get("human_review_required_before_states", [])) != {"done", "archived"}:
        findings.append("task board human review protected states must be done and archived")
    if set(policy.get("human_review_required_before_stages", [])) != {"verification", "handoff", "finish"}:
        findings.append("task board human review protected stages must be verification, handoff, and finish")
    if set(policy.get("human_review_required_fields", [])) != set(DEFAULT_HUMAN_REVIEW_FIELDS):
        findings.append("task board human review required fields must match generated policy")
    legacy = policy.get("human_review_legacy_exemptions", [])
    if not isinstance(legacy, list):
        findings.append("task board human_review_legacy_exemptions must be a list")
        legacy = []
    items_by_id = {str(item.get("id", "")): item for item in board.get("items", []) if isinstance(item, dict)}
    enforcement_started = parse_utc(policy.get("human_review_enforcement_started_at"))
    if enforcement_started is None or enforcement_started > datetime.now(timezone.utc):
        findings.append("task board human_review_enforcement_started_at must be a valid non-future UTC timestamp")
    legacy_ids: set[str] = set()
    for entry in legacy:
        if not isinstance(entry, dict):
            findings.append("task board human review legacy exemption must be an object")
            continue
        task_id = str(entry.get("task_id", ""))
        if not task_id or task_id in legacy_ids:
            findings.append(f"task board human review legacy exemption has missing or duplicate task_id: {task_id}")
            continue
        legacy_ids.add(task_id)
        task = items_by_id.get(task_id)
        if not task or task.get("state") not in {"done", "archived"}:
            findings.append(f"task board human review legacy exemption must reference a terminal task: {task_id}")
        elif enforcement_started is None or parse_utc(task.get("updated_at")) is None or parse_utc(task.get("updated_at")) >= enforcement_started:
            findings.append(f"task board human review legacy exemption must predate policy enforcement: {task_id}")
        if not str(entry.get("reason", "")).strip():
            findings.append(f"task board human review legacy exemption missing reason: {task_id}")
        if not existing_repo_file(str(entry.get("evidence", "")).strip()):
            findings.append(f"task board human review legacy exemption evidence must be an existing repository-local file: {task_id}")
    if not Path("docs/features/INDEX.md").exists():
        findings.append("missing docs/features/INDEX.md")
    if not Path("scripts/agent_task.py").exists():
        findings.append("missing scripts/agent_task.py")
    states = set(board.get("states", []))
    profile_names = set(profiles.get("profiles", {}))
    policy = board.get("policy", {})
    ids: set[str] = set()
    for item in board.get("items", []):
        task_id = item.get("id", "unknown")
        if task_id in ids:
            findings.append(f"duplicate task id: {task_id}")
        ids.add(task_id)
        if item.get("state") not in states:
            findings.append(f"{task_id} has invalid state")
        if item.get("profile") not in profile_names:
            findings.append(f"{task_id} has invalid profile")
            continue
        profile = profiles.get("profiles", {}).get(item.get("profile"), {})
        allowed_stages = set(profile.get("stages", []))
        if allowed_stages and item.get("current_stage") not in allowed_stages:
            findings.append(f"{task_id} has invalid current_stage for profile {item.get('profile')}: {item.get('current_stage')}")
        findings.extend(task_risk_findings(task_id, item, profile))
        if item.get("state") == "done" and policy.get("done_requires_delivery_conclusion") is True:
            if not str(item.get("delivery_conclusion", "")).strip():
                findings.append(f"{task_id} is done without delivery_conclusion")
        findings.extend(requirement_findings(task_id, item, profile, policy))
        findings.extend(goal_contract_findings(task_id, item, policy))
        findings.extend(task_decomposition_findings(task_id, item, policy))
        findings.extend(review_gate_findings(task_id, item, profile, policy))
        findings.extend(stage_review_findings(task_id, item, profile, policy))
        findings.extend(human_review_findings(task_id, item, policy))
        docs_path = item.get("docs_path")
        if profile.get("feature_doc_templates") and (not docs_path or not Path(docs_path).exists()):
            findings.append(f"{task_id} docs_path missing or absent: {docs_path}")
    score = 100 - min(90, len(findings) * 15)
    evidence = [f"{len(board.get('items', []))} task(s)", f"{len(states)} states"]
    return dimension("task_board", score, findings, evidence)


def score_role_contracts() -> dict:
    contracts = load_json(Path(".agent/role-contracts.json"))
    subagent_path = Path(".agent/subagents.json")
    subagents = load_json(subagent_path) if subagent_path.exists() else {}
    workflow = load_json(Path(".agent/workflow.json"))
    findings: list[str] = []
    if contracts.get("schema") != "agent-role-contracts-v1":
        findings.append("invalid role-contracts schema")
    if contracts.get("policy", {}).get("finder_cannot_fix") is not True:
        findings.append("role contracts must enforce finder_cannot_fix")
    if contracts.get("separation_of_duties", {}).get("finder_cannot_modify_files") is not True:
        findings.append("finder roles must not modify files")
    for role in ("coordinator", "worker", "verifier", "spec_reviewer", "quality_reviewer", "reviewer"):
        contract = contracts.get("contracts", {}).get(role, {})
        if not contract:
            findings.append(f"missing role contract: {role}")
            continue
        for key in ("owner_for_stages", "must_read", "may_write", "must_write", "forbidden_actions", "blocking_conditions"):
            if key not in contract:
                findings.append(f"{role} missing {key}")
    if subagent_path.exists() and subagents.get("role_contracts") != ".agent/role-contracts.json":
        findings.append("subagent policy does not point to role contracts")
    if workflow.get("role_contracts") != ".agent/role-contracts.json":
        findings.append("workflow does not point to role contracts")
    stage_defs = workflow.get("stage_definitions", {})
    for stage in ("implementation", "spec_review", "quality_review", "verification"):
        if not stage_defs.get(stage, {}).get("owner_role"):
            findings.append(f"workflow stage missing owner role: {stage}")
    score = 100 - min(90, len(findings) * 12)
    evidence = [f"{len(contracts.get('contracts', {}))} contracts", f"{len(stage_defs)} stage definitions"]
    return dimension("role_contracts", score, findings, evidence)


def score_mechanical_verification() -> dict:
    config = load_json(Path(".agent/mechanical-checks.json"))
    baselines = load_json(Path(".agent/baselines.json"))
    findings: list[str] = []
    if config.get("schema") != "agent-mechanical-checks-v1":
        findings.append("invalid mechanical-checks schema")
    checks = config.get("checks", {})
    for name in (
        "json_integrity",
        "jsonl_integrity",
        "required_paths",
        "feature_templates",
        "task_board",
        "role_contracts",
        "loop_engineering",
        "manifest",
        "skill_hygiene",
        "skill_runtime",
        "project_blueprint",
        "mcp_policy",
        "template_rendering",
        "test_baseline",
        "markdown_links",
        "skill_optimization",
    ):
        if name not in checks:
            findings.append(f"missing mechanical check: {name}")
    if checks.get("json_integrity", {}).get("fail_on_invalid") is not True:
        findings.append("json_integrity must fail on invalid JSON")
    if checks.get("required_paths", {}).get("fail_on_missing") is not True:
        findings.append("required_paths must fail on missing paths")
    if checks.get("role_contracts", {}).get("enforce_finder_cannot_fix") is not True:
        findings.append("role contract check must enforce finder_cannot_fix")
    if baselines.get("schema") != "agent-baselines-v1":
        findings.append("invalid baselines schema")
    if not Path("scripts/agent_verify.py").exists():
        findings.append("missing scripts/agent_verify.py")
    if not Path(".agent/baselines").exists():
        findings.append("missing .agent/baselines directory")
    policy = config.get("baseline_policy", {})
    if policy.get("fail_on_new_invalid_json") is not True:
        findings.append("baseline policy must fail on new invalid JSON")
    snapshot, error = run_json_command([sys.executable, "scripts/agent_verify.py", "snapshot", "--json"])
    hard_count = 0
    soft_count = 0
    if error:
        findings.append(f"agent_verify snapshot unavailable: {error}")
        hard_count += 1
    else:
        counts = snapshot.get("counts", {})
        hard_keys = (
            "invalid_json",
            "invalid_jsonl",
            "missing_required_paths",
            "missing_feature_templates",
            "task_board",
            "role_contracts",
            "governance_configs",
            "template_rendering",
            "skill_optimization",
        )
        soft_keys = ("broken_local_links",)
        hard_count += sum(int(counts.get(key, 0)) for key in hard_keys)
        soft_count += sum(int(counts.get(key, 0)) for key in soft_keys)
        for category, values in snapshot.get("findings", {}).items():
            for value in values[:5]:
                findings.append(f"{category}: {value}")
    score = 100 - min(90, len(findings) * 10) - min(90, hard_count * 50) - min(40, soft_count * 10)
    evidence = [
        f"{len(checks)} mechanical check(s)",
        f"{len(baselines.get('snapshots', []))} baseline snapshot(s)",
        f"{hard_count} hard issue(s)",
        f"{soft_count} soft issue(s)",
        f"{snapshot.get('counts', {}).get('test_files', 0) if isinstance(snapshot, dict) else 0} test file(s)",
    ]
    return dimension("mechanical_verification", score, findings, evidence)


def score_dev_map() -> dict:
    dev_map = load_json(Path(".agent/dev-map.json"))
    layout = load_json(Path(".agent/project-layout.json"))
    findings: list[str] = []
    architecture_path = Path("docs/ARCHITECTURE.md")
    if layout.get("schema") == "agent-project-layout-v1":
        directories = layout.get("directories", [])
        exception = str(layout.get("policy", {}).get("architecture_boundary_exception", "")).strip()
        if not directories and not exception:
            findings.append("project layout directories empty without architecture_boundary_exception")
        missing_dirs = [directory for directory in directories if not Path(directory).is_dir()]
        findings.extend(f"project layout missing directory: {directory}" for directory in missing_dirs[:5])
    if not architecture_path.exists():
        findings.append("missing docs/ARCHITECTURE.md")
    else:
        architecture_text = architecture_path.read_text(encoding="utf-8", errors="ignore")
        if has_placeholder_text(architecture_text):
            findings.append("docs/ARCHITECTURE.md contains placeholder text")
        for heading in ("## System Shape", "## Required Directories", "## Dependency Direction"):
            if heading not in architecture_text:
                findings.append(f"docs/ARCHITECTURE.md missing {heading}")
        if "boundary" not in architecture_text.lower() or "dependency" not in architecture_text.lower():
            findings.append("docs/ARCHITECTURE.md must describe boundaries and dependency direction")
    if dev_map.get("schema") != "agent-dev-map-v1":
        findings.append("invalid dev-map schema")
    if dev_map.get("doc") != "docs/DEV_MAP.md":
        findings.append("dev map must point to docs/DEV_MAP.md")
    if not Path("docs/DEV_MAP.md").exists():
        findings.append("missing docs/DEV_MAP.md")
    policy = dev_map.get("policy", {})
    for key in ("map_is_index_not_inventory", "update_when_entry_points_change", "new_sessions_read_before_broad_edits"):
        if policy.get(key) is not True:
            findings.append(f"dev map policy missing {key}")
    areas = dev_map.get("areas", [])
    if not areas:
        findings.append("dev map has no areas")
    else:
        for area in areas:
            for key in ("id", "entry_points", "read_before_edit", "owned_paths", "common_patterns"):
                if key not in area:
                    findings.append(f"dev map area {area.get('id', 'unknown')} missing {key}")
            if area.get("id") == "application":
                exception = str(area.get("architecture_boundary_exception", "")).strip()
                if (not area.get("entry_points") or not area.get("owned_paths")) and not exception:
                    findings.append("dev map application area needs entry_points and owned_paths")
                text = " ".join(
                    str(item)
                    for values in (area.get("entry_points", []), area.get("owned_paths", []), area.get("common_patterns", []))
                    for item in values
                )
                if has_placeholder_text(text):
                    findings.append("dev map application area contains placeholder text")
    score = 100 - min(90, len(findings) * 15)
    evidence = [f"{len(areas)} area(s)", f"{len(layout.get('directories', []))} layout path(s)"]
    return dimension("dev_map", score, findings, evidence)


def score_skill_hygiene() -> dict:
    hygiene = load_json(Path(".agent/skill-hygiene.json"))
    findings: list[str] = []
    if hygiene.get("schema") != "agent-skill-hygiene-v1":
        findings.append("invalid skill-hygiene schema")
    policy = hygiene.get("policy", {})
    for key in ("doctor_is_read_only", "scripts_collect_facts_ai_interprets", "human_confirms_cleanup", "no_auto_delete"):
        if policy.get(key) is not True:
            findings.append(f"skill hygiene policy missing {key}")
    if hygiene.get("canary", {}).get("enabled") is not False:
        findings.append("activation canary must be disabled by default")
    if not Path("scripts/agent_skill_hygiene.py").exists():
