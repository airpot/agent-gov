def check_skill_runtime(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("skill_runtime", {})
    path = Path(spec.get("path", ".agent/skill-runtime.json"))
    errors: list[str] = []
    if not path.exists():
        return [f"missing {path}"]
    runtime = load_json(path, {})
    if runtime.get("schema") != spec.get("schema", "agent-skill-runtime-v1"):
        return [f"{path} schema must be {spec.get('schema', 'agent-skill-runtime-v1')}"]
    for section in (
        "source_evidence",
        "canonical_core",
        "host_adapters",
        "runtime_modes",
        "command_lanes",
        "review_lanes",
        "impact_benchmarks",
        "shortcut_debt",
        "dependency_policy",
    ):
        if section not in runtime:
            errors.append(f"{path} missing {section}")
    source_evidence = runtime.get("source_evidence", [])
    if not isinstance(source_evidence, list) or not source_evidence:
        errors.append(f"{path} source_evidence must be non-empty")
    else:
        for item in source_evidence:
            if item.get("status") not in {"verified", "partial", "blocked"}:
                errors.append(f"{path} source evidence status must be verified, partial, or blocked")
    core = runtime.get("canonical_core", {})
    patterns = set(core.get("path_patterns", []))
    for pattern in ("SKILL.md", "AGENTS.md", "references/", "scripts/", "assets/"):
        if pattern not in patterns:
            errors.append(f"{path} canonical_core missing {pattern}")
    for key in ("core_files_are_authoritative", "adapters_must_be_thin", "do_not_duplicate_behavior_in_host_adapters"):
        if core.get(key) is not True:
            errors.append(f"{path} canonical_core must enable {key}")
    adapter_policy = runtime.get("host_adapters", {}).get("parity_policy", {})
    for key in (
        "canonical_source_required",
        "adapter_drift_must_be_detected",
        "release_claim_requires_parity_evidence",
        "hook_projection_boundary_required",
        "orphaned_hook_files_are_findings",
        "empty_hooks_object_may_suppress_autodiscovery",
    ):
        if adapter_policy.get(key) is not True:
            errors.append(f"{path} adapter parity policy must enable {key}")
    if not runtime.get("host_adapters", {}).get("adapter_targets"):
        errors.append(f"{path} host_adapters.adapter_targets must be non-empty")
    modes = runtime.get("runtime_modes", {})
    allowed_modes = set(modes.get("allowed_modes", []))
    for mode in ("off", "advisory", "standard", "strict", "audit-only"):
        if mode not in allowed_modes:
            errors.append(f"{path} runtime_modes missing {mode}")
    hook_boundaries = modes.get("hook_boundaries", {})
    for key in (
        "read_only_by_default",
        "stdin_must_not_deadlock",
        "stdin_errors_degrade_safely",
        "strip_utf8_bom_before_json_parse",
        "valid_json_required_when_host_requires_json",
        "preserve_empty_additional_context",
        "invalid_mandatory_output_exits_nonzero",
        "failure_degrades_safely",
        "hook_must_not_store_secrets",
    ):
        if hook_boundaries.get(key) is not True:
            errors.append(f"{path} hook_boundaries must enable {key}")
    for lane in ("mode_switch", "complexity_review", "repository_audit", "debt_harvest", "impact_scoreboard", "help_status"):
        if lane not in runtime.get("command_lanes", {}):
            errors.append(f"{path} missing command lane {lane}")
    review_lanes = runtime.get("review_lanes", {})
    for lane in ("spec_compliance", "quality_security", "complexity_only", "debt_ledger", "impact_benchmark"):
        if lane not in review_lanes:
            errors.append(f"{path} missing review lane {lane}")
    forbidden = set(review_lanes.get("complexity_only", {}).get("forbidden_findings", []))
    for finding in ("correctness", "security", "privacy", "data-loss", "accessibility"):
        if finding not in forbidden:
            errors.append(f"{path} complexity_only must route {finding} out")
    benchmark_policy = runtime.get("impact_benchmarks", {}).get("policy", {})
    for key in (
        "baseline_arm_required",
        "skill_enabled_arm_required",
        "isolated_workspaces_or_plugin_dirs_required",
        "contamination_selftest_required",
        "correctness_or_safety_gate_required",
        "preserve_outputs",
        "record_limitations",
        "reduction_claims_must_not_drop_safety_or_requirements",
    ):
        if benchmark_policy.get(key) is not True:
            errors.append(f"{path} impact benchmark policy must enable {key}")
    debt = runtime.get("shortcut_debt", {})
    if debt.get("marker") != "agent-gov-debt:":
        errors.append(f"{path} shortcut_debt marker must be agent-gov-debt:")
    for field in ("ceiling", "upgrade_trigger"):
        if field not in debt.get("required_fields", []):
            errors.append(f"{path} shortcut_debt required_fields missing {field}")
    dependency_policy = runtime.get("dependency_policy", {})
    for key in ("local_doctors_dependency_free", "python_standard_library_only_for_generated_checks", "no_network_required_for_doctor", "no_global_plugin_state_required_for_doctor"):
        if dependency_policy.get(key) is not True:
            errors.append(f"{path} dependency_policy must enable {key}")
    doc = Path(spec.get("doc", "docs/SKILL_RUNTIME.md"))
    if not doc.exists():
        errors.append(f"missing {doc}")
    return errors


def check_skill_optimization(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("skill_optimization", {})
    path = Path(spec.get("path", ".agent/skill-optimization.json"))
    errors: list[str] = []
    if not path.exists():
        return [f"missing {path}"]
    data = load_json(path, {})
    if data.get("schema") != spec.get("schema", "agent-skill-optimization-v1"):
        return [f"{path} schema must be {spec.get('schema', 'agent-skill-optimization-v1')}"]
    modes = set(data.get("modes", []))
    for mode in ("manual-only", "auto-candidate", "auto-apply-staged", "auto-promote"):
        if mode not in modes:
            errors.append(f"{path} modes missing {mode}")
    triggers = data.get("triggers", {})
    for trigger in ("manual", "failure-threshold", "release-gate", "scheduled-sleep"):
        if not isinstance(triggers, dict) or trigger not in triggers:
            errors.append(f"{path} triggers missing {trigger}")
    default_policy = data.get("default_skill_policy", {})
    if not isinstance(default_policy, dict) or default_policy.get("mode") not in modes:
        errors.append(f"{path} default_skill_policy.mode must be an allowed mode")
    release = data.get("release_preflight", {})
    if not isinstance(release, dict):
        errors.append(f"{path} release_preflight must be an object")
    else:
        for key in ("required", "release_check_validates_existing_only", "fail_closed"):
            if release.get(key) is not True:
                errors.append(f"{path} release_preflight must enable {key}")
        artifacts = set(release.get("artifact_names", []))
        for artifact in ("signal-scan.md", "candidate-summary.md", "gate-report.md", "rejected-edits.jsonl", "release-decision.md", "rollback-plan.md"):
            if artifact not in artifacts:
                errors.append(f"{path} release_preflight missing artifact {artifact}")
    scheduled = data.get("scheduled_sleep", {})
    if not isinstance(scheduled, dict) or scheduled.get("primitive") != "scheduled_routine":
        errors.append(f"{path} scheduled_sleep must be governed as scheduled_routine")
    else:
        for key in ("cadence_or_event_source", "disable_or_expiry_policy", "owner", "run_location", "permission_mode", "resource_boundary", "cost_boundary", "evidence_path", "dry_run_default", "human_interrupt_points", "fail_closed"):
            if key not in scheduled:
                errors.append(f"{path} scheduled_sleep missing {key}")
    roles = data.get("role_boundaries", {})
    if not isinstance(roles, dict) or roles.get("finder_cannot_fix") is not True:
        errors.append(f"{path} role_boundaries must enforce finder_cannot_fix")
    script = Path(spec.get("script", "scripts/agent_skill_opt.py"))
    if not script.exists():
        errors.append(f"missing {script}")
    doc = Path(spec.get("doc", "docs/SKILL_OPTIMIZATION.md"))
    if not doc.exists():
        errors.append(f"missing {doc}")
    return errors


def check_knowledge_governance(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("knowledge_governance", {})
    path = Path(spec.get("path", ".agent/knowledge.json"))
    errors: list[str] = []
    if not path.exists():
        return [f"missing {path}"]
    script = spec.get("script", "scripts/agent_knowledge.py")
    if not Path(script).exists():
        errors.append(f"missing {script}")
        return errors
    result = subprocess.run([sys.executable, script], text=True, capture_output=True, check=False)
    if result.returncode != 0:
        output = (result.stdout + result.stderr).strip()
        errors.append(f"knowledge governance doctor failed: {output}")
    return errors


