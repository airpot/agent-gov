#!/usr/bin/env python3
"""Run mechanical governance checks and compare before/after baselines."""

from __future__ import annotations

import argparse
import fnmatch
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path


CONFIG_PATH = Path(".agent/mechanical-checks.json")
BASELINES_PATH = Path(".agent/baselines.json")
MARKDOWN_LINK_RE = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
OFFLOAD_SCHEMA = "agent-session-offload-v1"
REVIEW_STATUSES = {"pending", "needs-fix", "pass", "accepted-with-exceptions", "not-required"}
REQUIREMENT_STATUSES = {"pending", "in-progress", "complete", "blocked", "not-required"}
REQUIREMENT_PROTECTED_STAGES = {
    "plan",
    "gate_review",
    "isolation",
    "implementation",
    "spec_review",
    "quality_review",
    "human_review",
    "verification",
    "handoff",
    "finish",
}


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path, fallback: dict | None = None) -> dict:
    if not path.exists():
        if fallback is not None:
            return fallback
        raise SystemExit(f"error: missing {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid JSON in {path}: {exc}")


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def check_json(paths: list[str]) -> list[str]:
    invalid: list[str] = []
    for name in paths:
        path = Path(name)
        if not path.exists():
            invalid.append(f"missing json: {name}")
            continue
        try:
            json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            invalid.append(f"invalid json: {name}: {exc}")
    return invalid


def check_jsonl(paths: list[str]) -> list[str]:
    invalid: list[str] = []
    for name in paths:
        path = Path(name)
        if not path.exists():
            invalid.append(f"missing jsonl: {name}")
            continue
        for index, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
            if not line.strip():
                continue
            try:
                json.loads(line)
            except json.JSONDecodeError as exc:
                invalid.append(f"invalid jsonl: {name}:{index}: {exc}")
    return invalid


def check_jsonl_glob(pattern: str) -> list[str]:
    invalid: list[str] = []
    if not pattern:
        return invalid
    for path in Path(".").glob(pattern):
        if path.is_file():
            invalid.extend(check_jsonl([path.as_posix()]))
    return invalid


def jsonl_rows(path: Path) -> tuple[list[dict], list[str]]:
    rows: list[dict] = []
    errors: list[str] = []
    if not path.exists():
        return rows, errors
    for index, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            errors.append(f"invalid jsonl: {path}:{index}: {exc}")
    return rows, errors


def strip_line_suffix(handle: str) -> str:
    match = re.match(r"^(.+?):\d+(?::\d+)?$", handle)
    return match.group(1) if match else handle


def id_set(path: Path) -> set[str]:
    rows, _ = jsonl_rows(path)
    return {str(item.get("id")) for item in rows if item.get("id")}


def evidence_exists(handle: str, runlog_ids: set[str], event_ids: set[str]) -> bool:
    handle = handle.strip()
    if not handle:
        return False
    if handle in runlog_ids or handle in event_ids:
        return True
    return Path(strip_line_suffix(handle)).exists()


def check_session_offload(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("session_offload", {})
    session_root = Path(spec.get("session_root", ".agent/sessions"))
    errors: list[str] = []
    if not session_root.exists():
        return errors
    index = load_json(session_root / "index.json", {})
    active_session = index.get("active_session")
    if active_session and spec.get("require_grounding_for_active_session", True):
        active_dir = session_root / str(active_session)
        for name in ("grounding.md", "offload.jsonl", "offload-index.md", "task-map.mmd", "refs/.gitkeep"):
            if not (active_dir / name).exists():
                errors.append(f"active session missing {active_dir / name}")
        bootstrap_text = (session_root / "bootstrap.md").read_text(encoding="utf-8", errors="ignore") if (session_root / "bootstrap.md").exists() else ""
        if spec.get("bootstrap_must_include_grounding_and_offload", True):
            if "Truth-First Grounding" not in bootstrap_text or "Offload Index" not in bootstrap_text:
                errors.append(".agent/sessions/bootstrap.md missing grounding/offload sections")
        grounding_text = (active_dir / "grounding.md").read_text(encoding="utf-8", errors="ignore") if (active_dir / "grounding.md").exists() else ""
        if grounding_text and "override memory summaries" not in grounding_text:
            errors.append(f"{active_dir / 'grounding.md'} missing truth-first memory boundary")
    runlog_ids = id_set(Path(".agent/runlog.jsonl"))
    event_ids = id_set(session_root / "events.jsonl")
    for offload_file in session_root.glob("*/offload.jsonl"):
        rows, parse_errors = jsonl_rows(offload_file)
        errors.extend(parse_errors)
        for item in rows:
            entry_id = item.get("id") or "<missing-id>"
            if item.get("schema") != spec.get("schema", OFFLOAD_SCHEMA):
                errors.append(f"{offload_file} entry {entry_id} schema mismatch")
            if spec.get("memory_is_advisory", True) and item.get("authority") != "advisory":
                errors.append(f"{offload_file} entry {entry_id} must be advisory")
            evidence = item.get("evidence")
            if spec.get("require_evidence_handles", True) and (not isinstance(evidence, list) or not evidence):
                errors.append(f"{offload_file} entry {entry_id} missing evidence handles")
                continue
            if spec.get("evidence_must_exist", True):
                for handle in evidence or []:
                    if not isinstance(handle, str) or not evidence_exists(handle, runlog_ids, event_ids):
                        errors.append(f"{offload_file} entry {entry_id} dangling evidence: {handle}")
    return errors


def required_paths() -> list[str]:
    harness = load_json(Path(".agent/harness.json"), {})
    return list(harness.get("invariants", {}).get("required_paths", []))


def check_required_paths() -> list[str]:
    return [name for name in required_paths() if not Path(name).exists()]


def check_feature_templates(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("feature_templates", {})
    template_dir = Path(spec.get("template_dir", ".agent/templates/features"))
    missing: list[str] = []
    for name in spec.get("required_templates", []):
        if not (template_dir / name).exists():
            missing.append(str(template_dir / name))
    return missing


def profile_requires_review_gate(profile_name: str, profile: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("done_requires_review_gate_pass_for_profiles", []))
    return profile.get("review_gate_required") is True or profile_name in required_profiles


def normalized_review_gate(item: dict, profile: dict, policy: dict) -> dict:
    required = profile_requires_review_gate(str(item.get("profile", "")), profile, policy)
    gate = item.get("review_gate")
    if not isinstance(gate, dict):
        gate = {}
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "latest_review": "",
        "latest_fix": "",
        "open_findings": [],
        "accepted_exception": "",
    }
    merged.update(gate)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_findings"), list):
        merged["open_findings"] = [str(merged.get("open_findings"))]
    return merged


def normalized_requirements(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    requirements = item.get("requirements")
    if not isinstance(requirements, dict):
        requirements = {}
    required = profile_name != "tiny"
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "shared_understanding": "",
        "domain_glossary_updated": False,
        "code_docs_cross_checked": False,
        "open_questions": [],
    }
    merged.update(requirements)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_questions"), list):
        merged["open_questions"] = [str(merged.get("open_questions"))]
    return merged


def requirements_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    requirements = normalized_requirements(item)
    if requirements.get("status") not in REQUIREMENT_STATUSES:
        errors.append(f"{task_id} requirements invalid status: {requirements.get('status')}")
    if not requirements.get("required"):
        return errors
    protected = set(profile.get("requirement_protected_stages", [])) or REQUIREMENT_PROTECTED_STAGES
    state_done = item.get("state") == "done" and policy.get("requirements_complete_before_done") is True
    stage_protected = item.get("current_stage") in protected and policy.get("requirements_complete_before_protected_stages") is True
    if not state_done and not stage_protected:
        return errors
    if requirements.get("status") != "complete":
        errors.append(f"{task_id} requirements must be complete before {item.get('current_stage') or item.get('state')}")
    if not str(requirements.get("shared_understanding", "")).strip():
        errors.append(f"{task_id} requirements missing shared_understanding")
    if requirements.get("domain_glossary_updated") is not True:
        errors.append(f"{task_id} requirements must confirm domain_glossary_updated")
    if requirements.get("code_docs_cross_checked") is not True:
        errors.append(f"{task_id} requirements must confirm code_docs_cross_checked")
    docs_path = item.get("docs_path")
    if docs_path and not (Path(docs_path) / "01_REQUIREMENT_ANALYSIS.md").exists():
        errors.append(f"{task_id} missing requirement analysis document")
    return errors


def review_gate_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    gate = normalized_review_gate(item, profile, policy)
    if gate.get("status") not in REVIEW_STATUSES:
        errors.append(f"{task_id} review_gate invalid status: {gate.get('status')}")
    open_findings = [finding for finding in gate.get("open_findings", []) if str(finding).strip()]
    if item.get("state") == "done" and gate.get("required"):
        pass_status = policy.get("review_gate_pass_status", "pass")
        if gate.get("status") != pass_status:
            errors.append(f"{task_id} done without review_gate status {pass_status}")
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            errors.append(f"{task_id} done with open review findings")
        latest_review = str(gate.get("latest_review", "")).strip()
        if not latest_review:
            errors.append(f"{task_id} done without review_gate latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not Path(latest_review).exists():
            errors.append(f"{task_id} review_gate latest_review path missing: {latest_review}")
    return errors


def check_task_board() -> list[str]:
    board = load_json(Path(".agent/task-board.json"), {})
    profiles = load_json(Path(".agent/workflow-profiles.json"), {})
    errors: list[str] = []
    if board.get("schema") != "agent-task-board-v1":
        errors.append(".agent/task-board.json schema must be agent-task-board-v1")
    required_fields = set(board.get("required_fields", []))
    ids: set[str] = set()
    states = set(board.get("states", []))
    profile_names = set(profiles.get("profiles", {}))
    policy = board.get("policy", {})
    for field in ("id", "title", "state", "risk", "profile", "current_stage", "docs_path", "requirements", "review_gate"):
        if field not in required_fields:
            errors.append(f"task board missing required field declaration: {field}")
    if set(policy.get("done_requires_review_gate_pass_for_profiles", [])) != {"standard", "full"}:
        errors.append("task board must require review_gate pass for standard and full done tasks")
    for item in board.get("items", []):
        task_id = item.get("id")
        if not task_id:
            errors.append("task missing id")
            continue
        for field in required_fields:
            if field not in item:
                errors.append(f"{task_id} missing field: {field}")
        if task_id in ids:
            errors.append(f"duplicate task id: {task_id}")
        ids.add(task_id)
        if item.get("state") not in states:
            errors.append(f"{task_id} invalid state: {item.get('state')}")
        if item.get("profile") not in profile_names:
            errors.append(f"{task_id} invalid profile: {item.get('profile')}")
            continue
        profile = profiles.get("profiles", {}).get(item.get("profile"), {})
        allowed_stages = set(profile.get("stages", []))
        if allowed_stages and item.get("current_stage") not in allowed_stages:
            errors.append(f"{task_id} invalid current_stage for profile {item.get('profile')}: {item.get('current_stage')}")
        if item.get("state") == "done" and policy.get("done_requires_delivery_conclusion") is True:
            if not str(item.get("delivery_conclusion", "")).strip():
                errors.append(f"{task_id} done without delivery_conclusion")
        errors.extend(requirements_errors(task_id, item, profile, policy))
        errors.extend(review_gate_errors(task_id, item, profile, policy))
        docs_path = item.get("docs_path")
        if profile.get("feature_doc_templates") and (not docs_path or not Path(docs_path).exists()):
            errors.append(f"{task_id} docs_path missing or absent: {docs_path}")
    return errors


def check_role_contracts() -> list[str]:
    contracts = load_json(Path(".agent/role-contracts.json"), {})
    errors: list[str] = []
    if contracts.get("schema") != "agent-role-contracts-v1":
        errors.append(".agent/role-contracts.json schema must be agent-role-contracts-v1")
    policy = contracts.get("policy", {})
    separation = contracts.get("separation_of_duties", {})
    if policy.get("finder_cannot_fix") is not True:
        errors.append("role policy must enable finder_cannot_fix")
    if separation.get("finder_cannot_modify_files") is not True:
        errors.append("separation_of_duties must block finder file modification")
    for role in ("worker", "verifier", "spec_reviewer", "quality_reviewer", "reviewer", "coordinator"):
        if role not in contracts.get("contracts", {}):
            errors.append(f"missing role contract: {role}")
    return errors


def check_enabled(config: dict, name: str) -> bool:
    return config.get("checks", {}).get(name, {}).get("enabled", name in config.get("checks", {})) is not False


def check_governance_configs(config: dict) -> list[str]:
    manifest = load_json(Path(".agent/manifest.json"), {})
    manifest_schemas = manifest.get("json_schemas", {})
    expected = {
        path: schema
        for path, schema in manifest_schemas.items()
        if path
        in {
            ".agent/manifest.json",
            ".agent/dev-map.json",
            ".agent/skill-hygiene.json",
            ".agent/harness-evolution.json",
            ".agent/mcp-policy.json",
            ".agent/governance-gc.json",
        }
    }
    expected.setdefault(".agent/manifest.json", "agent-governance-manifest-v1")
    errors: list[str] = []
    for name, schema in expected.items():
        data = load_json(Path(name), {})
        if data.get("schema") != schema:
            errors.append(f"{name} schema must be {schema}")
    harness = load_json(Path(".agent/harness.json"), {})
    manifest_required = sorted(manifest.get("required_paths", []))
    harness_required = sorted(harness.get("invariants", {}).get("required_paths", []))
    if manifest_required and harness_required and manifest_required != harness_required:
        errors.append(".agent/manifest.json required_paths must match .agent/harness.json invariants.required_paths")
    workflow = load_json(Path(".agent/workflow.json"), {})
    profiles = load_json(Path(".agent/workflow-profiles.json"), {})
    workflow_stages = set(workflow.get("stages", []))
    review_fix = workflow.get("gates", {}).get("review_fix_gate", {})
    requirements_gate = workflow.get("gates", {}).get("requirements_interview", {})
    for key in ("ask_one_question_at_a_time", "provide_recommended_answer_and_reason", "cross_check_user_claims_against_code_and_docs", "update_domain_glossary_for_new_or_ambiguous_terms"):
        if requirements_gate.get(key) is not True:
            errors.append(f"workflow requirements_interview missing {key}")
    if review_fix.get("latest_review_status_must_be") != "pass":
        errors.append("workflow review_fix_gate must require latest review status pass")
    if review_fix.get("open_findings_must_be_empty") is not True:
        errors.append("workflow review_fix_gate must require empty open findings")
    if workflow_stages:
        for name, profile in profiles.get("profiles", {}).items():
            if name in {"standard", "full"} and profile.get("review_gate_required") is not True:
                errors.append(f"workflow profile {name} must require review gate")
            for stage in profile.get("stages", []):
                if stage not in workflow_stages:
                    errors.append(f"workflow profile {name} references unknown stage: {stage}")
    if check_enabled(config, "dev_map") and not Path("docs/DEV_MAP.md").exists():
        errors.append("docs/DEV_MAP.md is missing")
    if check_enabled(config, "skill_hygiene"):
        hygiene_path = Path(config.get("checks", {}).get("skill_hygiene", {}).get("path", ".agent/skill-hygiene.json"))
        hygiene = load_json(hygiene_path, {})
        if hygiene.get("schema") != "agent-skill-hygiene-v1":
            errors.append(f"{hygiene_path} schema must be agent-skill-hygiene-v1")
        policy = hygiene.get("policy", {})
        for key in ("doctor_is_read_only", "human_confirms_cleanup", "no_auto_delete"):
            if policy.get(key) is not True:
                errors.append(f"{hygiene_path} missing policy: {key}")
        if hygiene.get("canary", {}).get("enabled") is not False:
            errors.append(f"{hygiene_path} canary must be disabled by default")
    if check_enabled(config, "mcp_policy"):
        mcp_path = Path(config.get("checks", {}).get("mcp_policy", {}).get("path", ".agent/mcp-policy.json"))
        mcp = load_json(mcp_path, {})
        if mcp.get("schema") != "agent-mcp-policy-v1":
            errors.append(f"{mcp_path} schema must be agent-mcp-policy-v1")
        if mcp.get("mode") != "optional-disabled-by-default" and not mcp.get("servers"):
            errors.append(f"{mcp_path} must stay disabled by default or define audited servers")
        rules = mcp.get("policy", {})
        for key in (
            "credentials_must_not_be_stored_in_repo",
            "credentials_must_use_vault_or_proxy",
            "sandbox_must_not_receive_raw_credentials",
            "credential_rotation_and_audit_required",
            "destructive_or_release_operations_need_human_approval",
            "record_high_risk_mcp_use_in_runlog",
        ):
            if rules.get(key) is not True:
                errors.append(f"{mcp_path} missing policy: {key}")
        for boundary in ("credential_vault", "credential_proxy"):
            if boundary not in mcp.get("trust_boundaries", {}):
                errors.append(f"{mcp_path} missing trust boundary: {boundary}")
    return errors


def iter_markdown_roots(roots: list[str]) -> list[Path]:
    files: list[Path] = []
    for root in roots:
        path = Path(root)
        if not path.exists():
            continue
        if path.is_file() and path.suffix.lower() in {".md", ".tmpl"}:
            files.append(path)
        elif path.is_dir():
            files.extend(item for item in path.rglob("*") if item.is_file() and item.suffix.lower() in {".md", ".tmpl"})
    return files


def check_markdown_links(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("markdown_links", {})
    broken: list[str] = []
    for path in iter_markdown_roots(spec.get("roots", [])):
        text = path.read_text(encoding="utf-8", errors="ignore")
        for match in MARKDOWN_LINK_RE.finditer(text):
            target = match.group(1).split("#", 1)[0].strip()
            if not target or target.startswith(("http://", "https://", "mailto:", "tel:")):
                continue
            if target.startswith("<") and target.endswith(">"):
                target = target[1:-1]
            if "://" in target:
                continue
            resolved = (path.parent / target).resolve()
            try:
                resolved.relative_to(Path.cwd().resolve())
            except ValueError:
                continue
            if not resolved.exists():
                broken.append(f"{path}: broken local link: {target}")
    return broken


def render_json_template_errors(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("template_rendering", {})
    placeholder = str(spec.get("placeholder_value", "agent-gov-placeholder"))
    errors: list[str] = []
    for name in spec.get("json_templates", []):
        path = Path(name)
        if not path.exists():
            errors.append(f"missing json template: {name}")
            continue
        text = path.read_text(encoding="utf-8", errors="ignore")
        rendered = re.sub(r"\{\{[A-Za-z0-9_. -]+\}\}", placeholder, text)
        try:
            json.loads(rendered)
        except json.JSONDecodeError as exc:
            errors.append(f"invalid rendered json template: {name}: {exc}")
    return errors


def is_ignored(path: Path, ignore_dirs: list[str]) -> bool:
    parts = set(path.parts)
    return any(part in parts for part in ignore_dirs)


def count_test_files(config: dict) -> int:
    spec = config.get("checks", {}).get("test_baseline", {})
    ignore_dirs = list(spec.get("ignore_dirs", []))
    matches: set[Path] = set()
    for pattern in spec.get("globs", []):
        for path in Path(".").rglob("*"):
            if not path.is_file() or is_ignored(path, ignore_dirs):
                continue
            relative = path.as_posix().removeprefix("./")
            if fnmatch.fnmatch(relative, pattern):
                matches.add(path)
    return len(matches)


def collect_snapshot() -> dict:
    config = load_json(CONFIG_PATH, {})
    checks = config.get("checks", {})
    json_invalid = check_json(checks.get("json_integrity", {}).get("paths", [])) if check_enabled(config, "json_integrity") else []
    jsonl_invalid = check_jsonl(checks.get("jsonl_integrity", {}).get("paths", [])) if check_enabled(config, "jsonl_integrity") else []
    if check_enabled(config, "jsonl_integrity"):
        jsonl_invalid.extend(check_jsonl_glob(checks.get("jsonl_integrity", {}).get("session_offload_glob", "")))
    missing_required = check_required_paths() if check_enabled(config, "required_paths") else []
    missing_templates = check_feature_templates(config) if check_enabled(config, "feature_templates") else []
    task_board_errors = check_task_board() if check_enabled(config, "task_board") else []
    role_contract_errors = check_role_contracts() if check_enabled(config, "role_contracts") else []
    governance_config_errors = check_governance_configs(config) if check_enabled(config, "manifest") else []
    session_offload_errors = check_session_offload(config) if check_enabled(config, "session_offload") else []
    template_errors = render_json_template_errors(config) if check_enabled(config, "template_rendering") else []
    broken_links = check_markdown_links(config) if check_enabled(config, "markdown_links") else []
    test_file_count = count_test_files(config) if check_enabled(config, "test_baseline") else 0
    findings = {
        "invalid_json": json_invalid,
        "invalid_jsonl": jsonl_invalid,
        "missing_required_paths": missing_required,
        "missing_feature_templates": missing_templates,
        "task_board": task_board_errors,
        "role_contracts": role_contract_errors,
        "governance_configs": governance_config_errors,
        "session_offload": session_offload_errors,
        "template_rendering": template_errors,
        "broken_local_links": broken_links,
    }
    counts = {key: len(value) for key, value in findings.items()}
    counts["test_files"] = test_file_count
    return {
        "schema": "agent-verify-snapshot-v1",
        "created_at": utc_now(),
        "counts": counts,
        "findings": findings,
    }


def snapshot_has_hard_fail(snapshot: dict) -> bool:
    counts = snapshot.get("counts", {})
    hard_keys = [
        "invalid_json",
        "invalid_jsonl",
        "missing_required_paths",
        "missing_feature_templates",
        "task_board",
        "role_contracts",
        "governance_configs",
        "session_offload",
        "template_rendering",
    ]
    return any(counts.get(key, 0) > 0 for key in hard_keys)


def print_snapshot(snapshot: dict) -> None:
    print(json.dumps(snapshot, indent=2))


def write_snapshot(name: str, snapshot: dict) -> Path:
    if not re.match(r"^[a-zA-Z0-9._-]{1,80}$", name):
        raise SystemExit("error: snapshot name must be alphanumeric with dot, underscore, or hyphen")
    baselines = load_json(BASELINES_PATH, {"schema": "agent-baselines-v1", "snapshots": []})
    snapshot_dir = Path(baselines.get("snapshot_dir", ".agent/baselines"))
    path = snapshot_dir / f"{name}.json"
    write_json(path, snapshot)
    item = {"name": name, "path": str(path), "created_at": snapshot["created_at"]}
    existing = [entry for entry in baselines.get("snapshots", []) if entry.get("name") != name]
    existing.append(item)
    baselines["snapshots"] = existing
    baselines["latest_snapshot"] = str(path)
    write_json(BASELINES_PATH, baselines)
    return path


def cmd_doctor(args: argparse.Namespace) -> int:
    config = load_json(CONFIG_PATH)
    if config.get("schema") != "agent-mechanical-checks-v1":
        print("error: .agent/mechanical-checks.json schema must be agent-mechanical-checks-v1")
        return 1
    snapshot = collect_snapshot()
    if args.json:
        print_snapshot(snapshot)
    if snapshot_has_hard_fail(snapshot):
        for category, findings in snapshot["findings"].items():
            for finding in findings:
                print(f"error: {category}: {finding}")
        return 1
    print("agent mechanical verification doctor passed")
    return 0


def cmd_snapshot(args: argparse.Namespace) -> int:
    snapshot = collect_snapshot()
    if args.name:
        path = write_snapshot(args.name, snapshot)
        print(f"snapshot: {path}")
    if args.json or not args.name:
        print_snapshot(snapshot)
    return 1 if args.fail_on_issue and snapshot_has_hard_fail(snapshot) else 0


def cmd_compare(args: argparse.Namespace) -> int:
    before = load_json(Path(args.before))
    after = load_json(Path(args.after))
    regressions: list[str] = []
    issue_keys = sorted(set(before.get("findings", {})) | set(after.get("findings", {})))
    for key in issue_keys:
        before_count = int(before.get("counts", {}).get(key, 0))
        after_count = int(after.get("counts", {}).get(key, 0))
        if after_count > before_count:
            regressions.append(f"{key}: {before_count} -> {after_count}")
    before_tests = int(before.get("counts", {}).get("test_files", 0))
    after_tests = int(after.get("counts", {}).get("test_files", 0))
    if before_tests and after_tests < before_tests:
        regressions.append(f"test_files: {before_tests} -> {after_tests}")
    report = {
        "schema": "agent-verify-compare-v1",
        "created_at": utc_now(),
        "before": args.before,
        "after": args.after,
        "regressions": regressions,
    }
    print(json.dumps(report, indent=2))
    return 1 if regressions else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Run hard mechanical checks")
    doctor.add_argument("--json", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    snapshot = subparsers.add_parser("snapshot", help="Capture a baseline snapshot")
    snapshot.add_argument("--name", help="Write snapshot to .agent/baselines/<name>.json")
    snapshot.add_argument("--json", action="store_true")
    snapshot.add_argument("--fail-on-issue", action="store_true")
    snapshot.set_defaults(func=cmd_snapshot)

    compare = subparsers.add_parser("compare", help="Compare two snapshots")
    compare.add_argument("--before", required=True)
    compare.add_argument("--after", required=True)
    compare.set_defaults(func=cmd_compare)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
