def existing_repo_file(value: str, root: Path = Path(".")) -> bool:
    candidate = Path(value)
    if not value or candidate.is_absolute():
        return False
    repository = root.resolve()
    try:
        resolved = (repository / candidate).resolve(strict=True)
        resolved.relative_to(repository)
    except (OSError, RuntimeError, ValueError):
        return False
    return resolved.is_file()


def parse_utc(value: object) -> datetime | None:
    try:
        return datetime.strptime(str(value), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path, fallback: dict | None = None) -> dict:
    if not path.exists():
        if fallback is not None:
            return fallback
        raise SystemExit(f"error: missing {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid JSON in {path}: {exc}")


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def check_json(paths: list[str]) -> list[str]:
    invalid: list[str] = []
    for name in paths:
        path = Path(name)
        if not path.exists():
            invalid.append(f"missing json: {name}")
            continue
        try:
            json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            invalid.append(f"invalid json: {name}: {exc}")
    return invalid


def check_jsonl(paths: list[str]) -> list[str]:
    invalid: list[str] = []
    for name in paths:
        path = Path(name)
        if not path.exists():
            invalid.append(f"missing jsonl: {name}")
            continue
        for index, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
            if not line.strip():
                continue
            try:
                json.loads(line)
            except json.JSONDecodeError as exc:
                invalid.append(f"invalid jsonl: {name}:{index}: {exc}")
    return invalid


def check_jsonl_glob(pattern: str) -> list[str]:
    invalid: list[str] = []
    if not pattern:
        return invalid
    for path in Path(".").glob(pattern):
        if path.is_file():
            invalid.extend(check_jsonl([path.as_posix()]))
    return invalid


def jsonl_rows(path: Path) -> tuple[list[dict], list[str]]:
    rows: list[dict] = []
    errors: list[str] = []
    if not path.exists():
        return rows, errors
    for index, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            errors.append(f"invalid jsonl: {path}:{index}: {exc}")
    return rows, errors


def strip_line_suffix(handle: str) -> str:
    match = re.match(r"^(.+?):\d+(?::\d+)?$", handle)
    return match.group(1) if match else handle


def id_set(path: Path) -> set[str]:
    rows, _ = jsonl_rows(path)
    return {str(item.get("id")) for item in rows if item.get("id")}


def evidence_exists(handle: str, runlog_ids: set[str], event_ids: set[str]) -> bool:
    handle = handle.strip()
    if not handle:
        return False
    if handle in runlog_ids or handle in event_ids:
        return True
    return Path(strip_line_suffix(handle)).exists()


def check_session_offload(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("session_offload", {})
    session_root = Path(spec.get("session_root", ".agent/sessions"))
    errors: list[str] = []
    if not session_root.exists():
        return errors
    index = load_json(session_root / "index.json", {})
    active_session = index.get("active_session")
    if active_session and spec.get("require_grounding_for_active_session", True):
        active_dir = session_root / str(active_session)
        for name in ("grounding.md", "offload.jsonl", "offload-index.md", "task-map.mmd", "refs/.gitkeep", "refs/git-status-short.txt"):
            if not (active_dir / name).exists():
                errors.append(f"active session missing {active_dir / name}")
        snapshot_path = active_dir / "refs/git-status-short.txt"
        if snapshot_path.exists():
            result = subprocess.run(["git", "status", "--short"], text=True, capture_output=True, check=False)
            if result.returncode == 0 and snapshot_path.read_text(encoding="utf-8").rstrip("\n") != result.stdout.rstrip("\n"):
                errors.append(f"{snapshot_path} must match current git status --short")
        bootstrap_text = (session_root / "bootstrap.md").read_text(encoding="utf-8", errors="ignore") if (session_root / "bootstrap.md").exists() else ""
        if spec.get("bootstrap_must_include_grounding_and_offload", True):
            if "Truth-First Grounding" not in bootstrap_text or "Offload Index" not in bootstrap_text:
                errors.append(".agent/sessions/bootstrap.md missing grounding/offload sections")
        if spec.get("bootstrap_must_not_inline_historical_sections", False):
            for section in spec.get("forbidden_bootstrap_sections", ["Handoff Summary", "Changed Files", "Validation"]):
                if f"## {section}" in bootstrap_text:
                    errors.append(f".agent/sessions/bootstrap.md inlines forbidden historical section: {section}")
        grounding_text = (active_dir / "grounding.md").read_text(encoding="utf-8", errors="ignore") if (active_dir / "grounding.md").exists() else ""
        if grounding_text and "override memory summaries" not in grounding_text:
            errors.append(f"{active_dir / 'grounding.md'} missing truth-first memory boundary")
    runlog_ids = id_set(Path(".agent/runlog.jsonl"))
    event_ids = id_set(session_root / "events.jsonl")
    for offload_file in session_root.glob("*/offload.jsonl"):
        rows, parse_errors = jsonl_rows(offload_file)
        errors.extend(parse_errors)
        for item in rows:
            entry_id = item.get("id") or "<missing-id>"
            if item.get("schema") != spec.get("schema", OFFLOAD_SCHEMA):
                errors.append(f"{offload_file} entry {entry_id} schema mismatch")
            if spec.get("memory_is_advisory", True) and item.get("authority") != "advisory":
                errors.append(f"{offload_file} entry {entry_id} must be advisory")
            evidence = item.get("evidence")
            if spec.get("require_evidence_handles", True) and (not isinstance(evidence, list) or not evidence):
                errors.append(f"{offload_file} entry {entry_id} missing evidence handles")
                continue
            if spec.get("evidence_must_exist", True):
                for handle in evidence or []:
                    if not isinstance(handle, str) or not evidence_exists(handle, runlog_ids, event_ids):
                        errors.append(f"{offload_file} entry {entry_id} dangling evidence: {handle}")
    return errors


def required_paths() -> list[str]:
    harness = load_json(Path(".agent/harness.json"), {})
    return list(harness.get("invariants", {}).get("required_paths", []))


def check_required_paths() -> list[str]:
    return [name for name in required_paths() if not Path(name).exists()]


def check_feature_templates(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("feature_templates", {})
    template_dir = Path(spec.get("template_dir", ".agent/templates/features"))
    missing: list[str] = []
    for name in spec.get("required_templates", []):
        if not (template_dir / name).exists():
            missing.append(str(template_dir / name))
    return missing


def profile_requires_review_gate(profile_name: str, profile: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("done_requires_review_gate_pass_for_profiles", []))
    return profile.get("review_gate_required") is True or profile_name in required_profiles


def normalized_review_gate(item: dict, profile: dict, policy: dict) -> dict:
    required = profile_requires_review_gate(str(item.get("profile", "")), profile, policy)
    gate = item.get("review_gate")
    if not isinstance(gate, dict):
        gate = {}
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "latest_review": "",
        "latest_fix": "",
        "open_findings": [],
        "accepted_exception": "",
    }
    merged.update(gate)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_findings"), list):
        merged["open_findings"] = [str(merged.get("open_findings"))]
    return merged


def normalized_requirements(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    requirements = item.get("requirements")
    if not isinstance(requirements, dict):
        requirements = {}
    required = profile_name != "tiny"
    merged = {
        "required": required,
        "status": "pending" if required else "not-required",
        "shared_understanding": "",
        "domain_glossary_updated": False,
        "code_docs_cross_checked": False,
        "open_questions": [],
    }
    merged.update(requirements)
    merged["required"] = bool(required or merged.get("required") is True)
    if not isinstance(merged.get("open_questions"), list):
        merged["open_questions"] = [str(merged.get("open_questions"))]
    return merged


def default_goal_contract(task_id: str = "", spec_change: str = "") -> dict:
    return {
        "raw_user_goal": "",
        "refined_goal": "",
        "refinement_rationale": "",
        "user_confirmation_status": "pending",
        "objective": "",
        "user_approved_outcome": "",
        "non_goals": [],
        "constraints": [],
        "success_evidence": [],
        "stop_conditions": [],
        "current_decision_summary": "",
        "open_decisions": [],
        "linked_task_id": task_id,
        "linked_spec_change_id": spec_change,
    }


def default_task_decomposition(profile_name: str) -> dict:
    return {
        "required": True,
        "status": "pending",
        "summary": "",
        "next_task": "",
        "subtasks": [],
        "dependencies": [],
        "evidence_path": "",
        "no_task_board_tiny_evidence": "" if profile_name == "tiny" else "not-applicable",
    }


def normalized_goal_contract(item: dict) -> dict:
    contract = item.get("goal_contract")
    if not isinstance(contract, dict):
        contract = {}
    merged = default_goal_contract(str(item.get("id", "")), str(item.get("spec_change", "")))
    merged.update(contract)
    for field in GOAL_CONTRACT_LIST_FIELDS:
        value = merged.get(field)
        if value is None or value == "":
            merged[field] = []
        elif not isinstance(value, list):
            merged[field] = [str(value)]
    return merged


def normalized_task_decomposition(item: dict) -> dict:
    profile_name = str(item.get("profile", "standard"))
    decomposition = item.get("task_decomposition")
    if not isinstance(decomposition, dict):
        decomposition = {}
    merged = default_task_decomposition(profile_name)
    merged.update(decomposition)
    merged["required"] = bool(merged.get("required") is not False)
    if merged.get("status") not in DECOMPOSITION_STATUSES:
        merged["status"] = "pending" if merged["required"] else "not-required"
    for field in ("subtasks", "dependencies"):
        if not isinstance(merged.get(field), list):
            merged[field] = [str(merged.get(field))]
    return merged


def goal_contract_required(item: dict, policy: dict) -> bool:
    required_profiles = set(policy.get("goal_contract_required_for_profiles", ["standard", "full"]))
    required_states = set(policy.get("goal_contract_required_states", ["active", "review", "done"]))
    required_stages = set(policy.get("goal_contract_required_before_stages", []))
    return str(item.get("profile", "")) in required_profiles and (
        str(item.get("state", "")) in required_states or str(item.get("current_stage", "")) in required_stages
    )


def goal_contract_errors(task_id: str, item: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    if not goal_contract_required(item, policy):
        return errors
    contract = normalized_goal_contract(item)
    required_fields = policy.get("goal_contract_required_fields") or list(GOAL_CONTRACT_REQUIRED_FIELDS)
    for field in required_fields:
        value = contract.get(field)
        if field in GOAL_CONTRACT_LIST_FIELDS:
            present = isinstance(value, list) and (
                field not in GOAL_CONTRACT_NONEMPTY_LIST_FIELDS or any(str(entry).strip() for entry in value)
            )
            if not present:
                errors.append(f"{task_id} goal_contract missing {field}")
        elif not str(value or "").strip():
            errors.append(f"{task_id} goal_contract missing {field}")
    if contract.get("linked_task_id") and contract.get("linked_task_id") != task_id:
        errors.append(f"{task_id} goal_contract linked_task_id must match task id")
    if contract.get("user_confirmation_status") not in GOAL_CONFIRMATION_STATUSES:
        errors.append(f"{task_id} goal_contract user_confirmation_status is invalid")
    return errors


def task_decomposition_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    decomposition = normalized_task_decomposition(item)
    if decomposition.get("status") not in DECOMPOSITION_STATUSES:
        errors.append(f"{task_id} task_decomposition invalid status: {decomposition.get('status')}")
    if not decomposition.get("required"):
        return errors
    complete_before_done = policy.get("task_decomposition_complete_before_done") is True
    protected = set(policy.get("task_decomposition_required_before_stages", []))
    current_stage = str(item.get("current_stage", ""))
    must_be_complete = (item.get("state") == "done" and complete_before_done) or current_stage in protected
    if not must_be_complete:
        return errors
    if decomposition.get("status") != "complete":
        errors.append(f"{task_id} task_decomposition must be complete before {current_stage or item.get('state')}")
    has_evidence = any(str(decomposition.get(field, "")).strip() for field in TASK_DECOMPOSITION_EVIDENCE_FIELDS)
    has_subtasks = any(str(entry).strip() for entry in decomposition.get("subtasks", []))
    if not has_evidence and not has_subtasks:
        errors.append(f"{task_id} task_decomposition missing summary, next_task, evidence_path, or subtasks")
    return errors


def requirements_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    requirements = normalized_requirements(item)
    if requirements.get("status") not in REQUIREMENT_STATUSES:
        errors.append(f"{task_id} requirements invalid status: {requirements.get('status')}")
    if not requirements.get("required"):
        return errors
    protected = set(profile.get("requirement_protected_stages", [])) or REQUIREMENT_PROTECTED_STAGES
    state_done = item.get("state") == "done" and policy.get("requirements_complete_before_done") is True
    stage_protected = item.get("current_stage") in protected and policy.get("requirements_complete_before_protected_stages") is True
    if not state_done and not stage_protected:
        return errors
    if requirements.get("status") != "complete":
        errors.append(f"{task_id} requirements must be complete before {item.get('current_stage') or item.get('state')}")
    if not str(requirements.get("shared_understanding", "")).strip():
        errors.append(f"{task_id} requirements missing shared_understanding")
    if requirements.get("domain_glossary_updated") is not True:
        errors.append(f"{task_id} requirements must confirm domain_glossary_updated")
    if requirements.get("code_docs_cross_checked") is not True:
        errors.append(f"{task_id} requirements must confirm code_docs_cross_checked")
    docs_path = item.get("docs_path")
    if docs_path and not (Path(docs_path) / "01_REQUIREMENT_ANALYSIS.md").exists():
        errors.append(f"{task_id} missing requirement analysis document")
    return errors


def review_gate_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    gate = normalized_review_gate(item, profile, policy)
    if gate.get("status") not in REVIEW_STATUSES:
        errors.append(f"{task_id} review_gate invalid status: {gate.get('status')}")
    open_findings = [finding for finding in gate.get("open_findings", []) if str(finding).strip()]
    if item.get("state") == "done" and gate.get("required"):
        pass_status = policy.get("review_gate_pass_status", "pass")
        if gate.get("status") != pass_status:
            errors.append(f"{task_id} done without review_gate status {pass_status}")
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            errors.append(f"{task_id} done with open review findings")
        latest_review = str(gate.get("latest_review", "")).strip()
        if not latest_review:
            errors.append(f"{task_id} done without review_gate latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not existing_repo_file(latest_review):
            errors.append(f"{task_id} review_gate latest_review must be an existing repository-local file: {latest_review}")
    return errors


def stage_reviews(item: dict) -> dict:
    reviews = item.get("stage_reviews")
    return reviews if isinstance(reviews, dict) else {}


def stage_review_required_for_profile(profile_name: str, policy: dict) -> bool:
    required_profiles = set(policy.get("stage_review_loop_required_for_profiles", []))
    return profile_name in required_profiles


def stage_review_required_stages(policy: dict) -> list[str]:
    configured = policy.get("stage_review_required_before_stage_exit")
    if isinstance(configured, list) and configured:
        return [str(stage) for stage in configured]
    return list(STAGE_REVIEW_REQUIRED_STAGES)


def required_stage_reviews_for_item(item: dict, profile: dict, policy: dict) -> list[str]:
    profile_name = str(item.get("profile", ""))
    if not stage_review_required_for_profile(profile_name, policy):
        return []
    stages = [str(stage) for stage in profile.get("stages", [])]
    current_stage = str(item.get("current_stage", ""))
    required_before_exit = set(stage_review_required_stages(policy))
    if item.get("state") in {"done", "archived"}:
        exited = stages
    elif current_stage in stages:
        exited = stages[: stages.index(current_stage)]
    else:
        exited = []
    return [stage for stage in exited if stage in required_before_exit]


def stage_review_errors(task_id: str, item: dict, profile: dict, policy: dict) -> list[str]:
    errors: list[str] = []
    if not isinstance(item.get("stage_reviews", {}), dict):
        return [f"{task_id} stage_reviews must be an object"]
    reviews = stage_reviews(item)
    pass_status = policy.get("review_gate_pass_status", "pass")
    for stage in required_stage_reviews_for_item(item, profile, policy):
        review = reviews.get(stage)
        if not isinstance(review, dict):
            errors.append(f"{task_id} missing stage review for exited stage: {stage}")
            continue
        status = review.get("status")
        if status not in REVIEW_STATUSES:
            errors.append(f"{task_id} stage review {stage} invalid status: {status}")
        if status != pass_status:
            errors.append(f"{task_id} stage review {stage} must be {pass_status}")
        open_findings = [finding for finding in review.get("open_findings", []) if str(finding).strip()]
        if policy.get("review_gate_open_findings_must_be_empty") is True and open_findings:
            errors.append(f"{task_id} stage review {stage} has open findings")
        latest_review = str(review.get("latest_review", "")).strip()
        if not latest_review:
            errors.append(f"{task_id} stage review {stage} missing latest_review")
        elif policy.get("review_gate_latest_review_must_exist") is True and not existing_repo_file(latest_review):
            errors.append(f"{task_id} stage review {stage} latest_review must be an existing repository-local file: {latest_review}")
    return errors


def task_risk_errors(task_id: str, item: dict, profile: dict) -> list[str]:
    risk = str(item.get("risk", ""))
    max_risk = str(profile.get("max_risk", ""))
    if risk not in RISK_ORDER:
        return [f"{task_id} invalid risk: {risk}"]
    if max_risk not in RISK_ORDER:
        return [f"{task_id} profile invalid max_risk: {max_risk}"]
    if RISK_ORDER[risk] > RISK_ORDER[max_risk]:
        return [f"{task_id} risk {risk} exceeds profile {item.get('profile')} max_risk {max_risk}"]
    return []


def human_review_errors(task_id: str, item: dict, policy: dict) -> list[str]:
    if str(item.get("risk", "")) not in set(policy.get("human_review_required_for_risks", ["high", "critical"])):
        return []
    legacy = policy.get("human_review_legacy_exemptions", [])
    exemption = next((entry for entry in legacy if isinstance(entry, dict) and entry.get("task_id") == task_id), None)
    enforcement_started = parse_utc(policy.get("human_review_enforcement_started_at"))
    completed_at = parse_utc(item.get("updated_at"))
    if exemption is not None and item.get("state") in {"done", "archived"} and completed_at and enforcement_started and completed_at < enforcement_started:
        return []
    protected_states = set(policy.get("human_review_required_before_states", ["done", "archived"]))
    protected_stages = set(policy.get("human_review_required_before_stages", ["verification", "handoff", "finish"]))
    if item.get("state") not in protected_states and item.get("current_stage") not in protected_stages:
        return []
    review = stage_reviews(item).get("human_review")
    if not isinstance(review, dict):
        return [f"{task_id} requires human_review evidence for risk {item.get('risk')}"]
    errors: list[str] = []
    if review.get("status") != policy.get("review_gate_pass_status", "pass"):
        errors.append(f"{task_id} human_review must be pass")
    if any(str(finding).strip() for finding in review.get("open_findings", [])):
        errors.append(f"{task_id} human_review has open findings")
    latest_review = str(review.get("latest_review", "")).strip()
    if not latest_review:
        errors.append(f"{task_id} human_review missing latest_review")
    elif policy.get("review_gate_latest_review_must_exist") is True and not existing_repo_file(latest_review):
        errors.append(f"{task_id} human_review latest_review must be an existing repository-local file: {latest_review}")
    evidence = review.get("evidence")
    if not isinstance(evidence, dict):
        return errors + [f"{task_id} human_review evidence must be an object"]
    for field in policy.get("human_review_required_fields") or DEFAULT_HUMAN_REVIEW_FIELDS:
        value = evidence.get(field)
        if field in {"files_reviewed", "high_risk_paths_checked"}:
            if not isinstance(value, list) or not any(str(entry).strip() for entry in value):
                errors.append(f"{task_id} human_review evidence missing {field}")
        elif not str(value or "").strip():
            errors.append(f"{task_id} human_review evidence missing {field}")
    if evidence.get("reviewer_type") != "human":
        errors.append(f"{task_id} human_review reviewer_type must be human")
    return errors


def check_task_board() -> list[str]:
    board = load_json(Path(".agent/task-board.json"), {})
    profiles = load_json(Path(".agent/workflow-profiles.json"), {})
    errors: list[str] = []
    if board.get("schema") != "agent-task-board-v1":
        errors.append(".agent/task-board.json schema must be agent-task-board-v1")
    required_fields = set(board.get("required_fields", []))
    ids: set[str] = set()
    states = set(board.get("states", []))
    profile_names = set(profiles.get("profiles", {}))
    policy = board.get("policy", {})
    for field in ("id", "title", "state", "risk", "profile", "current_stage", "docs_path", "requirements", "task_decomposition", "review_gate", "stage_reviews"):
        if field not in required_fields:
            errors.append(f"task board missing required field declaration: {field}")
    if set(policy.get("done_requires_review_gate_pass_for_profiles", [])) != {"tiny", "bugfix", "standard", "full"}:
        errors.append("task board must require review_gate pass for all task profiles")
    if set(policy.get("goal_contract_required_for_profiles", [])) != {"bugfix", "standard", "full"}:
        errors.append("task board must require goal_contract for bugfix, standard, and full profiles")
    if set(policy.get("goal_contract_required_states", [])) != {"active", "review", "done"}:
        errors.append("task board must require goal_contract for active, review, and done states")
    if not {"plan", "implementation", "verification", "handoff"}.issubset(set(policy.get("goal_contract_required_before_stages", []))):
        errors.append("task board must require goal_contract before protected implementation stages")
    if set(policy.get("goal_contract_required_fields", [])) != set(GOAL_CONTRACT_REQUIRED_FIELDS):
        errors.append("task board goal_contract required fields must match generated policy")
    if set(policy.get("task_decomposition_required_for_profiles", [])) != {"tiny", "bugfix", "standard", "full"}:
        errors.append("task board must require task_decomposition for all task profiles")
    if policy.get("task_decomposition_complete_before_done") is not True:
        errors.append("task board must require task_decomposition before done")
    if policy.get("review_fix_loop_required_at_stage_exit") is not True:
        errors.append("task board must require review-fix loops at stage exit")
    if set(policy.get("stage_review_loop_required_for_profiles", [])) != {"standard", "full"}:
        errors.append("task board must require stage review loops for standard and full profiles")
    if set(policy.get("human_review_required_for_risks", [])) != {"high", "critical"}:
        errors.append("task board must require human review for high and critical risks")
    if set(policy.get("human_review_required_before_states", [])) != {"done", "archived"}:
        errors.append("task board human review protected states must be done and archived")
    if set(policy.get("human_review_required_before_stages", [])) != {"verification", "handoff", "finish"}:
        errors.append("task board human review protected stages must be verification, handoff, and finish")
    if set(policy.get("human_review_required_fields", [])) != set(DEFAULT_HUMAN_REVIEW_FIELDS):
        errors.append("task board human review required fields must match generated policy")
    legacy = policy.get("human_review_legacy_exemptions", [])
    if not isinstance(legacy, list):
        errors.append("task board human_review_legacy_exemptions must be a list")
        legacy = []
    items_by_id = {str(item.get("id", "")): item for item in board.get("items", []) if isinstance(item, dict)}
    enforcement_started = parse_utc(policy.get("human_review_enforcement_started_at"))
    if enforcement_started is None or enforcement_started > datetime.now(timezone.utc):
        errors.append("task board human_review_enforcement_started_at must be a valid non-future UTC timestamp")
    legacy_ids: set[str] = set()
    for entry in legacy:
        if not isinstance(entry, dict):
            errors.append("task board human review legacy exemption must be an object")
            continue
        task_id = str(entry.get("task_id", ""))
        if not task_id or task_id in legacy_ids:
            errors.append(f"task board human review legacy exemption has missing or duplicate task_id: {task_id}")
            continue
        legacy_ids.add(task_id)
        task = items_by_id.get(task_id)
        if not task or task.get("state") not in {"done", "archived"}:
            errors.append(f"task board human review legacy exemption must reference a terminal task: {task_id}")
        elif enforcement_started is None or parse_utc(task.get("updated_at")) is None or parse_utc(task.get("updated_at")) >= enforcement_started:
            errors.append(f"task board human review legacy exemption must predate policy enforcement: {task_id}")
        if not str(entry.get("reason", "")).strip():
            errors.append(f"task board human review legacy exemption missing reason: {task_id}")
        if not existing_repo_file(str(entry.get("evidence", "")).strip()):
            errors.append(f"task board human review legacy exemption evidence must be an existing repository-local file: {task_id}")
    for item in board.get("items", []):
        task_id = item.get("id")
        if not task_id:
            errors.append("task missing id")
            continue
        for field in required_fields:
            if field not in item:
                errors.append(f"{task_id} missing field: {field}")
        if task_id in ids:
            errors.append(f"duplicate task id: {task_id}")
        ids.add(task_id)
        if item.get("state") not in states:
            errors.append(f"{task_id} invalid state: {item.get('state')}")
        if item.get("profile") not in profile_names:
            errors.append(f"{task_id} invalid profile: {item.get('profile')}")
            continue
        profile = profiles.get("profiles", {}).get(item.get("profile"), {})
        allowed_stages = set(profile.get("stages", []))
        if allowed_stages and item.get("current_stage") not in allowed_stages:
            errors.append(f"{task_id} invalid current_stage for profile {item.get('profile')}: {item.get('current_stage')}")
        errors.extend(task_risk_errors(task_id, item, profile))
        if item.get("state") == "done" and policy.get("done_requires_delivery_conclusion") is True:
            if not str(item.get("delivery_conclusion", "")).strip():
                errors.append(f"{task_id} done without delivery_conclusion")
        errors.extend(requirements_errors(task_id, item, profile, policy))
        errors.extend(task_decomposition_errors(task_id, item, profile, policy))
        errors.extend(goal_contract_errors(task_id, item, policy))
        errors.extend(review_gate_errors(task_id, item, profile, policy))
        errors.extend(stage_review_errors(task_id, item, profile, policy))
        errors.extend(human_review_errors(task_id, item, policy))
        docs_path = item.get("docs_path")
        if profile.get("feature_doc_templates") and (not docs_path or not Path(docs_path).exists()):
            errors.append(f"{task_id} docs_path missing or absent: {docs_path}")
    return errors


