        errors.append("workflow completion gate must require completed spec changes to be archived")
    loop_config = load_json(Path(".agent/loop-engineering.json"), {})
    if loop_config.get("schema") != "agent-loop-engineering-v1":
        errors.append(".agent/loop-engineering.json schema must be agent-loop-engineering-v1")
    loop_policy = loop_config.get("policy", {})
    for key in (
        "loop_contract_required_for_non_tiny_work",
        "bounded_iterations_required",
        "observation_signal_required",
        "stop_conditions_required",
        "evidence_per_iteration_required",
        "same_failure_requires_strategy_change",
        "budget_exhaustion_blocks_completion_claim",
        "human_interrupt_for_high_risk_or_destructive",
        "self_approval_is_not_release_evidence",
        "prevalidate_inputs_before_expensive_work",
        "failed_runs_exit_nonzero",
        "failed_runs_record_evidence_paths",
        "failed_optimization_cannot_be_improvement",
    ):
        if loop_policy.get(key) is not True:
            errors.append(f"loop engineering policy missing {key}")
    if set(loop_gate.get("required_for_profiles", [])) != {"standard", "full"}:
        errors.append("workflow loop_engineering gate must apply to standard and full profiles")
    if loop_gate.get("policy") != ".agent/loop-engineering.json":
        errors.append("workflow loop_engineering gate must point to .agent/loop-engineering.json")
    for loop_type in ("work_loop", "review_fix_loop", "debugging_loop", "eval_optimization_loop", "session_recovery_loop"):
        spec = loop_config.get("loop_types", {}).get(loop_type, {})
        if not spec:
            errors.append(f"loop engineering missing {loop_type}")
            continue
        if not spec.get("sequence") or not spec.get("observation_signals") or not spec.get("stop_conditions") or not spec.get("evidence"):
            errors.append(f"loop engineering {loop_type} missing sequence, signals, stop conditions, or evidence")
        if loop_type == "eval_optimization_loop":
            if "prevalidate" not in spec.get("sequence", []):
                errors.append("loop engineering eval_optimization_loop must prevalidate inputs")
            if "failed_run" not in spec.get("stop_conditions", []):
                errors.append("loop engineering eval_optimization_loop must stop on failed_run")
        if not isinstance(spec.get("default_iteration_budget"), int) or spec.get("default_iteration_budget") < 1:
            errors.append(f"loop engineering {loop_type} budget must be positive")
    if workflow_stages:
        for name, profile in profiles.get("profiles", {}).items():
            if name in {"tiny", "bugfix", "standard", "full"} and profile.get("review_gate_required") is not True:
                errors.append(f"workflow profile {name} must require review gate")
            if name in {"tiny", "bugfix", "standard", "full"}:
                stages = set(profile.get("stages", []))
                for stage in ("goal_refinement", "task_decomposition"):
                    if stage not in stages:
                        errors.append(f"workflow profile {name} missing {stage}")
            for stage in profile.get("stages", []):
                if stage not in workflow_stages:
                    errors.append(f"workflow profile {name} references unknown stage: {stage}")
    if check_enabled(config, "dev_map") and not Path("docs/DEV_MAP.md").exists():
        errors.append("docs/DEV_MAP.md is missing")
    if check_enabled(config, "skill_hygiene"):
        hygiene_path = Path(config.get("checks", {}).get("skill_hygiene", {}).get("path", ".agent/skill-hygiene.json"))
        hygiene = load_json(hygiene_path, {})
        if hygiene.get("schema") != "agent-skill-hygiene-v1":
            errors.append(f"{hygiene_path} schema must be agent-skill-hygiene-v1")
        policy = hygiene.get("policy", {})
        for key in ("doctor_is_read_only", "human_confirms_cleanup", "no_auto_delete"):
            if policy.get(key) is not True:
                errors.append(f"{hygiene_path} missing policy: {key}")
        if hygiene.get("canary", {}).get("enabled") is not False:
            errors.append(f"{hygiene_path} canary must be disabled by default")
    if check_enabled(config, "mcp_policy"):
        mcp_path = Path(config.get("checks", {}).get("mcp_policy", {}).get("path", ".agent/mcp-policy.json"))
        mcp = load_json(mcp_path, {})
        if mcp.get("schema") != "agent-mcp-policy-v1":
            errors.append(f"{mcp_path} schema must be agent-mcp-policy-v1")
        if mcp.get("mode") != "optional-disabled-by-default" and not mcp.get("servers"):
            errors.append(f"{mcp_path} must stay disabled by default or define audited servers")
        rules = mcp.get("policy", {})
        for key in (
            "credentials_must_not_be_stored_in_repo",
            "credentials_must_use_vault_or_proxy",
            "sandbox_must_not_receive_raw_credentials",
            "credential_rotation_and_audit_required",
            "destructive_or_release_operations_need_human_approval",
            "record_high_risk_mcp_use_in_runlog",
        ):
            if rules.get(key) is not True:
                errors.append(f"{mcp_path} missing policy: {key}")
        for boundary in ("credential_vault", "credential_proxy"):
            if boundary not in mcp.get("trust_boundaries", {}):
                errors.append(f"{mcp_path} missing trust boundary: {boundary}")
    if check_enabled(config, "resource_catalog"):
        resources_path = Path(config.get("checks", {}).get("resource_catalog", {}).get("path", ".agent/resources.json"))
        resources = load_json(resources_path, {})
        if resources.get("schema") != "agent-resource-catalog-v1":
            errors.append(f"{resources_path} schema must be agent-resource-catalog-v1")
        script = config.get("checks", {}).get("resource_catalog", {}).get("script", "scripts/agent_resources.py")
        if not Path(script).exists():
            errors.append(f"missing {script}")
        else:
            result = subprocess.run([sys.executable, script, "doctor"], text=True, capture_output=True, check=False)
            if result.returncode != 0:
                output = (result.stdout + result.stderr).strip()
                errors.append(f"resource catalog doctor failed: {output}")
    if check_enabled(config, "project_blueprint"):
        blueprint_path = Path(config.get("checks", {}).get("project_blueprint", {}).get("path", ".agent/blueprint.json"))
        blueprint = load_json(blueprint_path, {})
        if blueprint.get("schema") != "agent-blueprint-v1":
            errors.append(f"{blueprint_path} schema must be agent-blueprint-v1")
        for name in ("docs/PROJECT_BLUEPRINT.md", ".agent/templates/project-blueprint.md.tmpl", "scripts/agent_blueprint.py"):
            if not Path(name).exists():
                errors.append(f"missing {name}")
        if Path("scripts/agent_blueprint.py").exists():
            result = subprocess.run([sys.executable, "scripts/agent_blueprint.py", "doctor"], text=True, capture_output=True, check=False)
            if result.returncode != 0:
                output = (result.stdout + result.stderr).strip()
                errors.append(f"project blueprint doctor failed: {output}")
    if check_enabled(config, "frontend_governance"):
        frontend_check = config.get("checks", {}).get("frontend_governance", {})
        frontend_path = Path(frontend_check.get("path", ".agent/frontend.json"))
        frontend = load_json(frontend_path, {})
        if frontend.get("schema") != "agent-frontend-governance-v1":
            errors.append(f"{frontend_path} schema must be agent-frontend-governance-v1")
        for name in (
            frontend_check.get("doc", "docs/FRONTEND_GOVERNANCE.md"),
            frontend_check.get("script", "scripts/agent_frontend.py"),
        ):
            if not Path(name).exists():
                errors.append(f"missing {name}")
        script = frontend_check.get("script", "scripts/agent_frontend.py")
        if Path(script).exists():
            result = subprocess.run([sys.executable, script, "doctor"], text=True, capture_output=True, check=False)
            if result.returncode != 0:
                output = (result.stdout + result.stderr).strip()
                errors.append(f"frontend governance doctor failed: {output}")
    return errors


def check_contract_control_surfaces(config: dict) -> list[str]:
    errors: list[str] = []
    checks = config.get("checks", {})
    for name in ("governance_presets", "capability_providers", "strict_agent_contracts", "regression_criteria", "component_expiry"):
        if name not in checks:
            errors.append(f".agent/mechanical-checks.json missing check {name}")
    fixtures = checks.get("strict_agent_contracts", {}).get("negative_fixtures", [])
    if not isinstance(fixtures, list) or not fixtures:
        errors.append(".agent/mechanical-checks.json strict_agent_contracts must define negative_fixtures")

    manifest = load_json(Path(".agent/manifest.json"), {})
    presets = manifest.get("governance_presets", {})
    preset_policy = presets.get("policy", {})
    for key in ("source_status_required", "version_or_revision_required", "permission_scope_required", "blocked_sources_cannot_apply", "no_automatic_dependency_install"):
        if preset_policy.get(key) is not True:
            errors.append(f".agent/manifest.json governance_presets policy missing {key}")
    if not presets.get("selected"):
        errors.append(".agent/manifest.json governance_presets.selected must be non-empty")
    for item in presets.get("selected", []):
        for key in ("id", "source_kind", "source_status", "version", "owner", "permission_scope", "generated_paths", "validation", "conflict_behavior", "dry_run_supported", "auto_install_dependencies"):
            if key not in item:
                errors.append(f"governance preset entry missing {key}")
        if item.get("source_status") not in {"verified", "partial", "blocked"}:
            errors.append("governance preset source_status must be verified, partial, or blocked")
        if item.get("auto_install_dependencies") is not False:
            errors.append("governance preset must not auto-install dependencies")

    capabilities = load_json(Path(".agent/capabilities.json"), {})
    status_values = set(capabilities.get("provider_status_values", []))
    if not {"present", "missing", "unknown", "degraded"}.issubset(status_values):
        errors.append(".agent/capabilities.json missing provider status values")
    policy = capabilities.get("policy", {})
    for key in ("provider_status_required", "required_provider_missing_blocks_readiness", "optional_provider_requires_fallback"):
        if policy.get(key) is not True:
            errors.append(f".agent/capabilities.json policy missing {key}")
    for item in capabilities.get("capabilities", []):
        cap_id = item.get("id", "<missing-id>")
        for key in ("required", "status", "fallback"):
            if key not in item:
                errors.append(f"capability {cap_id} missing {key}")
        if item.get("status") not in status_values:
            errors.append(f"capability {cap_id} has invalid status")
        if item.get("required") is True and item.get("status") != "present":
            errors.append(f"required capability {cap_id} is not present")
        if item.get("required") is not True and not str(item.get("fallback", "")).strip():
            errors.append(f"optional capability {cap_id} missing fallback")

    baselines = load_json(Path(".agent/baselines.json"), {})
    criteria = baselines.get("regression_criteria", [])
    if not isinstance(criteria, list) or not criteria:
        errors.append(".agent/baselines.json must define regression_criteria")
    for item in criteria:
        for key in ("id", "baseline_behavior", "expected_behavior", "validation", "protected_invariants", "rejected_regressions"):
            if key not in item:
                errors.append(f"regression criteria entry missing {key}")
    baseline_policy = baselines.get("policy", {})
    if baseline_policy.get("snapshot_content_is_immutable") is not True:
        errors.append(".agent/baselines.json must make snapshot content immutable")
    if set(baseline_policy.get("snapshot_lifecycle_values", [])) != {"active", "historical", "superseded", "retained"}:
        errors.append(".agent/baselines.json snapshot lifecycle values are invalid")
    if baseline_policy.get("historical_retention_review_required") is not True or baseline_policy.get("snapshot_sha256_required") is not True:
        errors.append(".agent/baselines.json historical retention review and SHA-256 must be required")

    gc_config = load_json(Path(".agent/governance-gc.json"), {})
    if gc_config.get("checks", {}).get("component_expiry") is not True:
        errors.append(".agent/governance-gc.json checks must enable component_expiry")
    if gc_config.get("policy", {}).get("report_warnings_without_failing_by_default") is not True:
        errors.append(".agent/governance-gc.json must report warnings without failing by default")
    if not isinstance(gc_config.get("policy", {}).get("fail_on_warning"), bool):
        errors.append(".agent/governance-gc.json fail_on_warning must be boolean")
    components = gc_config.get("component_expiry", {}).get("components", [])
    if not isinstance(components, list) or not components:
        errors.append(".agent/governance-gc.json component_expiry.components must be non-empty")
    for item in components:
        for key in ("id", "kind", "owner", "purpose", "load_bearing", "last_reviewed", "review_cadence", "validation", "renewal_path", "removal_path"):
            if key not in item:
                errors.append(f"component_expiry entry missing {key}")
    return errors


def iter_markdown_roots(roots: list[str]) -> list[Path]:
    files: list[Path] = []
    for root in roots:
        path = Path(root)
        if not path.exists():
            continue
        if path.is_file() and path.suffix.lower() in {".md", ".tmpl"}:
            files.append(path)
        elif path.is_dir():
            files.extend(item for item in path.rglob("*") if item.is_file() and item.suffix.lower() in {".md", ".tmpl"})
    return files


def check_markdown_links(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("markdown_links", {})
    broken: list[str] = []
    for path in iter_markdown_roots(spec.get("roots", [])):
        text = path.read_text(encoding="utf-8", errors="ignore")
        for match in MARKDOWN_LINK_RE.finditer(text):
            target = match.group(1).split("#", 1)[0].strip()
            if not target or target.startswith(("http://", "https://", "mailto:", "tel:")):
                continue
            if target.startswith("<") and target.endswith(">"):
                target = target[1:-1]
            if "://" in target:
                continue
            resolved = (path.parent / target).resolve()
            try:
                resolved.relative_to(Path.cwd().resolve())
            except ValueError:
                continue
            if not resolved.exists():
                broken.append(f"{path}: broken local link: {target}")
    return broken


def render_json_template_errors(config: dict) -> list[str]:
    spec = config.get("checks", {}).get("template_rendering", {})
    placeholder = str(spec.get("placeholder_value", "agent-gov-placeholder"))
    errors: list[str] = []
    for name in spec.get("json_templates", []):
        path = Path(name)
        if not path.exists():
            errors.append(f"missing json template: {name}")
            continue
        text = path.read_text(encoding="utf-8", errors="ignore")
        rendered = re.sub(r"\{\{[A-Za-z0-9_. -]+\}\}", placeholder, text)
        try:
            json.loads(rendered)
        except json.JSONDecodeError as exc:
            errors.append(f"invalid rendered json template: {name}: {exc}")
    return errors


def is_ignored(path: Path, ignore_dirs: list[str]) -> bool:
    parts = set(path.parts)
    return any(part in parts for part in ignore_dirs)


def count_test_files(config: dict) -> int:
    spec = config.get("checks", {}).get("test_baseline", {})
    ignore_dirs = list(spec.get("ignore_dirs", []))
    matches: set[Path] = set()
    for pattern in spec.get("globs", []):
        for path in Path(".").rglob("*"):
            if not path.is_file() or is_ignored(path, ignore_dirs):
                continue
            relative = path.as_posix().removeprefix("./")
            if fnmatch.fnmatch(relative, pattern):
                matches.add(path)
    return len(matches)


def collect_snapshot() -> dict:
    config = load_json(CONFIG_PATH, {})
    checks = config.get("checks", {})
    json_invalid = check_json(checks.get("json_integrity", {}).get("paths", [])) if check_enabled(config, "json_integrity") else []
    jsonl_invalid = check_jsonl(checks.get("jsonl_integrity", {}).get("paths", [])) if check_enabled(config, "jsonl_integrity") else []
    if check_enabled(config, "jsonl_integrity"):
        jsonl_invalid.extend(check_jsonl_glob(checks.get("jsonl_integrity", {}).get("session_offload_glob", "")))
    missing_required = check_required_paths() if check_enabled(config, "required_paths") else []
    missing_templates = check_feature_templates(config) if check_enabled(config, "feature_templates") else []
    task_board_errors = check_task_board() if check_enabled(config, "task_board") else []
    role_contract_errors = check_role_contracts() if check_enabled(config, "role_contracts") else []
    governance_config_errors = check_governance_configs(config) if check_enabled(config, "manifest") else []
    contract_surface_errors = check_contract_control_surfaces(config)
    knowledge_governance_errors = check_knowledge_governance(config) if check_enabled(config, "knowledge_governance") else []
    skill_runtime_errors = check_skill_runtime(config) if check_enabled(config, "skill_runtime") else []
    skill_optimization_errors = check_skill_optimization(config) if check_enabled(config, "skill_optimization") else []
    session_offload_errors = check_session_offload(config) if check_enabled(config, "session_offload") else []
    template_errors = render_json_template_errors(config) if check_enabled(config, "template_rendering") else []
    broken_links = check_markdown_links(config) if check_enabled(config, "markdown_links") else []
    test_file_count = count_test_files(config) if check_enabled(config, "test_baseline") else 0
    findings = {
        "invalid_json": json_invalid,
        "invalid_jsonl": jsonl_invalid,
        "missing_required_paths": missing_required,
        "missing_feature_templates": missing_templates,
        "task_board": task_board_errors,
        "role_contracts": role_contract_errors,
        "governance_configs": governance_config_errors,
        "agent_contract_surfaces": contract_surface_errors,
        "knowledge_governance": knowledge_governance_errors,
        "skill_runtime": skill_runtime_errors,
        "skill_optimization": skill_optimization_errors,
        "session_offload": session_offload_errors,
        "template_rendering": template_errors,
        "broken_local_links": broken_links,
    }
    counts = {key: len(value) for key, value in findings.items()}
    counts["test_files"] = test_file_count
    return {
        "schema": "agent-verify-snapshot-v1",
        "created_at": utc_now(),
        "counts": counts,
        "findings": findings,
    }


def snapshot_has_hard_fail(snapshot: dict) -> bool:
    counts = snapshot.get("counts", {})
    hard_keys = [
        "invalid_json",
        "invalid_jsonl",
        "missing_required_paths",
        "missing_feature_templates",
        "task_board",
        "role_contracts",
        "governance_configs",
        "agent_contract_surfaces",
        "knowledge_governance",
        "skill_runtime",
        "skill_optimization",
        "session_offload",
        "template_rendering",
    ]
    return any(counts.get(key, 0) > 0 for key in hard_keys)


def print_snapshot(snapshot: dict) -> None:
    print(json.dumps(snapshot, indent=2))


def write_snapshot(name: str, snapshot: dict) -> Path:
    if not re.match(r"^[a-zA-Z0-9._-]{1,80}$", name):
        raise SystemExit("error: snapshot name must be alphanumeric with dot, underscore, or hyphen")
    baselines = load_json(BASELINES_PATH, {"schema": "agent-baselines-v1", "snapshots": []})
    entries = baselines.get("snapshots", [])
    if not isinstance(entries, list):
        raise SystemExit("error: baseline snapshots must be a list")
    snapshot_dir = Path(baselines.get("snapshot_dir", ".agent/baselines"))
    if snapshot_dir.is_absolute():
        raise SystemExit("error: baseline snapshot_dir must be repository-relative")
    path = snapshot_dir / f"{name}.json"
    try:
        path.resolve(strict=False).relative_to(Path.cwd().resolve())
    except ValueError:
        raise SystemExit("error: baseline snapshot path escapes the repository") from None
    if path.exists() or any(entry.get("name") == name for entry in entries if isinstance(entry, dict)):
        raise SystemExit(f"error: baseline snapshot already exists: {name}; use a new immutable snapshot name")
    write_json(path, snapshot)
    item = {"name": name, "path": str(path), "created_at": snapshot["created_at"], "lifecycle": "active", "sha256": sha256_file(path)}
    existing = list(entries)
    existing.append(item)
    baselines["snapshots"] = existing
    baselines["latest_snapshot"] = str(path)
    write_json(BASELINES_PATH, baselines)
    return path


def cmd_doctor(args: argparse.Namespace) -> int:
    config = load_json(CONFIG_PATH)
    if config.get("schema") != "agent-mechanical-checks-v1":
        print("error: .agent/mechanical-checks.json schema must be agent-mechanical-checks-v1")
        return 1
    snapshot = collect_snapshot()
    if args.json:
        print_snapshot(snapshot)
    if snapshot_has_hard_fail(snapshot):
        for category, findings in snapshot["findings"].items():
            for finding in findings:
                print(f"error: {category}: {finding}")
        return 1
    print("agent mechanical verification doctor passed")
    return 0


def cmd_snapshot(args: argparse.Namespace) -> int:
    snapshot = collect_snapshot()
    if args.name:
        path = write_snapshot(args.name, snapshot)
        print(f"snapshot: {path}")
    if args.json or not args.name:
        print_snapshot(snapshot)
    return 1 if args.fail_on_issue and snapshot_has_hard_fail(snapshot) else 0


def cmd_compare(args: argparse.Namespace) -> int:
    before = load_json(Path(args.before))
    after = load_json(Path(args.after))
    regressions: list[str] = []
    issue_keys = sorted(set(before.get("findings", {})) | set(after.get("findings", {})))
    for key in issue_keys:
        before_count = int(before.get("counts", {}).get(key, 0))
        after_count = int(after.get("counts", {}).get(key, 0))
        if after_count > before_count:
            regressions.append(f"{key}: {before_count} -> {after_count}")
    before_tests = int(before.get("counts", {}).get("test_files", 0))
    after_tests = int(after.get("counts", {}).get("test_files", 0))
    if before_tests and after_tests < before_tests:
        regressions.append(f"test_files: {before_tests} -> {after_tests}")
    report = {
        "schema": "agent-verify-compare-v1",
        "created_at": utc_now(),
        "before": args.before,
        "after": args.after,
        "regressions": regressions,
    }
    print(json.dumps(report, indent=2))
    return 1 if regressions else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Run hard mechanical checks")
    doctor.add_argument("--json", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    snapshot = subparsers.add_parser("snapshot", help="Capture a baseline snapshot")
    snapshot.add_argument("--name", help="Write snapshot to .agent/baselines/<name>.json")
    snapshot.add_argument("--json", action="store_true")
    snapshot.add_argument("--fail-on-issue", action="store_true")
    snapshot.set_defaults(func=cmd_snapshot)

    compare = subparsers.add_parser("compare", help="Compare two snapshots")
    compare.add_argument("--before", required=True)
    compare.add_argument("--after", required=True)
    compare.set_defaults(func=cmd_compare)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
