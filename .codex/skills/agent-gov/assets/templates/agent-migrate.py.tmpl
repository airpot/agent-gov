#!/usr/bin/env python3
"""Check whether the local agent-gov scaffold needs a non-destructive migration."""

from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


LATEST_MANIFEST_VERSION = 1
PROFILES = {"core", "standard", "full"}
LEGACY_CONFIG_PATH_KEYS = {
    "session_root",
    "governance_manifest",
    "harness_config",
    "project_layout",
    "spec_config",
    "spec_root",
    "workflow_config",
    "workflow_profiles",
    "worktree_policy",
    "risk_zones",
    "review_policy",
    "subagent_config",
    "hooks_config",
    "role_contracts",
    "task_board",
    "knowledge_manifest",
    "dev_map",
    "skill_hygiene",
    "memory_config",
    "context_config",
    "capabilities_config",
    "tooling_config",
    "security_config",
    "evals_config",
    "mechanical_checks",
    "baselines",
    "harness_evolution",
    "mcp_policy",
    "governance_gc",
    "governance_score",
    "runlog",
    "skill_distribution",
    "codex_config",
    "codex_hooks",
    "claude_settings",
}


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_json(path: Path) -> tuple[dict, str | None]:
    if not path.exists():
        return {}, f"missing {path}"
    try:
        return json.loads(path.read_text(encoding="utf-8")), None
    except json.JSONDecodeError as exc:
        return {}, f"invalid JSON in {path}: {exc}"
    except OSError as exc:
        return {}, f"cannot read {path}: {exc}"


def required_paths(harness: dict) -> list[str]:
    values = harness.get("invariants", {}).get("required_paths", [])
    return values if isinstance(values, list) else []


