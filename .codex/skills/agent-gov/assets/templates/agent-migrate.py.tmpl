def config_path_pointers(config: dict) -> dict[str, str]:
    paths = config.get("paths", {})
    if isinstance(paths, dict) and paths:
        return {str(key): str(value) for key, value in paths.items() if isinstance(value, str)}
    return {
        key: value
        for key, value in config.items()
        if key in LEGACY_CONFIG_PATH_KEYS and isinstance(value, str) and value
    }


def path_exists(path: str) -> bool:
    return Path(path).exists()


def check_path_pointers(source: str, values: dict[str, str], errors: list[str], actions: list[dict]) -> None:
    missing = sorted(f"{key}: {path}" for key, path in values.items() if not path_exists(path))
    if not missing:
        return
    errors.append(f"{source} has {len(missing)} pointer(s) to missing paths")
    actions.append(
        {
            "kind": "pointer-review",
            "path": source,
            "summary": "Remove stale path pointers or generate the referenced profile files.",
            "paths": missing[:30],
        }
    )


def harness_path_pointers(harness: dict) -> dict[str, str]:
    pointers: dict[str, str] = {}
    for key, value in harness.get("observability", {}).items():
        if isinstance(value, str):
            pointers[f"observability.{key}"] = value
    knowledge = harness.get("knowledge", {})
    for key in ("index", "manifest"):
        value = knowledge.get(key)
        if isinstance(value, str):
            pointers[f"knowledge.{key}"] = value
    for index, value in enumerate(knowledge.get("required_docs", [])):
        if isinstance(value, str):
            pointers[f"knowledge.required_docs[{index}]"] = value
    return pointers


def collect_plan() -> dict:
    errors: list[str] = []
    warnings: list[str] = []
    actions: list[dict] = []

    config, error = read_json(Path(".agent/config.json"))
    if error:
        errors.append(error)
        config = {}
    elif config.get("schema") != "agent-project-config-v1":
        errors.append(".agent/config.json schema must be agent-project-config-v1")
    else:
        check_path_pointers(".agent/config.json", config_path_pointers(config), errors, actions)

    profile = config.get("governance_profile")
    if not profile:
        warnings.append(".agent/config.json missing governance_profile; assuming full for legacy scaffold")
        actions.append(
            {
                "kind": "manual-edit",
                "path": ".agent/config.json",
                "summary": "Add governance_profile as core, standard, or full.",
            }
        )
        profile = "full"
    elif profile not in PROFILES:
        errors.append(f".agent/config.json governance_profile must be one of {', '.join(sorted(PROFILES))}")

    manifest, error = read_json(Path(".agent/manifest.json"))
    if error:
        errors.append(error)
        manifest = {}
        actions.append(
            {
                "kind": "regenerate",
                "path": ".agent/manifest.json",
                "summary": "Regenerate the manifest with agent-gov initializer or restore it from version control.",
            }
        )
    elif manifest.get("schema") != "agent-governance-manifest-v1":
        errors.append(".agent/manifest.json schema must be agent-governance-manifest-v1")

    manifest_version = int(manifest.get("manifest_version", 0) or 0)
    if manifest_version < LATEST_MANIFEST_VERSION:
        actions.append(
            {
                "kind": "upgrade",
                "path": ".agent/manifest.json",
                "summary": f"Upgrade manifest_version {manifest_version} to {LATEST_MANIFEST_VERSION}.",
            }
        )
    elif manifest_version > LATEST_MANIFEST_VERSION:
        warnings.append(f"manifest_version {manifest_version} is newer than this script understands")

    harness, error = read_json(Path(".agent/harness.json"))
    if error:
        errors.append(error)
        harness = {}
    elif harness.get("schema") != "agent-harness-v1":
        errors.append(".agent/harness.json schema must be agent-harness-v1")
    else:
        check_path_pointers(".agent/harness.json", harness_path_pointers(harness), errors, actions)

    required = required_paths(harness)
    manifest_required = manifest.get("required_paths", [])
    if required and manifest_required and sorted(required) != sorted(manifest_required):
        errors.append(".agent/manifest.json required_paths must match .agent/harness.json invariants.required_paths")
        actions.append(
            {
                "kind": "regenerate",
                "path": ".agent/manifest.json",
                "summary": "Refresh manifest required_paths from .agent/harness.json.",
            }
        )

    if profile in PROFILES:
        floor = profile_floor_paths(profile)
        missing_from_harness = sorted(path for path in floor if path not in required)
        if missing_from_harness:
            warnings.append(f"{len(missing_from_harness)} expected {profile} path(s) are not listed in harness required_paths")
            actions.append(
                {
                    "kind": "harness-review",
                    "path": ".agent/harness.json",
                    "summary": "Review whether profile-level required paths should be added.",
                    "paths": missing_from_harness[:20],
                }
            )

    missing_required = [path for path in required if not Path(path).exists()]
    if missing_required:
        errors.append(f"{len(missing_required)} required path(s) are missing")
        actions.append(
            {
                "kind": "restore-or-generate",
                "path": ".agent/harness.json",
                "summary": "Restore missing required files or rerun initialization without overwriting unrelated project files.",
                "paths": missing_required[:30],
            }
        )

    evals, error = read_json(Path(".agent/evals.json"))
    if error:
        errors.append(error)
        evals = {}
    elif evals.get("schema") != "agent-evals-v1":
        errors.append(".agent/evals.json schema must be agent-evals-v1")

    score_dimensions = sorted(evals.get("dimensions", {}))
    manifest_dimensions = sorted(manifest.get("score_dimensions", []))
    if score_dimensions and manifest_dimensions and score_dimensions != manifest_dimensions:
        errors.append(".agent/manifest.json score_dimensions must match .agent/evals.json dimensions")
        actions.append(
            {
                "kind": "regenerate",
                "path": ".agent/manifest.json",
                "summary": "Refresh manifest score_dimensions from .agent/evals.json.",
            }
        )

    json_schemas = manifest.get("json_schemas", {})
    if isinstance(json_schemas, dict):
        for path, schema in json_schemas.items():
            data, json_error = read_json(Path(path))
            if json_error:
                errors.append(json_error)
                continue
            if schema and data.get("schema") != schema:
                errors.append(f"{path} schema must be {schema}")

    status = "fail" if errors else "warn" if warnings or actions else "pass"
    return {
        "schema": "agent-migration-plan-v1",
        "created_at": utc_now(),
        "latest_manifest_version": LATEST_MANIFEST_VERSION,
        "governance_profile": profile,
        "status": status,
        "errors": errors,
        "warnings": warnings,
        "actions": actions,
        "non_destructive": True,
    }


def print_human(plan: dict) -> None:
    for error in plan["errors"]:
        print(f"error: {error}")
    for warning in plan["warnings"]:
        print(f"warning: {warning}")
    for action in plan["actions"]:
        print(f"action: {action['kind']}: {action['summary']} ({action.get('path', 'repo')})")
        for path in action.get("paths", [])[:10]:
            print(f"  - {path}")
    if not plan["errors"] and not plan["warnings"] and not plan["actions"]:
        print("agent migration doctor passed")


def cmd_doctor(args: argparse.Namespace) -> int:
    plan = collect_plan()
    if args.json:
        print(json.dumps(plan, indent=2))
    else:
        print_human(plan)
    return 1 if plan["errors"] else 0


def cmd_plan(args: argparse.Namespace) -> int:
    plan = collect_plan()
    if args.json:
        print(json.dumps(plan, indent=2))
    else:
        print_human(plan)
        print(f"migration status: {plan['status']}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Fail when the scaffold is inconsistent")
    doctor.add_argument("--json", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    plan = subparsers.add_parser("plan", help="Print non-destructive migration recommendations")
    plan.add_argument("--json", action="store_true")
    plan.set_defaults(func=cmd_plan)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
