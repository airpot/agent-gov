#!/usr/bin/env python3
"""Report governance drift without modifying project files."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


CONFIG_PATH = Path(".agent/governance-gc.json")


def utc_now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path, fallback: dict | None = None) -> dict:
    if not path.exists():
        if fallback is not None:
            return fallback
        raise SystemExit(f"error: missing {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: invalid JSON in {path}: {exc}")


def write_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def confined_repo_file(value: object) -> Path | None:
    if not isinstance(value, str) or not value or Path(value).is_absolute():
        return None
    try:
        resolved = Path(value).resolve(strict=True)
        resolved.relative_to(Path.cwd().resolve())
    except (OSError, ValueError):
        return None
    return resolved if resolved.is_file() else None


def parse_date(value: str) -> datetime | None:
    for fmt in ("%Y-%m-%d", "%Y-%m-%dT%H:%M:%SZ"):
        try:
            return datetime.strptime(value, fmt).replace(tzinfo=timezone.utc)
        except (TypeError, ValueError):
            continue
    return None


def days_since(value: str) -> int | None:
    parsed = parse_date(value)
    if parsed is None:
        return None
    return (datetime.now(timezone.utc) - parsed).days


def date_error(value: object, field: str) -> str:
    parsed = parse_date(value) if isinstance(value, str) else None
    if parsed is None:
        return f"{field} is invalid"
    if parsed > datetime.now(timezone.utc):
        return f"{field} must not be in the future"
    return ""


def finding(kind: str, severity: str, summary: str, path: str = "") -> dict:
    return {"kind": kind, "severity": severity, "summary": summary, "path": path}


def validate_schema(path: Path, schema: str) -> list[dict]:
    data = load_json(path, {})
    if data.get("schema") != schema:
        return [finding("schema", "error", f"{path} schema must be {schema}", str(path))]
    return []


def check_knowledge(config: dict) -> list[dict]:
    results: list[dict] = []
    knowledge = load_json(Path(".agent/knowledge.json"), {})
    warn_days = int(config.get("policy", {}).get("stale_docs_warn_after_days", 180))
    for doc in knowledge.get("documents", []):
        path = doc.get("path", "")
        if doc.get("owner") == "unassigned":
            results.append(finding("knowledge_owner", "warning", "document owner is unassigned", path))
        age = days_since(doc.get("last_reviewed", ""))
        if age is None:
            results.append(finding("knowledge_date", "warning", "document last_reviewed is invalid", path))
        elif age > warn_days:
            results.append(finding("stale_doc", "warning", f"document not reviewed for {age} days", path))
        if path and not Path(path).exists():
            results.append(finding("missing_doc", "error", "knowledge document is missing", path))
    return results


def check_tasks(config: dict) -> list[dict]:
    results: list[dict] = []
    board = load_json(Path(".agent/task-board.json"), {})
    warn_days = int(config.get("policy", {}).get("active_tasks_warn_after_days", 30))
    for item in board.get("items", []):
        state = item.get("state")
        task_id = item.get("id", "unknown")
        if state in {"active", "blocked", "review"}:
            age = days_since(item.get("updated_at", ""))
            if age is not None and age > warn_days:
                results.append(finding("stale_task", "warning", f"task {task_id} has been {state} for {age} days", item.get("docs_path", "")))
        if state == "done" and not item.get("delivery_conclusion"):
            results.append(finding("task_conclusion", "warning", f"done task {task_id} has no delivery conclusion", item.get("docs_path", "")))
        docs_path = item.get("docs_path")
        if docs_path and not Path(docs_path).exists():
            results.append(finding("task_docs", "error", f"task {task_id} docs_path is missing", docs_path))
    return results


def check_baselines(config: dict) -> list[dict]:
    results: list[dict] = []
    baselines = load_json(Path(".agent/baselines.json"), {})
    warn_days = int(config.get("policy", {}).get("baseline_warn_after_days", 30))
    snapshots = baselines.get("snapshots", [])
    if not isinstance(snapshots, list):
        return [finding("baseline_index", "error", "baseline snapshots must be a list", ".agent/baselines.json")]
    for item in snapshots:
        if not isinstance(item, dict):
            results.append(finding("baseline_index", "error", "baseline snapshot entry must be an object", ".agent/baselines.json"))
            continue
        path = item.get("path", "")
        if not isinstance(path, str) or not path:
            results.append(finding("missing_baseline", "error", "baseline snapshot path is missing"))
            continue
        snapshot_path = confined_repo_file(path)
        if snapshot_path is None:
            results.append(finding("missing_baseline", "error", "baseline snapshot must be an existing repository-local file", path))
            continue
        created_at_error = date_error(item.get("created_at", ""), "baseline created_at")
        if created_at_error:
            results.append(finding("baseline_date", "error", created_at_error, path))
        for field in ("last_reviewed_at", "reviewed_at"):
            if field in item and item.get(field) not in {None, ""}:
                review_date_error = date_error(item.get(field), f"baseline {field}")
                if review_date_error:
                    results.append(finding("baseline_date", "error", review_date_error, path))
        age_source = item.get("last_reviewed_at") or item.get("reviewed_at") or item.get("created_at", "")
        age = days_since(age_source)
        expected_hash = item.get("sha256")
        if not isinstance(expected_hash, str) or len(expected_hash) != 64:
            results.append(finding("baseline_integrity", "error", "baseline snapshot requires SHA-256", path))
        else:
            try:
                actual_hash = sha256_file(snapshot_path)
            except OSError as exc:
                results.append(finding("baseline_integrity", "error", f"unable to hash baseline: {exc}", path))
            else:
                if actual_hash != expected_hash:
                    results.append(finding("baseline_integrity", "error", "baseline snapshot SHA-256 does not match the retention index", path))
        lifecycle = item.get("lifecycle", "active")
        if lifecycle not in {"active", "historical", "superseded", "retained"}:
            results.append(finding("baseline_lifecycle", "error", f"baseline snapshot has invalid lifecycle {lifecycle!r}", path))
            continue
        if lifecycle != "active":
            review = item.get("retention_review")
            if not isinstance(review, dict):
                results.append(finding("baseline_retention", "error", "historical baseline requires structured retention_review", path))
                continue
            reviewed_at = review.get("reviewed_at", "")
            reviewed_at_error = date_error(reviewed_at, "retention_review reviewed_at")
            if reviewed_at_error:
                results.append(finding("baseline_retention", "error", reviewed_at_error, path))
            if review.get("decision") not in {"retain", "supersede"}:
                results.append(finding("baseline_retention", "error", "retention_review decision must be retain or supersede", path))
            if not isinstance(review.get("rationale"), str) or not review.get("rationale", "").strip():
                results.append(finding("baseline_retention", "error", "retention_review rationale is missing", path))
            evidence = review.get("evidence", "")
            if confined_repo_file(evidence) is None:
                results.append(finding("baseline_retention", "error", "retention_review evidence must be an existing repository-local file", path))
            if lifecycle == "superseded" and review.get("decision") != "supersede":
                results.append(finding("baseline_retention", "error", "superseded baseline requires a supersede decision", path))
            if lifecycle in {"historical", "retained"} and review.get("decision") != "retain":
                results.append(finding("baseline_retention", "error", f"{lifecycle} baseline requires a retain decision", path))
        if age is not None and age > warn_days and lifecycle == "active":
            results.append(finding("stale_baseline", "warning", f"baseline snapshot review is {age} days old", path))
    return results


def check_config_pointers() -> list[dict]:
    results: list[dict] = []
    manifest = load_json(Path(".agent/manifest.json"), {})
    manifest_schemas = manifest.get("json_schemas", {})
    expected = {
        path: schema
        for path, schema in manifest_schemas.items()
        if path
        in {
            ".agent/manifest.json",
            ".agent/dev-map.json",
            ".agent/loop-engineering.json",
            ".agent/harness-evolution.json",
            ".agent/resources.json",
            ".agent/skill-runtime.json",
            ".agent/skill-optimization.json",
            ".agent/mcp-policy.json",
            ".agent/governance-gc.json",
        }
    }
    expected.setdefault(".agent/manifest.json", "agent-governance-manifest-v1")
    for name, schema in expected.items():
        path = Path(name)
        if not path.exists():
            results.append(finding("missing_config", "error", f"missing {name}", name))
            continue
        results.extend(validate_schema(path, schema))
    harness = load_json(Path(".agent/harness.json"), {})
    manifest_required = sorted(manifest.get("required_paths", []))
    harness_required = sorted(harness.get("invariants", {}).get("required_paths", []))
    if manifest_required and harness_required and manifest_required != harness_required:
        results.append(finding("manifest", "error", "manifest required_paths differ from harness required_paths", ".agent/manifest.json"))
    dev_map = load_json(Path(".agent/dev-map.json"), {}) if Path(".agent/dev-map.json").exists() else {}
    if dev_map.get("doc") and not Path(dev_map["doc"]).exists():
        results.append(finding("dev_map", "error", "dev map doc is missing", dev_map["doc"]))
    mcp = load_json(Path(".agent/mcp-policy.json"), {}) if Path(".agent/mcp-policy.json").exists() else {}
    if mcp and mcp.get("mode") != "optional-disabled-by-default" and not mcp.get("servers"):
        results.append(finding("mcp_policy", "warning", "MCP policy is not disabled but has no server registry", ".agent/mcp-policy.json"))
    return results


def check_component_expiry(config: dict) -> list[dict]:
    results: list[dict] = []
    section = config.get("component_expiry", {})
    policy = section.get("policy", {})
    components = section.get("components", [])
    if not isinstance(components, list) or not components:
        results.append(finding("component_expiry", "warning", "no governed components recorded", ".agent/governance-gc.json"))
        return results
    warn_days = int(config.get("policy", {}).get("component_review_warn_after_days", 90))
    for item in components:
        component_id = item.get("id", "<missing-id>")
        target = f".agent/governance-gc.json#{component_id}"
        if policy.get("owner_required", True) and not item.get("owner"):
            results.append(finding("component_expiry", "error", f"component {component_id} missing owner", target))
        if policy.get("purpose_required", True) and not item.get("purpose"):
            results.append(finding("component_expiry", "error", f"component {component_id} missing purpose", target))
        if policy.get("load_bearing_requires_validation", True) and item.get("load_bearing") is True and not item.get("validation"):
            results.append(finding("component_expiry", "error", f"load-bearing component {component_id} missing validation", target))
        if policy.get("expiry_or_review_cadence_required", True) and not (item.get("expires_at") or item.get("review_cadence")):
            results.append(finding("component_expiry", "error", f"component {component_id} missing expiry or review cadence", target))
        if policy.get("renewal_or_removal_path_required", True) and not (item.get("renewal_path") and item.get("removal_path")):
            results.append(finding("component_expiry", "error", f"component {component_id} missing renewal or removal path", target))
        age = days_since(item.get("last_reviewed", ""))
        if age is not None and age > warn_days:
            results.append(finding("component_expiry", "warning", f"component {component_id} last reviewed {age} days ago", target))
    return results


def collect_report() -> dict:
    config = load_json(CONFIG_PATH)
    findings: list[dict] = []
    findings.extend(check_config_pointers())
    checks = config.get("checks", {})
    if checks.get("knowledge_owners", True) or checks.get("stale_docs", True):
        findings.extend(check_knowledge(config))
    if checks.get("task_board_stale_active_items", True):
        findings.extend(check_tasks(config))
    if checks.get("baseline_age", True):
        findings.extend(check_baselines(config))
    if checks.get("component_expiry", False):
        findings.extend(check_component_expiry(config))
    error_count = sum(1 for item in findings if item["severity"] == "error")
    warning_count = sum(1 for item in findings if item["severity"] == "warning")
    return {
        "schema": "agent-governance-gc-report-v1",
        "created_at": utc_now(),
        "status": "fail" if error_count else "warn" if warning_count else "pass",
        "counts": {"errors": error_count, "warnings": warning_count, "findings": len(findings)},
        "findings": findings,
    }


def cmd_doctor(args: argparse.Namespace) -> int:
    report = collect_report()
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        for item in report["findings"]:
            print(f"{item['severity']}: {item['kind']}: {item['summary']}" + (f" ({item['path']})" if item.get("path") else ""))
        print(f"agent governance gc {report['status']}: {report['counts']['errors']} error(s), {report['counts']['warnings']} warning(s)")
    if report["counts"]["errors"]:
        return 1
    configured_fail_on_warning = load_json(CONFIG_PATH, {}).get("policy", {}).get("fail_on_warning") is True
    if (args.fail_on_warning or configured_fail_on_warning) and report["counts"]["warnings"]:
        return 1
    return 0


def cmd_report(args: argparse.Namespace) -> int:
    report = collect_report()
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"# Governance GC Report\n\n- Status: {report['status']}\n- Errors: {report['counts']['errors']}\n- Warnings: {report['counts']['warnings']}\n")
        for item in report["findings"]:
            path = f" `{item['path']}`" if item.get("path") else ""
            print(f"- {item['severity']}: {item['kind']}: {item['summary']}{path}")
    return 1 if report["counts"]["errors"] else 0


def cmd_classify(args: argparse.Namespace) -> int:
    path = Path(".agent/harness-evolution.json")
    evolution = load_json(path)
    categories = evolution.get("incident_categories", {})
    if args.category not in categories:
        print(f"error: unknown harness category: {args.category}", file=sys.stderr)
        print("known categories: " + ", ".join(sorted(categories)), file=sys.stderr)
        return 1
    created_at = utc_now()
    incident_id = "incident-" + created_at.replace("-", "").replace(":", "").replace("T", "-").replace("Z", "")
    incident = {
        "id": incident_id,
        "created_at": created_at,
        "category": args.category,
        "severity": args.severity,
        "summary": args.summary,
        "path": args.path or "",
        "promotion_target": args.promotion_target or "",
        "postmortem": args.postmortem or "",
        "status": args.status,
    }
    incidents = evolution.get("incidents", [])
    if not isinstance(incidents, list):
        incidents = []
    incidents.append(incident)
    evolution["incidents"] = incidents
    write_json(path, evolution)
    print(json.dumps(incident, indent=2))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor = subparsers.add_parser("doctor", help="Check governance drift")
    doctor.add_argument("--json", action="store_true")
    doctor.add_argument("--fail-on-warning", action="store_true")
    doctor.set_defaults(func=cmd_doctor)

    report = subparsers.add_parser("report", help="Print a governance drift report")
    report.add_argument("--json", action="store_true")
    report.set_defaults(func=cmd_report)

    classify = subparsers.add_parser("classify", help="Record a harness-evolution incident classification")
    classify.add_argument("--category", required=True)
    classify.add_argument("--summary", required=True)
    classify.add_argument("--severity", choices=["low", "medium", "high", "critical"], default="medium")
    classify.add_argument("--path", default="")
    classify.add_argument("--promotion-target", default="")
    classify.add_argument("--postmortem", default="")
    classify.add_argument("--status", choices=["open", "promoted", "accepted", "closed"], default="open")
    classify.set_defaults(func=cmd_classify)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
